#!/usr/bin/env bash
# Push Nix store paths into GHCR, one OCI artifact per path, for proxy/ to serve.
#
# The flake builds from source (docs/nixos.md, "Binary cache"), so what one CI
# run compiled is the only thing that saves the next one from compiling it
# again. This puts it where the proxy looks: `nix copy --to file://` writes each
# path's signed narinfo and its NAR, and each pair becomes
# `<repository>:<store hash>`, with the two files as layers titled by their own
# names. The proxy maps `/<hash>.narinfo` and `/nar/<hash>/<file>` onto exactly
# that.
#
# A path whose tag already exists is skipped without being copied, so a run
# pushes only what it built. `--all` pushes every valid path in the store, which
# is what CI wants after a build that ran out of time: whatever finished is kept.
#
#   tools/nix-cache-push --repository ghcr.io/owner/name/nix-cache \
#       --secret-key-file key.sec ./result
#   tools/nix-cache-push --repository ... --secret-key-file ... --all
#
# Needs `nix` and `oras` on PATH, with `oras` already logged in. The secret key
# never leaves this host: nix signs each narinfo while writing it, and the
# signature covers the store path, the NAR's hash and size and its references --
# which is why the proxy may rewrite the URL line and a client still verifies it.
#
# Bash rather than the Python it replaced: everything here is a call to nix or
# oras, and the only thing Python did itself was ask the registry whether a tag
# exists, which `oras manifest fetch` answers as well.
set -euo pipefail

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

repository='' key='' all='' dry_run='' jobs=8 batch=200
installables=()
while [ $# -gt 0 ]; do
  case $1 in
    --repository) repository=$2; shift 2 ;;
    --secret-key-file) key=$2; shift 2 ;;
    --all) all=1; shift ;;
    --jobs) jobs=$2; shift 2 ;;
    --batch) batch=$2; shift 2 ;;
    # Copy and sign, print the pushes, push nothing and ask no registry.
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage ;;
    -*) echo "nix-cache-push: unknown option $1" >&2; usage ;;
    *) installables+=("$1"); shift ;;
  esac
done
[ -n "$repository" ] && [ -n "$key" ] || usage
[ -n "$all" ] || [ ${#installables[@]} -gt 0 ] || usage
case $repository in
  ghcr.io/?*/?*) ;;
  *) echo "nix-cache-push: $repository: expected ghcr.io/<owner>/<name>/..." >&2; exit 2 ;;
esac
key=$(realpath "$key")
[ -s "$key" ] || { echo "nix-cache-push: the secret key file is empty" >&2; exit 1; }

# Dependencies before the paths that refer to them. A binary cache refuses a
# path whose references it does not hold, so the order things are copied in is
# not free: `nix-store --query --requisites` prints a closure in that order,
# and keeping each path's first appearance keeps it across xargs' chunks.
# The pattern is the one the proxy serves: a store path, nothing below one.
work=$(mktemp -d "${TMPDIR:-/tmp}/nix-cache-push.XXXXXX")
trap 'rm -rf "$work"' EXIT
path_re='^/nix/store/[0-9a-df-np-sv-z]{32}-[^/]+$'
if [ -n "$all" ]; then
  nix path-info --all
else
  nix path-info "${installables[@]}"
fi | grep -E "$path_re" | xargs -r nix-store --query --requisites \
  | awk '!seen[$0]++' > "$work/paths"

# A tag that is not there yet -- or a repository that does not exist yet,
# which GHCR answers the same way -- is a path to push. Checked in parallel,
# then filtered back through the ordered list.
if [ -n "$dry_run" ]; then
  cp "$work/paths" "$work/missing"
else
  # shellcheck disable=SC2016 # expanded by the inner sh, not here
  REPO=$repository xargs -r -P "$jobs" -I{} sh -c \
    'oras manifest fetch --descriptor "$REPO:$(basename "$1" | cut -c1-32)" >/dev/null 2>&1 || echo "$1"' \
    _ {} < "$work/paths" > "$work/absent"
  awk 'NR == FNR { absent[$0] = 1; next } $0 in absent' "$work/absent" "$work/paths" > "$work/missing"
fi
total=$(wc -l < "$work/paths")
todo=$(wc -l < "$work/missing")
echo "nix-cache-push: $total path(s), $todo not yet in $repository"
[ "$todo" -gt 0 ] || exit 0

# One file cache for the whole run, so a batch's references copied by an
# earlier batch are still there. Only the NARs are deleted between batches;
# the narinfos are a few hundred bytes each.
staging="$work/cache"
mkdir -p "$staging"
to="file://$staging?compression=zstd&parallel-compression=true&secret-key=$key"

# A reference already in GHCR is not copied again, but the file cache still
# has to know it exists or nix refuses everything that refers to it. So it
# gets a narinfo with no NAR behind it, written from the local store and never
# pushed: it only has to satisfy the reference check.
awk 'NR == FNR { missing[$0] = 1; next } !($0 in missing)' "$work/missing" "$work/paths" \
  | while read -r p; do
      {
        echo "StorePath: $p"
        echo "URL: nar/absent.nar"
        echo "Compression: none"
        echo "NarHash: $(nix-store --query --hash "$p")"
        echo "NarSize: $(nix-store --query --size "$p")"
        printf 'References:'
        nix-store --query --references "$p" | xargs -r -n1 basename | sed 's/^/ /' | tr -d '\n'
        echo
      } > "$staging/$(basename "$p" | cut -c1-32).narinfo"
    done

# Push one narinfo and its NAR as `<repository>:<hash>`. oras titles each
# layer with the path it was given and the proxy looks layers up by title, so
# both files are linked bare into a directory of their own rather than pushed
# as `nar/<file>`.
push_one() {
  local staging=$1 hash=$2 narinfo nar bundle
  narinfo="$staging/$hash.narinfo"
  nar="$staging/$(sed -n 's/^URL: //p' "$narinfo")"
  bundle="$staging/push/$hash"
  mkdir -p "$bundle"
  ln "$narinfo" "$bundle/"
  ln "$nar" "$bundle/"
  set -- oras push "$REPO:$hash" --artifact-type application/vnd.losos.nix-cache.v1 \
    "$hash.narinfo:application/x-nix-narinfo" "$(basename "$nar"):application/x-nix-nar"
  if [ -n "$DRY_RUN" ]; then
    echo "$*"
  else
    (cd "$bundle" && "$@" >/dev/null)
  fi
  rm -rf "$bundle"
}
export -f push_one

# In batches, because a runner's disk holds the store once and not a compressed
# copy of all of it besides: each batch is copied, pushed and its NARs deleted
# before the next is written. zstd is fast to write on a runner that is also
# building, and nix reads it natively. --no-recursive because the list already
# holds exactly the paths to send, in an order that satisfies each one's
# references.
pushed=0
split -l "$batch" "$work/missing" "$work/batch."
for chunk in "$work"/batch.*; do
  nix copy --no-recursive --stdin --to "$to" < "$chunk"
  # shellcheck disable=SC2016 # expanded by the inner bash, not here
  xargs -r -n1 basename < "$chunk" | cut -c1-32 \
    | REPO=$repository DRY_RUN=$dry_run xargs -r -P "$jobs" -I{} bash -c 'push_one "$1" "$2"' _ "$staging" {}
  rm -rf "$staging/nar"
  pushed=$((pushed + $(wc -l < "$chunk")))
  echo "nix-cache-push: pushed $pushed/$todo"
done
echo "nix-cache-push: pushed $todo path(s)"
