#!/usr/bin/env bash
# Copy an installable's sources from cache.nixos.org, and check each against
# the hash nixpkgs pins for it.
#
# The build takes no binaries from cache.nixos.org (docs/nixos.md), so every
# source tarball, git checkout and crate is a fixed-output derivation that
# fetches from upstream. A cold build fetches more than two thousand of them,
# and one upstream timing out or answering 5xx fails the whole run before
# anything compiles. cache.nixos.org holds nearly all of them, because a
# fixed-output path depends only on its name and hash, never on libc.
#
# Only those paths are copied, each by its exact store path, so nothing else
# from cache.nixos.org enters the store. Some of its narinfos carry no CA
# field and so cannot verify themselves. Every copied path is hashed here
# against the hash its derivation declares, and one that differs is deleted
# and fails the run. A source this script trusts is therefore exactly what
# fetching it from upstream would have accepted. Whatever cache.nixos.org
# lacks is left for the build, which fetches it from upstream as before.
#
#   tools/nix-fetch-sources .#release
#
# Other options: --jobs N (parallel copies, 16), --dry-run (list what would
# be copied).
#
# Needs `nix` and `jq` on PATH, and runs `nix copy` and `nix store delete`
# through sudo, because a daemon client that is not a trusted user cannot
# pass --no-check-sigs.
set -euo pipefail

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

jobs=16 dry_run='' installable=''
while [ $# -gt 0 ]; do
  case $1 in
    --jobs) jobs=$2; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage ;;
    -*) echo "nix-fetch-sources: unknown option $1" >&2; usage ;;
    *) [ -z "$installable" ] || usage; installable=$1; shift ;;
  esac
done
[ -n "$installable" ] || usage

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Every fixed-output derivation in the closure, as "<drv> <method> <hash>".
# A fixed output has exactly one output, `out`, so the lists below line up.
nix derivation show -r "$installable" \
  | jq -r '(.derivations // .) | to_entries[]
      | select(.value.outputs.out.hash? != null)
      | "\(.key) \(.value.outputs.out.method // "flat") \(.value.outputs.out.hash)"' \
  | sed 's|^\([^/]\)|/nix/store/\1|' >"$work/fods"
cut -d' ' -f1 "$work/fods" | xargs -r nix-store --query --outputs >"$work/outs"
paste -d' ' "$work/outs" "$work/fods" | cut -d' ' -f1,3,4 >"$work/all"

# What the store already holds stays as it is.
: >"$work/missing"
while read -r out method hash; do
  [ -e "$out" ] || printf '%s %s %s\n' "$out" "$method" "$hash" >>"$work/missing"
done <"$work/all"
echo "nix-fetch-sources: $(wc -l <"$work/all") sources, $(wc -l <"$work/missing") not in the store"
if [ -n "$dry_run" ]; then
  cut -d' ' -f1 "$work/missing"
  exit 0
fi

# A path cache.nixos.org lacks fails its copy, and the build fetches it later.
# shellcheck disable=SC2016 # $1 is the inner shell's, not this one's.
cut -d' ' -f1 "$work/missing" \
  | xargs -r -P "$jobs" -n 1 sh -c \
    'sudo nix copy --no-check-sigs --from https://cache.nixos.org "$1" 2>/dev/null || true' _

copied=0 bad=0
while read -r out method hash; do
  [ -e "$out" ] || continue
  algo=${hash%%-*}
  case $method in
    flat) got=$(nix hash file --sri --type "$algo" "$out") ;;
    nar) got=$(nix hash path --sri --type "$algo" "$out") ;;
    # Text-hashed and git-hashed outputs are not sources. Nothing fetched is
    # either, so one here is left out rather than trusted.
    *) got='' ;;
  esac
  if [ "$got" = "$hash" ]; then
    copied=$((copied + 1))
  else
    echo "nix-fetch-sources: $out: expected $hash, got ${got:-an unchecked $method output}" >&2
    sudo nix store delete "$out" >/dev/null
    bad=$((bad + 1))
  fi
done <"$work/missing"
echo "nix-fetch-sources: copied $copied, $(($(wc -l <"$work/missing") - copied - bad)) left to fetch from upstream"
[ "$bad" = 0 ]
