#!/usr/bin/env bash
# Run `pm explain` over every recipe in the tree.
#
# This is the headline gate. `pm explain` derives the sandbox policy and exits
# non-zero the moment a command matches no fingerprint -- before anything is
# downloaded or compiled. It therefore proves the entire recipe corpus is
# executable-in-principle by pm on a machine that could never actually run the
# build: no network, no disk, no hours.
#
# It also verifies signatures on the way, because pm checks those before it
# parses (C10), so a stale signature fails here too.
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
pm=${PM:-$repo/../pm/target/release/pm}

if [ ! -x "$pm" ]; then
  echo "explain-all: no pm binary at $pm" >&2
  exit 1
fi

export XDG_CONFIG_HOME="$repo/.pm-config"

# The components are compiled, not committed, so a fresh clone has none until
# `./do plugins` has run, and pm then rejects the image layer -- the only recipe
# that needs one -- with an error that reads as a broken recipe. Say what is
# actually missing before that happens, because the fix is one command and
# nothing in pm's output names it.
#
# Two components are required and they fail differently, so both are named:
# without losos-mkosi the layer's `%{losos-mkosi:esp}` expands to nothing and pm
# reports that it cannot expand a command; without losos-image the mkosi,
# xorriso and qemu-img steps match no fingerprint (C2) and pm reports that it
# cannot derive a sandbox policy. losos-systemd is deliberately not required
# here: it hooks scan-source only, so its absence costs information about a
# recipe rather than making one unexplainable, and demanding it would send
# someone to rebuild a plugin that was never the problem.
#
# Checking the two by name rather than globbing for any `*.wasm` is what makes
# this survive `./do plugins <crate>`, which builds only the crate it is given.
# One component is enough to satisfy a glob and not enough to explain the image
# layer, which is precisely the case where the message is worth having.
missing=()
for component in losos-image losos-mkosi; do
  [ -f "$XDG_CONFIG_HOME/pm/plugins/$component.wasm" ] || missing+=("$component")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "explain-all: plugin component(s) missing: ${missing[*]}" >&2
  echo "explain-all: run ./do plugins ${missing[*]}" >&2
  echo "explain-all: without them pm cannot explain the image layer, and reports" >&2
  echo "explain-all: an unexpandable command or an underivable policy rather" >&2
  echo "explain-all: than a missing plugin" >&2
fi

failed=0
count=0
for recipe in "$repo"/out/recipes/*/build.yaml; do
  [ -e "$recipe" ] || continue
  count=$((count + 1))
  name=$(basename "$(dirname "$recipe")")
  if output=$( cd "$repo/out/pkgs" && "$pm" explain "$recipe" 2>&1 ); then
    # The capability line is the interesting half: a layer reporting
    # VersionControl means someone put a `git` in a recipe, and a layer
    # reporting Network when it has no dl_urls means the same for cargo/pip.
    grants=$(printf '%s\n' "$output" | sed -n 's/^grants: *//p')
    printf '  %-28s %s\n' "$name" "$grants"
  else
    failed=$((failed + 1))
    printf '  %-28s FAILED\n' "$name"
    printf '%s\n' "$output" | sed 's/^/      /'
  fi
done

if [ "$failed" -gt 0 ]; then
  echo "explain-all: $failed of $count recipe(s) rejected by pm" >&2
  exit 1
fi

echo "explain-all: all $count recipe(s) accepted by pm"
