#!/usr/bin/env python3
"""Generate out/recipes/** from recipes/**/build.yaml.in and manifest/layers.yaml.

A pm build file cannot be written by hand in this repository, for three reasons
that all come from pm itself (docs/pm-constraints.md):

 C9. A `dl_urls` download lands at /build/<fnv1a64(url)>/<basename>. There is no
     shell in a build step, so no globbing and no command substitution: a recipe
     cannot find that directory at run time. It has to be told, which means
     something has to compute it.

 C1/C3. There is no `$srcdir`, and the only host directory mounted into the jail
     is the build file's own, at its own absolute path. Every path a recipe
     names must be absolute -- and an absolute path is machine-specific.

 C7. A shared helper cannot be shared by reference, for the same reason. It has
     to be copied next to every generated build file.

pm has exactly this problem with its own build file and solves it exactly this
way, with `pm.yaml.in` and a handful of @PLACEHOLDER@ tokens.

The tracked truth is recipes/**/build.yaml.in, manifest/layers.yaml and
manifest/sources.lock. out/ is disposable and gitignored.
"""

import argparse
import re
import shutil
import subprocess
import sys
from collections import OrderedDict
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "tools" / "lib"))

try:
    import yaml
except ImportError:
    sys.exit("configure: PyYAML is required (apt install python3-yaml)")

import compose as compose_lib
from fnv import basename, download_path
from toolchain import Toolchain

UNRESOLVED = "TODO"


def tool_path(*names):
    """Absolute path of the first of `names` on the host PATH, symlink INTACT.

    Deliberately not canonicalised, unlike `host_tool` below. The LLVM
    binutils and the clang drivers are multi-call binaries that dispatch on
    argv[0]: `clang++` is a symlink to `clang`, `llvm-ranlib` and `llvm-strip`
    are symlinks to `llvm-ar` and `llvm-objcopy`. Resolving the link hands
    meson a path whose basename says something different from what was meant,
    and the tool then runs in the wrong mode -- C instead of C++, ar instead of
    ranlib -- with no error anywhere.
    """
    for name in names:
        found = shutil.which(name)
        if found:
            return found
    return ""


def host_tool(*names):
    """Absolute, canonical path of the first of `names` on the host PATH.

    pm resolves a step's FIRST WORD against the host PATH and hands execve the
    canonicalised result, but nothing after that: a build system's own lookup of
    `cc` goes through the jail's fixed PATH (C3). So the compiler is named
    explicitly, the way pm's own pm.yaml.in does it.
    """
    for name in names:
        found = shutil.which(name)
        if found:
            return str(Path(found).resolve())
    return ""


def clang_resource_dir():
    """Where the host clang keeps its builtin headers.

    Asked for rather than composed: the answer is a versioned path under
    /usr/lib/llvm-N, and a recipe that spelled one would be this container's
    layout baked into the tree. The only user is the step that copies those
    headers into the sysroot's resource directory, because `-resource-dir`
    moves stddef.h and friends along with the runtimes (see
    manifest/toolchain.yaml).
    """
    cc = tool_path("clang", "cc")
    if not cc:
        return ""
    result = subprocess.run(
        [cc, "-print-resource-dir"], capture_output=True, text=True, check=False
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def load_sources(path, mirror=None):
    """Read sources.lock into the placeholder tokens it contributes.

    Each entry yields four tokens. @DL_KEY@ is the load-bearing one; the others
    exist so a recipe never restates a URL or a version the lock file already
    holds, which is how the two drift apart.

    With `mirror` set, the upstream URL is replaced by
    <mirror>/<sha256>/<basename> -- the layout tools/fetch-sources writes and
    tools/serve-sources serves. The hash is NOT replaced, so the build is
    pinned to exactly the same bytes; only the transport changes. This is what
    makes pm usable on a host that re-terminates TLS, where pm's compiled-in
    root list cannot validate any upstream chain (see tools/fetch-sources).
    """
    if not path.exists():
        return {}, []
    doc = yaml.safe_load(path.read_text()) or {}
    subs, unresolved = {}, []
    for key, entry in doc.items():
        url = entry["url"]
        digest = str(entry.get("sha256", UNRESOLVED))
        if digest == UNRESOLVED:
            unresolved.append(key)
        elif mirror:
            url = f"{mirror.rstrip('/')}/{digest}/{basename(url)}"
        subs[f"@URL_{key}@"] = url
        subs[f"@SHA256_{key}@"] = digest
        subs[f"@VERSION_{key}@"] = str(entry.get("version", ""))
        subs[f"@DL_{key}@"] = download_path(url)
    return subs, unresolved


def substitute(text, subs):
    for token, value in subs.items():
        text = text.replace(token, value)
    return text


def stage_support(recipe_out, member_dirs, subs):
    """Copy everything the bundle's steps will need to read from inside the jail.

    Only the build file's own directory is mounted (C7), so `share/*.sh`, every
    member's `files/`, and anything named in an `include` manifest is copied in
    rather than referenced.
    """
    for helper in sorted((REPO / "share").glob("*.sh")):
        target = recipe_out / helper.name
        target.write_text(substitute(helper.read_text(), subs))
        target.chmod(0o755)

    # share/*.map is the linker's, not a step's: cfi-export.map is named in
    # LDFLAGS and read by mold, which runs inside the jail and so needs the
    # file on the same mount as the response file that names it.
    for script in sorted((REPO / "share").glob("*.map")):
        (recipe_out / script.name).write_text(
            substitute(script.read_text(), subs)
        )

    for package, source in member_dirs:
        files = source / "files"
        if files.is_dir():
            dest = recipe_out / "files" / package
            # Skip build detritus. A member whose files/ holds a cargo project
            # accumulates a target/ directory of hundreds of megabytes the
            # moment anyone runs cargo there by hand, and copying it into the
            # generated tree would put it inside the jail's read-only mount and
            # into every archive built above it.
            shutil.copytree(
                files,
                dest,
                dirs_exist_ok=True,
                ignore=shutil.ignore_patterns("target", "__pycache__"),
            )
            # A member's helper scripts get the same substitution its build
            # file does, so a script can name an absolute path too.
            for script in dest.rglob("*.sh"):
                script.write_text(substitute(script.read_text(), subs))
                script.chmod(0o755)
            for script in dest.rglob("*.py"):
                script.write_text(substitute(script.read_text(), subs))

        manifest = source / "include"
        if manifest.exists():
            for line in manifest.read_text().splitlines():
                line = line.split("#", 1)[0].strip()
                if not line:
                    continue
                src = REPO / line
                if not src.exists():
                    raise SystemExit(
                        f"configure: {package}: include not found: {line}"
                    )
                dest = recipe_out / "files" / package / Path(line).name
                dest.parent.mkdir(parents=True, exist_ok=True)
                if src.is_dir():
                    shutil.copytree(src, dest, dirs_exist_ok=True)
                else:
                    shutil.copy2(src, dest)

    # Render every template in the staged tree, AFTER includes have been
    # copied. Doing it before would leave an included overlay's .in files
    # unsubstituted, and an unsubstituted @ARCH_GPT_ROOT@ in a repart.d file
    # is a partition type systemd will not match -- an image that builds and
    # does not boot.
    staged = recipe_out / "files"
    if staged.is_dir():
        for template in sorted(staged.rglob("*.in")):
            template.with_suffix("").write_text(
                substitute(template.read_text(), subs)
            )
            template.unlink()


def render_member(path, subs):
    """Render one member's build.yaml.in and parse it as a pm build file."""
    text = substitute(path.read_text(), subs)
    try:
        doc = yaml.safe_load(text)
    except yaml.YAMLError as exc:
        raise SystemExit(f"configure: {path}: {exc}")
    if not isinstance(doc, dict) or "steps" not in doc:
        raise SystemExit(f"configure: {path}: not a build file")
    return doc


def yaml_dump(doc):
    """Serialise preserving key order, and never folding a long command."""

    class Dumper(yaml.SafeDumper):
        pass

    Dumper.add_representer(
        OrderedDict,
        lambda d, data: d.represent_mapping("tag:yaml.org,2002:map", data.items()),
    )
    return yaml.dump(doc, Dumper=Dumper, default_flow_style=False, width=10**6,
                     sort_keys=False)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--out", default=str(REPO / "out"))
    parser.add_argument("--allow-unresolved", action="store_true",
                        help="generate even while sources.lock has TODO hashes")
    parser.add_argument("--arch", default="x86_64",
                        help="target architecture from manifest/architectures.yaml")
    parser.add_argument("--channel", default="stable", choices=["stable", "nightly"],
                        help="which sysupdate channel the overlay points at")
    parser.add_argument("--version", default="0",
                        help="the release version baked into the ESP's kernel "
                             "filename, which is where systemd-sysupdate reads "
                             "it from; CI passes the version it is about to "
                             "publish")
    parser.add_argument("--ota-port", type=int, default=8731,
                        help="loopback port tools/vm-test offers a release on")
    parser.add_argument("--mirror", metavar="URL",
                        help="fetch sources from a local mirror instead of "
                             "upstream, keeping the same SHA-256 pins")
    parser.add_argument("--prebuilt-packages", type=Path, metavar="ARCHIVE",
                        help="assemble the image from a trusted package closure "
                             "built for this architecture, without rebuilding it")
    args = parser.parse_args()

    out = Path(args.out).resolve()
    recipes_out = out / "recipes"
    layers_file = REPO / "manifest" / "layers.yaml"
    layers = yaml.safe_load(layers_file.read_text()) if layers_file.exists() else []
    layers = layers or []
    prebuilt = None
    if args.prebuilt_packages:
        prebuilt = args.prebuilt_packages.resolve()
        # The generated tree is deleted on every configure, including the one
        # `just build` runs. Its input must survive that deletion (C10).
        if prebuilt.is_relative_to(recipes_out):
            parser.error("--prebuilt-packages must be outside the generated recipes")
        if (len(layers) < 2 or layers[-1]["dir"] != "90-image"
                or prebuilt.name != f"{layers[-2]['name']}-0.1.0.cpkg"):
            parser.error("--prebuilt-packages must name the final package layer archive")
        if not prebuilt.is_file() or prebuilt.stat().st_size == 0:
            parser.error("--prebuilt-packages must be a non-empty archive")
        # The image-host fallback mounts the repository, not an arbitrary
        # caller's download directory. Remember a durable, mounted copy so its
        # inner configure can regenerate after the original input disappears.
        managed = out / "pkgs" / prebuilt.name
        if prebuilt != managed:
            managed.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(prebuilt, managed)
        prebuilt = managed
    if recipes_out.exists():
        shutil.rmtree(recipes_out)
    recipes_out.mkdir(parents=True)
    (out / "pkgs").mkdir(parents=True, exist_ok=True)
    (out / "tmp").mkdir(parents=True, exist_ok=True)

    subs, unresolved = load_sources(
        REPO / "manifest" / "sources.lock", args.mirror
    )
    if unresolved and not args.allow_unresolved:
        print(
            "configure: sources.lock has unresolved hashes for: "
            + ", ".join(sorted(unresolved)),
            file=sys.stderr,
        )
        print(
            "configure: run tools/fetch-hashes on a networked machine, or pass\n"
            "           --allow-unresolved to generate anyway (the build will\n"
            "           fail at the hash check, not silently).",
            file=sys.stderr,
        )
        return 1

    # The architecture. Everything that differs between targets lives in
    # manifest/architectures.yaml, so no recipe spells a kernel image path or
    # an EFI stub name -- each of which builds cleanly at its x86 value and
    # then fails to boot on the other architecture.
    architectures = yaml.safe_load(
        (REPO / "manifest" / "architectures.yaml").read_text()
    )
    if args.arch not in architectures:
        raise SystemExit(
            f"configure: unknown architecture {args.arch!r}; "
            f"known: {', '.join(sorted(architectures))}"
        )
    arch = architectures[args.arch]
    for key, value in arch.items():
        subs[f"@ARCH_{key.upper()}@"] = str(value)
    subs["@ARCH@"] = args.arch
    subs["@CHANNEL@"] = args.channel
    # The version reaches exactly one place: the name of the UKI on the ESP the
    # image ships with. sysupdate parses the version out of that filename and
    # out of nothing else, so an image whose kernel is not named for its version
    # cannot be told apart from any other and `ProtectVersion=%A` protects
    # nothing. Everything else that needs a version -- the published filenames,
    # SHA256SUMS -- is named after the build by tools/stage-release.
    subs["@VERSION@"] = args.version
    # The loopback port tools/vm-test serves a test release on. Written here
    # rather than in the unit so the harness and the guest cannot disagree.
    subs["@OTA_PORT@"] = str(args.ota_port)
    # Every partition UUID in the image is derived from this, so two builds of
    # one version agree and two versions differ. systemd-repart takes a UUID
    # and nothing else, so the version string is hashed into one rather than
    # spelled into it.
    subs["@IMAGE_SEED@"] = str(
        __import__("uuid").uuid5(
            __import__("uuid").NAMESPACE_URL,
            f"https://losos.invalid/image/{args.arch}/{args.version}",
        )
    )

    # The toolchain: one manifest, every flag in the tree. A recipe that
    # spelled its own -O2 would be outside the CFI scheme with nothing saying
    # so, which is what `tools/pm-toolchain report` exists to catch.
    # The triple is the architecture's, not the toolchain manifest's: writing
    # it in both places is how they come to disagree.
    toolchain = Toolchain.load(REPO / "manifest" / "toolchain.yaml")
    toolchain.target["triple"] = arch["triple"]
    subs.update(toolchain.placeholders(tool_path))

    subs["@SRCDIR@"] = str(REPO)
    subs["@OUT@"] = str(out)
    subs["@PKGS@"] = str(out / "pkgs")
    subs["@CLANG_RESOURCE_DIR@"] = clang_resource_dir()
    subs["@PKGCONFIG@"] = tool_path("pkgconf", "pkg-config")
    subs["@PYTHON@"] = tool_path("python3")
    subs["@JOBS@"] = str(max(1, (__import__("os").cpu_count() or 2)))

    previous = None
    for layer in layers:
        name, directory = layer["name"], layer["dir"]
        recipe_out = recipes_out / name
        recipe_out.mkdir(parents=True)

        local = dict(subs)
        # @RECIPE@ is the bundle's own generated directory -- the one host tree
        # the jail mounts for this build file. Every helper path in every
        # member's steps resolves through it.
        local["@RECIPE@"] = str(recipe_out)
        # The `@file` form clang expands. The leading @ is clang's, not ours.
        local["@CFLAGS_RSP@"] = f"@{recipe_out}/cflags.rsp"
        local["@LDFLAGS_RSP@"] = f"@{recipe_out}/ldflags.rsp"

        # Before anything asks the toolchain for a flag list, because that is
        # what consumes it. stage_support() copies the file itself, further
        # down, and both halves have to agree on the name.
        toolchain.cfi_export_map = recipe_out / "cfi-export.map"
        # ...and the shared meson flag lists are recomputed here rather than
        # inherited, because `placeholders()` built them once for the whole run
        # -- before there was a layer to name the map in. An exempt package's
        # cross file already gets a fresh pair below; without this the shared
        # one was the only flag list in the tree missing the map, which is the
        # kind of gap that shows up as one meson library silently unchecked.
        local.update(toolchain.meson_subs())

        # A separate response file per exempt package. Written BEFORE the
        # members render, because rendering is what consumes these names:
        # defined afterwards, @CFLAGS_RSP_MUSL@ reached the generated recipe
        # verbatim and clang was handed a file called '@CFLAGS_RSP_MUSL@'.
        #
        # manifest/toolchain.yaml manifest/toolchain.yaml
        # lists what each drops and why -- musl cannot take --sysroot (it is
        # creating it), -D_FORTIFY_SOURCE (circular against its own __*_chk),
        # or CFI (its loader calls functions before any CFI runtime exists).
        #
        # Emitted as its own file rather than by editing the shared one so a
        # package has to NAME its exemption to get it, and a reader of the
        # recipe sees @CFLAGS_RSP_MUSL@ and goes looking for why.
        # A meson build has nowhere to put a response file. Every other build
        # system in this tree takes flags as a VAR=value argument or a -D, so
        # naming @CFLAGS_RSP_<PKG>@ is enough; meson takes them only from the
        # cross file, and the cross file is per LAYER. So an exempt meson
        # package gets a cross file of its own, identical but for the two flag
        # lists, and names it instead.
        #
        # This is not hypothetical. gjs carried a four-scheme CFI exemption for
        # its SpiderMonkey JIT while still pointing at the shared file, so
        # cflags-gjs.rsp was written every run and read by nothing: gjs was
        # built with the full scheme set and the manifest said otherwise.
        # tools/gates/exceptions-live.py exists so that cannot happen quietly
        # again.
        cross_template = (REPO / "share" / "cross.ini.in").read_text()
        for package in toolchain.exceptions:
            token = package.upper().replace("-", "_")
            cflags = recipe_out / f"cflags-{package}.rsp"
            ldflags = recipe_out / f"ldflags-{package}.rsp"
            cflags.write_text("\n".join(toolchain.cflags(package)) + "\n")
            ldflags.write_text("\n".join(toolchain.ldflags(package)) + "\n")
            local[f"@CFLAGS_RSP_{token}@"] = f"@{cflags}"
            local[f"@LDFLAGS_RSP_{token}@"] = f"@{ldflags}"

            # Only the cross file varies per package: the native file below
            # carries no flags at all, so there is nothing in it for an
            # exception to drop.
            cross = recipe_out / f"cross-{package}.ini"
            cross.write_text(
                substitute(cross_template,
                           dict(local, **toolchain.meson_subs(package)))
            )
            local[f"@CROSS_INI_{token}@"] = str(cross)

        member_dirs = []
        members = []
        for package in layer.get("members") or []:
            source = REPO / "recipes" / directory / package
            template = source / "build.yaml.in"
            if not template.exists():
                raise SystemExit(f"configure: missing {template}")
            member_dirs.append((package, source))
            members.append((package, render_member(template, local)))

        bundle = compose_lib.compose(
            name, members, f"../recipes/{previous}/build.yaml" if previous else None
        )
        if prebuilt and layer == layers[-1]:
            # pm cannot consume an existing archive as a graph dependency (C6).
            # Put the same closure where pm would have copied that dependency,
            # before either sysroot unpack runs. Only the image loses its edge;
            # ordinary builds keep the authored chain unchanged.
            staged = recipe_out / prebuilt.name
            shutil.copy2(prebuilt, staged)
            bundle["dependencies"] = []
            bundle["steps"][0]["run"][0:0] = [
                "mkdir -p /dest/deps",
                f"cp @RECIPE@/{prebuilt.name} /dest/deps/{prebuilt.name}",
            ]
        # The composer emits @RECIPE@ in its own shared steps; members were
        # already rendered above.
        text = substitute(yaml_dump(bundle), local)
        (recipe_out / "build.yaml").write_text(text)

        # One pair per layer. Every meson package in the layer names both:
        # cross.ini carries the toolchain and the [host_machine] section that
        # stops meson running what it compiles (C7), native.ini carries the
        # build-machine compiler a cross build also needs and deliberately no
        # flags. Nothing else in the layer carries flags.
        cross = (REPO / "share" / "cross.ini.in").read_text()
        (recipe_out / "cross.ini").write_text(substitute(cross, local))
        native = (REPO / "share" / "native.ini.in").read_text()
        (recipe_out / "native.ini").write_text(substitute(native, local))

        # Response files, for the build systems that take flags through the
        # environment or through a VAR=value argument.
        #
        # This exists because pm splits a command on whitespace (C1), so a
        # multi-word `CFLAGS=-O2 -flto=thin ...` would arrive as a dozen
        # separate arguments and autotools would reject the first one it did
        # not recognise. clang expands an `@file` argument anywhere on its
        # command line, so the whole flag set travels as ONE whitespace-free
        # word. No wrapper, no `env`, and the command stays readable in
        # `pm explain`.
        (recipe_out / "cflags.rsp").write_text(
            "\n".join(toolchain.cflags()) + "\n"
        )
        (recipe_out / "ldflags.rsp").write_text(
            "\n".join(toolchain.ldflags()) + "\n"
        )

        stage_support(recipe_out, member_dirs, local)

        # A surviving @TOKEN@ means a recipe named something sources.lock or
        # the substitution map does not define. Caught here, it is a one-line
        # generation error; caught later it is an ENOENT deep inside a build.
        # Matched anywhere in the text, not just as a standalone word: the
        # placeholders that matter arrive as `CFLAGS=@CFLAGS_RSP_MUSL@` and
        # `-C@RECIPE@/x`, which a word-boundary test walks straight past -- it
        # did, and the build died in musl's configure instead of here. The
        # pattern cannot collide with the `@/path/to/file.rsp` form clang
        # expands, because that has a slash where this needs a closing @.
        residual = sorted(set(re.findall(r"@[A-Z0-9_]{2,}@", text)))
        if residual:
            raise SystemExit(
                f"configure: {name}: unsubstituted placeholders: "
                + ", ".join(residual)
            )

        previous = name

    # Record the settings, because `./do build` re-generates before it builds
    # and would otherwise do so with the defaults -- producing, from a tree
    # configured for aarch64 and version 20260918.7, a build for x86_64 and
    # version 0. Nothing in the generated tree says which architecture it is
    # for, so the substitution would simply be wrong and the build would
    # succeed.
    remembered = [f"--arch={args.arch}", f"--channel={args.channel}",
                  f"--version={args.version}", f"--ota-port={args.ota_port}"]
    if args.allow_unresolved:
        remembered.append("--allow-unresolved")
    if args.mirror:
        remembered.append(f"--mirror={args.mirror}")
    if prebuilt:
        remembered.append(f"--prebuilt-packages={prebuilt}")
    (out / "configure.args").write_text("\n".join(remembered) + "\n")

    print(f"configure: generated {len(layers)} layer bundle(s) into {recipes_out}")
    if unresolved:
        print(
            f"configure: WARNING {len(unresolved)} source(s) still unpinned; "
            "the build will stop at the hash check",
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
