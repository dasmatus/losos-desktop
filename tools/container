#!/usr/bin/env python3
"""Build and run the build host described by the repository's Containerfile.

`docs/host-requirements.md` says what a build host must provide; the
Containerfile provides it; this puts the repository inside it. The point is that
CI and a developer's machine run the *same* host, so "works here, fails in CI"
stops being a category of bug.

Three things this has to get right, and each of them is a whole class of
confusing failure if it does not:

  * **pm's jail is a user namespace inside the container.** A default Docker
    container cannot create one, and the error is `Operation not permitted`
    from inside pm's sandbox, which reads as a problem with the workspace.
  * **pm resolves a step's first word on the host** (C3), and here the host is
    the container. That is the whole reason this exists.
  * **TMPDIR must be on real disk** (C11). The Justfile already redirects it
    into `out/tmp`, which is bind-mounted, so a build's several GB land on the
    repository's filesystem and not in the container's RAM -- and the engine
    itself reads that same TMPDIR, which is why `ensure_tmpdir` below exists.

The sibling `pm` checkout is mounted too, at the same relative position it has
outside, because two gates resolve pm's *source* independently of `$PM` and
silently downgrade when they cannot find it.
"""

import argparse
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
IMAGE = "localhost/losos-build"

# Which base image the Containerfile is built from, per host architecture.
#
# Arch upstream is an x86_64-only distribution and publishes no aarch64 image:
# `archlinux:base` is a manifest list with one entry, linux/amd64. The aarch64
# leg of the build matrix runs natively on an arm64 runner and routes every
# layer through this image, so it cannot pull that at all, and the failure --
#
#     choosing an image from manifest list docker://archlinux:base: no image
#     found in image index for architecture arm64, variant "v8", OS linux
#
# -- arrives before a single package is installed.
#
# ARM is Arch Linux ARM, a separate project with its own build farm, which
# publishes rootfs tarballs rather than container images. The aarch64 entry is
# therefore a third-party rebuild of that tree, chosen because it is multi-arch
# with a live arm64 manifest and is rebuilt daily; the alternatives were
# x86_64-only despite their names, or last pushed in 2021.
#
# The selection is here rather than in the Containerfile on purpose. Doing it
# there needs the multi-stage `FROM base-${TARGETARCH}` trick, and that relies
# on the builder pruning the stages it does not reach -- which BuildKit does
# and buildah does not promise, so on podman it would pull the amd64 base on an
# arm64 host and fail in exactly the way this exists to avoid. Python already
# knows the architecture and already assembles the command.
BASE_IMAGES = {
    "x86_64": "docker.io/library/archlinux:base",
    "aarch64": "docker.io/menci/archlinuxarm:base",
}

MACHINE_ALIASES = {
    "amd64": "x86_64",
    "arm64": "aarch64",
}


def runtime():
    """podman if it is here, else docker.

    podman first on purpose: rootless podman maps the invoking user into the
    container, so files the build writes into the repository are owned by
    whoever ran this. Rootless docker does the same; rootful docker does not,
    and leaves a tree of root-owned artifacts behind that the next `./do clean`
    cannot remove.
    """
    for candidate in ("podman", "docker"):
        if shutil.which(candidate):
            return candidate
    sys.exit(
        "container: neither podman nor docker is installed.\n"
        "  The Containerfile is the build host; without a runtime you are back\n"
        "  to installing docs/host-requirements.md by hand."
    )


def ensure_tmpdir():
    """Make TMPDIR exist before the container engine is handed it.

    The Justfile exports `TMPDIR=<repo>/out/tmp` for every recipe, because pm's
    workspaces have to land on real disk rather than in a tmpfs (C11). Only the
    recipes that go on to run pm create the directory, though, and the container
    recipes do not -- so on a fresh checkout, where `out/` does not exist at all,
    podman inherits a TMPDIR that is not there and dies before it has read a line
    of the Containerfile:

      Error: creating build container: ... creating a temporary directory:
      stat .../out/tmp: no such file or directory

    which reads as a broken Containerfile, or as a missing image, and is neither.
    It belongs here rather than in each of the four container recipes because
    this program is also run directly, and because the engine's need for a usable
    TMPDIR is this program's business and not the Justfile's.
    """
    tmpdir = os.environ.get("TMPDIR")
    if tmpdir:
        Path(tmpdir).mkdir(parents=True, exist_ok=True)


def pm_root():
    """Where the sibling pm checkout is, honouring PM_ROOT as the gates do."""
    return Path(os.environ.get("PM_ROOT", REPO.parent / "pm")).resolve()


def base_image():
    """The Containerfile's BASE_IMAGE for the architecture this is running on.

    The architecture that matters is the *host's*, not the one the
    distribution is being built for: this image is the build host, and the
    programs in it have to run here. `tools/configure --arch` is the other
    question and is unrelated.
    """
    raw_machine = platform.machine()
    machine = MACHINE_ALIASES.get(raw_machine, raw_machine)
    try:
        return BASE_IMAGES[machine]
    except KeyError:
        sys.exit(
            f"container: no base image known for {machine!r}.\n"
            f"  Known: {', '.join(sorted(BASE_IMAGES))}.\n"
            "  Pass one explicitly with --build-arg BASE_IMAGE=<image>."
        )


# Where a distribution puts its dynamic loader. Anything else in an ELF's
# PT_INTERP came from a private toolchain prefix -- Homebrew, Nix, conda -- and
# is a directory this image has never heard of.
SYSTEM_LOADER_DIRS = ("/lib/", "/lib64/", "/usr/lib/", "/usr/lib64/")


def elf_interpreter(binary):
    """The PT_INTERP of a 64-bit ELF, or None if there is not one to read.

    None covers every uninteresting case at once: a static binary, a file that
    is not an ELF, a 32-bit or big-endian one, a short read. This is advice
    about a confusing error message, so anything unparsed is simply no advice.
    """
    try:
        blob = binary.read_bytes()
    except OSError:
        return None
    if blob[:4] != b"\x7fELF" or blob[4:6] != b"\x02\x01":
        return None
    phoff = int.from_bytes(blob[0x20:0x28], "little")
    phentsize = int.from_bytes(blob[0x36:0x38], "little")
    phnum = int.from_bytes(blob[0x38:0x3A], "little")
    for index in range(phnum):
        header = blob[phoff + index * phentsize:][:phentsize]
        if len(header) < 40 or int.from_bytes(header[:4], "little") != 3:
            continue
        offset = int.from_bytes(header[8:16], "little")
        size = int.from_bytes(header[32:40], "little")
        return blob[offset:offset + size].split(b"\x00")[0].decode(errors="replace")
    return None


def warn_if_unrunnable(pm_binary, pm, mounts):
    """Say so when the pm binary cannot possibly execute inside the image.

    pm is mounted in rather than installed, so the binary the host built is the
    binary the container runs -- and a host whose toolchain lives in its own
    prefix produces one whose ELF interpreter is a path in that prefix. Nothing
    mounts it, so the loader is absent and the kernel's refusal names the
    program rather than the loader:

      .../pm: cannot execute: required file not found

    which reads as a missing pm, and pm is right there. The answer is the one
    CI already takes -- build pm inside the image -- so this names it.

    A warning rather than a refusal, because `container run cargo build` is
    exactly how that is fixed, and a hard failure here would block the fix.
    """
    interpreter = elf_interpreter(pm_binary)
    if interpreter is None:
        return
    if interpreter.startswith(SYSTEM_LOADER_DIRS):
        return
    if any(Path(interpreter).is_relative_to(mount) for mount in mounts):
        return
    print(
        f"container: warning: {pm_binary} needs the loader at {interpreter},\n"
        "  which is a path from the host's own toolchain prefix and is not in\n"
        "  this image. Anything that runs pm inside the container will fail\n"
        "  with `cannot execute: required file not found`. Build pm in the\n"
        "  image first, as CI does:\n"
        f"    ./do container-run -- cargo build --release --manifest-path {pm / 'Cargo.toml'}",
        file=sys.stderr,
    )


def build(engine, args):
    command = [engine, "build", "-t", IMAGE, "-f", str(REPO / "Containerfile")]
    # An explicit --build-arg wins, so overriding the base stays possible and
    # this does not quietly pass it twice with the caller's copy losing.
    if not any(pin == "BASE_IMAGE" or pin.startswith("BASE_IMAGE=") for pin in args.build_arg):
        command += ["--build-arg", f"BASE_IMAGE={base_image()}"]
    for pin in args.build_arg:
        command += ["--build-arg", pin]
    command.append(str(REPO))
    return subprocess.call(command)


def run(engine, args):
    pm = pm_root()
    pm_binary = Path(os.environ.get("PM", pm / "target/release/pm")).resolve()
    if not pm.is_dir():
        sys.exit(
            f"container: no pm checkout at {pm}.\n"
            "  Clone dichhead/pm beside this repository, or set PM_ROOT.\n"
            "  tools/gates/plugins.py and fingerprint-lint.py read pm's source,\n"
            "  and both downgrade to a pass when they cannot find it."
        )

    command = [
        engine, "run", "--rm", "--init",
        # pm's jail is a user namespace created inside this container. Docker's
        # default seccomp profile and AppArmor confinement both deny part of
        # what that needs, and the resulting EPERM names nothing useful.
        "--security-opt", "seccomp=unconfined",
        "--security-opt", "apparmor=unconfined",
        # SELinux relabelling of a bind-mounted source tree is slow and, on a
        # host that is not enforcing, pointless. The :z suffixes below would do
        # it per-mount; disabling it wholesale keeps a first run from rewriting
        # every file's label.
        "--security-opt", "label=disable",
        # And the one that is not about a security profile at all.
        #
        # pm's jail mounts a fresh procfs inside the user namespace it creates.
        # The kernel refuses that in a non-initial user namespace unless the
        # caller can already see a *fully visible* procfs: one with nothing
        # mounted over any part of it. Both engines mask `/proc/kcore`,
        # `/proc/keys` and half a dozen others with bind mounts and remount
        # `/proc/sys` read-only, which is exactly what makes procfs no longer
        # fully visible. So the mount returns EPERM, pm reports
        #
        #   hakoniwa: mount(Some("proc"), "/proc", ...) => EPERM
        #
        # and `check-digest` reports INCONCLUSIVE and suggests a host sysctl --
        # which is the right advice on a bare host and has no effect here,
        # because the host is not what is refusing. Unmasking `/proc` inside
        # this container is what lets pm's sandbox start at all.
        #
        # The two engines spell it differently and neither accepts the other's
        # spelling, so this is the one option that has to know which is running.
        *(("--security-opt", "unmask=ALL") if engine == "podman"
          else ("--security-opt", "systempaths=unconfined")),
        "-v", f"{REPO}:{REPO}",
        "-v", f"{pm}:{pm}",
        "-w", str(REPO),
        # The gates read pm's source from here, and ./do runs the binary.
        "-e", f"PM_ROOT={pm}",
        "-e", f"PM={pm_binary}",
    ]
    mounts = [REPO, pm]
    if not pm_binary.is_relative_to(pm):
        command += ["-v", f"{pm_binary.parent}:{pm_binary.parent}"]
        mounts.append(pm_binary.parent)
    warn_if_unrunnable(pm_binary, pm, mounts)
    # The image-build fallback serves mirrored sources on the host loopback, so
    # that path can opt into host networking without changing the default runner.
    if os.environ.get("LOSOS_CONTAINER_HOST_NETWORK") == "1":
        command += ["--network", "host"]
    if sys.stdin.isatty() and sys.stdout.isatty():
        command.append("-t")
        command.append("-i")
    command.append(IMAGE)

    # `just container-run -- cargo build ...` forwards that `--` as a literal
    # first argument rather than consuming it: it is just's own end-of-options
    # marker, and just passes the marker along with everything after it. It then
    # survives argparse too, because REMAINDER keeps a `--` instead of eating it.
    # Left in place it becomes the container's pid1, and the failure names
    # nothing that points at a separator:
    #
    #   ERROR (catatonit:2): failed to exec pid1: No such file or directory
    #
    # which reads as a program missing from the image. Dropping one leading `--`
    # here covers every caller -- the Justfile's container recipes and a direct
    # invocation alike -- and no one ever means to run a command called `--`.
    inner = list(args.command or [])
    if inner and inner[0] == "--":
        inner.pop(0)
    command += inner or ["bash"]
    return subprocess.call(command)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="verb", required=True)

    builder = sub.add_parser("build", help="build the image")
    builder.add_argument(
        "--build-arg",
        action="append",
        default=[],
        metavar="NAME=VALUE",
        help="override a pin, e.g. BASE_IMAGE=<image> or MKOSI_COMMIT=<sha>",
    )
    builder.set_defaults(handler=build)

    runner = sub.add_parser("run", help="run a command in the image")
    runner.add_argument("command", nargs=argparse.REMAINDER)
    runner.set_defaults(handler=run)

    args = parser.parse_args()
    ensure_tmpdir()
    return args.handler(runtime(), args)


if __name__ == "__main__":
    sys.exit(main())
