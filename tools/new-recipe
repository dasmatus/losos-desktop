#!/usr/bin/env python3
"""Scaffold a package recipe from its build system.

The skeleton comes from `pm generate`, not from a string in this file. pm owns
the build-file schema, so asking pm for a blank one means a schema change shows
up here as a diff in the scaffold rather than as a parse error in ninety
recipes. It is also the tool dogfooding itself, which is the point of this
repository.

What `pm generate` writes is deliberately minimal -- name, version, empty
dependencies, one `fetch` step -- so everything below fills that skeleton in
for a particular build system. Most of a recipe is the same three shapes
repeated: unpack, configure, compile, install twice, assert.

The templates encode the decisions in docs/pm-constraints.md so that a new
recipe starts out correct:

  * meson is never a step's first word -- it is run as `python3 <meson.py>`
    from the sysroot (C3).
  * `tar` always gets --no-same-owner, because pm's jail maps only uid 0.
  * every package installs TWICE: into /dest, which is the shipped tree and
    keeps prefix=/usr verbatim, and into /build/sysroot, which is what later
    members of the same layer link against. share/stage-sysroot.sh then
    re-points the sysroot copy's metadata.
  * the sysroot is reached by native flag, never by `env` (C2).

    tools/new-recipe --layer 00-base --name zlib --key ZLIB \\
        --buildsys autotools --strip 1
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def pm_skeleton():
    """Ask pm for a blank build file, and return it as text.

    Falls back to nothing if pm is not built: the scaffold below supplies every
    field anyway, and refusing to scaffold because a binary is missing would be
    unhelpful. The point of going through pm is that when it IS present, a
    schema change is visible here.
    """
    pm = os.environ.get("PM", str(REPO.parent / "pm" / "target" / "release" / "pm"))
    if not Path(pm).exists():
        return None
    with tempfile.TemporaryDirectory(prefix="losos-skeleton-") as tmp:
        target = Path(tmp) / "build.yaml"
        result = subprocess.run(
            [pm, "generate", str(target), "--force"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            return None
        return target.read_text()


def check_schema(skeleton):
    """Warn if pm's skeleton no longer has the fields this scaffold fills in."""
    if skeleton is None:
        return
    expected = ("name:", "version:", "dependencies:", "steps:", "stage:", "dl_urls:", "run:")
    missing = [field for field in expected if field not in skeleton]
    if missing:
        print(
            "new-recipe: WARNING pm generate no longer emits: "
            + ", ".join(missing)
            + "\n            the templates in this file may be out of date",
            file=sys.stderr,
        )

HEADER = """\
# {name} {version_note}
#
# {note}
name: {name}
version:
{version_list}
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_{key}@: '@SHA256_{key}@'
  run:
  - mkdir -p /build/src/{name} /build/b/{name}
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_{key}@ --no-same-owner -C /build/src/{name} --strip-components={strip}
"""

MESON = """
# --cross-file is not optional and not cosmetic: without it meson calls this a
# native build, compiles a test program and tries to RUN it, and a musl-dynamic
# binary has no interpreter in pm's jail (C7). --native-file is the
# build-machine half of the same pair. tools/gates/cross-configure.py checks.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/{name} /build/src/{name} --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig{options}

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/{name} -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/{name} --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/{name} --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot
"""

AUTOTOOLS = """
# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/{name} /build/src/{name}/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP@ LDFLAGS=@LDFLAGS_RSP@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig{options}

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/{name} -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/{name} install DESTDIR=/dest
  - make -C /build/b/{name} install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot
"""

CMAKE = """
- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/{name} -B /build/b/{name} -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP@{options}

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/{name} -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/{name}
  - cmake --install /build/b/{name} --prefix /build/sysroot/usr
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot
"""

TEST = """
- stage: Test
  name: staged
  dl_urls: null
  run:
{assertions}
"""

BODIES = {"meson": MESON, "autotools": AUTOTOOLS, "cmake": CMAKE}


def render(name, key, version, buildsys, strip, options, assertions, note):
    version_list = "\n".join(f"- '{part}'" for part in version.split("."))
    skeleton = pm_skeleton()
    check_schema(skeleton)
    text = HEADER.format(
        name=name,
        key=key,
        strip=strip,
        version_note=version,
        version_list=version_list,
        note=note,
    )
    text += BODIES[buildsys].format(
        name=name, options=(" " + options if options else "")
    )
    if assertions:
        text += TEST.format(
            assertions="\n".join(f"  - {a}" for a in assertions)
        )
    return text


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--layer", required=True)
    parser.add_argument("--name", required=True)
    parser.add_argument("--key", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--buildsys", required=True, choices=sorted(BODIES))
    parser.add_argument("--strip", default="1")
    parser.add_argument("--options", default="")
    parser.add_argument("--assert", dest="assertions", action="append", default=[])
    parser.add_argument("--note", default="Upstream package, built unmodified.")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()

    target = REPO / "recipes" / args.layer / args.name / "build.yaml.in"
    if target.exists() and not args.force:
        sys.exit(f"new-recipe: {target} exists (use --force)")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(
        render(args.name, args.key, args.version, args.buildsys, args.strip,
               args.options, args.assertions, args.note)
    )
    print(f"new-recipe: wrote {target.relative_to(REPO)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
