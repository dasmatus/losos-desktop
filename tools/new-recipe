#!/usr/bin/env python3
"""Scaffold a package recipe from its build system.

Most of a recipe is the same three shapes repeated: unpack, configure, compile,
install twice, assert. Writing that by hand ninety times invites the kind of
typo that only surfaces two hours into a build, so it is generated from a
template and then edited where the package is unusual.

The templates encode the decisions in docs/pm-constraints.md so that a new
recipe starts out correct:

  * meson is never a step's first word -- it is run as `python3 <meson.py>`
    from the sysroot (C3).
  * `tar` always gets --no-same-owner, because pm's jail maps only uid 0.
  * every package installs TWICE: into /dest, which is the shipped tree and
    keeps prefix=/usr verbatim, and into /build/sysroot, which is what later
    members of the same layer link against. share/stage-sysroot.sh then
    re-points the sysroot copy's metadata.
  * the sysroot is reached by native flag, never by `env` (C2).

    tools/new-recipe --layer 00-base --name zlib --key ZLIB \\
        --buildsys autotools --strip 1
"""

import argparse
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

HEADER = """\
# {name} {version_note}
#
# {note}
name: {name}
version:
{version_list}
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_{key}@: '@SHA256_{key}@'
  run:
  - mkdir -p /build/src/{name} /build/b/{name}
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_{key}@ --no-same-owner -C /build/src/{name} --strip-components={strip}
"""

MESON = """
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/{name} /build/src/{name} --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig{options}

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/{name} -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/{name} --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/{name} --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot
"""

AUTOTOOLS = """
# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the sysroot is reached without `env`.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/{name} /build/src/{name}/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig CPPFLAGS=-I/build/sysroot/usr/include LDFLAGS=-L/build/sysroot/usr/lib{options}

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/{name} -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/{name} install DESTDIR=/dest
  - make -C /build/b/{name} install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot
"""

CMAKE = """
- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/{name} -B /build/b/{name} -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=Release{options}

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/{name} -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/{name}
  - cmake --install /build/b/{name} --prefix /build/sysroot/usr
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot
"""

TEST = """
- stage: Test
  name: staged
  dl_urls: null
  run:
{assertions}
"""

BODIES = {"meson": MESON, "autotools": AUTOTOOLS, "cmake": CMAKE}


def render(name, key, version, buildsys, strip, options, assertions, note):
    version_list = "\n".join(f"- '{part}'" for part in version.split("."))
    text = HEADER.format(
        name=name,
        key=key,
        strip=strip,
        version_note=version,
        version_list=version_list,
        note=note,
    )
    text += BODIES[buildsys].format(
        name=name, options=(" " + options if options else "")
    )
    if assertions:
        text += TEST.format(
            assertions="\n".join(f"  - {a}" for a in assertions)
        )
    return text


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--layer", required=True)
    parser.add_argument("--name", required=True)
    parser.add_argument("--key", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--buildsys", required=True, choices=sorted(BODIES))
    parser.add_argument("--strip", default="1")
    parser.add_argument("--options", default="")
    parser.add_argument("--assert", dest="assertions", action="append", default=[])
    parser.add_argument("--note", default="Upstream package, built unmodified.")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()

    target = REPO / "recipes" / args.layer / args.name / "build.yaml.in"
    if target.exists() and not args.force:
        sys.exit(f"new-recipe: {target} exists (use --force)")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(
        render(args.name, args.key, args.version, args.buildsys, args.strip,
               args.options, args.assertions, args.note)
    )
    print(f"new-recipe: wrote {target.relative_to(REPO)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
