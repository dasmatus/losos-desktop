# Everything tools/configure generates. The `.in` templates and sources.lock
# are the tracked truth; out/ is reproducible from them and is never committed.
/out/

# The repo-local pm trust store `tools/sign-all` creates. It holds a throwaway
# signing key that exists only so `pm explain` and `pm build` can verify this
# tree; it must never be confused with the developer's real ~/.config/pm.
/.pm-config/

# pm writes archives and detached signatures into its process working
# directory, which for this repo is out/ — but a stray invocation from the
# repo root would drop them here.
*.cpkg
*.sig
*.sig.stale

# Rust build output. `plugins/` is a cargo workspace, and cargo puts both the
# wasm32 core modules and the host-side encoder artifacts here -- 137 MB of it,
# all reproducible from the sources beside it.
#
# The COMPONENTS are tracked, at plugins/dist/*.wasm: pm loads those, they are
# what gets signed, and tools/gates/plugins.py checks none is older than its
# source. The intermediates are not.
target/

# CPython bytecode caches. Tracked once by accident; they are regenerated on
# every run of tools/configure and differ by interpreter version, so a commit
# that touches one is noise in every review afterwards.
__pycache__/
*.pyc
