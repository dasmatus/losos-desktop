# Build output. `plugins/` and `proxy/` are cargo workspaces. target/ holds the
# wasm32 core modules and the host-side encoder, and dist/ holds the
# components built from them. A compiled copy in git goes stale without anyone
# noticing, and `just plugins` rebuilds them, so neither is committed.
target/
plugins/dist/

# nix-direnv caches the dev shell in .direnv/, `nix build` leaves result
# symlinks, and `nix run .#vm` writes a disk and a firmware variable store into
# the directory it ran in.
.direnv/
result
result-*
/losos-desktop.qcow2
/losos-desktop-efivars.fd
