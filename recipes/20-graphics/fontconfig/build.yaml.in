# fontconfig 2.16.0
#
# Font discovery.
name: fontconfig
version:
- '2'
- '16'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_FONTCONFIG@: '@SHA256_FONTCONFIG@'
  run:
  - mkdir -p /build/src/fontconfig /build/b/fontconfig
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_FONTCONFIG@ --no-same-owner -C /build/src/fontconfig --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/fontconfig /build/src/fontconfig --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Ddoc=disabled -Dtests=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/fontconfig -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/fontconfig --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/fontconfig --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libfontconfig.so
