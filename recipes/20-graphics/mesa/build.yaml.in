# mesa 24.2.5
#
# The GL and Vulkan implementation. Mutter will not start without a working GBM and EGL.
name: mesa
version:
- '24'
- '2'
- '5'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_MESA@: '@SHA256_MESA@'
  run:
  - mkdir -p /build/src/mesa /build/b/mesa
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_MESA@ --no-same-owner -C /build/src/mesa --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/mesa /build/src/mesa --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dgallium-drivers=iris,radeonsi,nouveau,virgl,swrast -Dvulkan-drivers=intel,amd -Dplatforms=wayland -Dglx=disabled -Dglvnd=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/mesa -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/mesa --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/mesa --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgbm.so
