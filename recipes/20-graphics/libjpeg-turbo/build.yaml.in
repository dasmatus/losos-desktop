# libjpeg-turbo 3.0.4
#
# Under gdk-pixbuf.
name: libjpeg-turbo
version:
- '3'
- '0'
- '4'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBJPEG_TURBO@: '@SHA256_LIBJPEG_TURBO@'
  run:
  - mkdir -p /build/src/libjpeg-turbo /build/b/libjpeg-turbo
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBJPEG_TURBO@ --no-same-owner -C /build/src/libjpeg-turbo --strip-components=1

# libjpeg-turbo's own flags. jmorecfg.h spells its declaration macros
# `#define GLOBAL(type) type` and `#define EXTERN(type) extern type`, which
# is the libjpeg API as it has been since 1991 and carries no visibility
# attribute; under -fvisibility=hidden both libjpeg and libturbojpeg install
# empty. gdk-pixbuf is the consumer. See manifest/toolchain.yaml.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/libjpeg-turbo -B /build/b/libjpeg-turbo -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP_LIBJPEG_TURBO@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP_LIBJPEG_TURBO@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP_LIBJPEG_TURBO@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP_LIBJPEG_TURBO@ -DENABLE_STATIC=OFF -DWITH_JPEG8=ON

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/libjpeg-turbo -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/libjpeg-turbo
  - make -C /build/b/libjpeg-turbo install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libjpeg.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libjpeg.so jpeg_std_error jpeg_CreateDecompress jpeg_read_header jpeg_start_decompress
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libturbojpeg.so tj3Init tj3Compress8 tj3Decompress8
