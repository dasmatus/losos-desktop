# harfbuzz 10.0.1
#
# Text shaping, under pango.
name: harfbuzz
version:
- '10'
- '0'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_HARFBUZZ@: '@SHA256_HARFBUZZ@'
  run:
  - mkdir -p /build/src/harfbuzz /build/b/harfbuzz
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_HARFBUZZ@ --no-same-owner -C /build/src/harfbuzz --strip-components=1

# --native-file is @NATIVE_INI_HARFBUZZ@ and not the layer's shared
# native.ini: meson takes flags from the native file and nowhere else, so a
# meson recipe has no CFLAGS= argument on which to name a response file, and
# this is the only way harfbuzz's `drops: [visibility]` reaches the
# compiler. HB_EXTERN is `extern` and nothing more -- hb-common.h defines it
# that way behind #ifndef and only the MSVC branch of hb.hh redefines it --
# so without this libharfbuzz.so installs empty and pango is the first thing
# to say so.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/harfbuzz /build/src/harfbuzz --native-file @NATIVE_INI_HARFBUZZ@ --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=disabled -Ddocs=disabled -Dintrospection=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/harfbuzz -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/harfbuzz --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/harfbuzz --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libharfbuzz.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libharfbuzz.so hb_buffer_create hb_shape hb_font_create hb_version_string
