# wayland-protocols 1.38
#
# Protocol XML only, no code.
name: wayland-protocols
version:
- '1'
- '38'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_WAYLAND_PROTOCOLS@: '@SHA256_WAYLAND_PROTOCOLS@'
  run:
  - mkdir -p /build/src/wayland-protocols /build/b/wayland-protocols
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_WAYLAND_PROTOCOLS@ --no-same-owner -C /build/src/wayland-protocols --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/wayland-protocols /build/src/wayland-protocols --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/wayland-protocols -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/wayland-protocols --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/wayland-protocols --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/share/wayland-protocols
