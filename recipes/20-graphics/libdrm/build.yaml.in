# libdrm 2.4.123
#
# Kernel mode setting, under mesa and mutter.
name: libdrm
version:
- '2'
- '4'
- '123'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBDRM@: '@SHA256_LIBDRM@'
  run:
  - mkdir -p /build/src/libdrm /build/b/libdrm
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBDRM@ --no-same-owner -C /build/src/libdrm --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libdrm /build/src/libdrm --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintel=enabled -Damdgpu=enabled -Dnouveau=enabled -Dtests=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libdrm -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libdrm --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libdrm --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libdrm.so
