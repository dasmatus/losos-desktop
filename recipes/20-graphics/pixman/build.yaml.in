# pixman 0.43.4
#
# Pixel manipulation, under cairo.
name: pixman
version:
- '0'
- '43'
- '4'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_PIXMAN@: '@SHA256_PIXMAN@'
  run:
  - mkdir -p /build/src/pixman /build/b/pixman
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_PIXMAN@ --no-same-owner -C /build/src/pixman --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/pixman /build/src/pixman --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=disabled -Ddemos=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/pixman -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/pixman --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/pixman --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libpixman-1.so
