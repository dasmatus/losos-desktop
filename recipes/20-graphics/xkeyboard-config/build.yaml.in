# xkeyboard-config 2.42
#
# Keymap data, read by libxkbcommon.
name: xkeyboard-config
version:
- '2'
- '42'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_XKEYBOARD_CONFIG@: '@SHA256_XKEYBOARD_CONFIG@'
  run:
  - mkdir -p /build/src/xkeyboard-config /build/b/xkeyboard-config
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_XKEYBOARD_CONFIG@ --no-same-owner -C /build/src/xkeyboard-config --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/xkeyboard-config /build/src/xkeyboard-config --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/xkeyboard-config -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/xkeyboard-config --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/xkeyboard-config --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/share/X11/xkb
