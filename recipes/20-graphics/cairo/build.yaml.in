# cairo 1.18.2
#
# 2D drawing, under pango and gtk.
name: cairo
version:
- '1'
- '18'
- '2'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_CAIRO@: '@SHA256_CAIRO@'
  run:
  - mkdir -p /build/src/cairo /build/b/cairo
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_CAIRO@ --no-same-owner -C /build/src/cairo --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/cairo /build/src/cairo --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=disabled -Dxlib=disabled -Dxcb=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/cairo -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/cairo --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/cairo --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libcairo.so
