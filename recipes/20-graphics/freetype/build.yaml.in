# freetype 2.14.3
#
# Font rasterisation.
name: freetype
version:
- '2'
- '14'
- '3'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_FREETYPE@: '@SHA256_FREETYPE@'
  run:
  - mkdir -p /build/src/freetype /build/b/freetype
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_FREETYPE@ --no-same-owner -C /build/src/freetype --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/freetype /build/src/freetype --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dbrotli=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/freetype -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/freetype --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/freetype --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libfreetype.so
