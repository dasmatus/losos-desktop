# graphene 1.10.8
#
# Vector maths for gtk4's scene graph and mutter.
name: graphene
version:
- '1'
- '10'
- '8'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GRAPHENE@: '@SHA256_GRAPHENE@'
  run:
  - mkdir -p /build/src/graphene /build/b/graphene
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GRAPHENE@ --no-same-owner -C /build/src/graphene --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/graphene /build/src/graphene --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false -Dgtk_doc=false -Dintrospection=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/graphene -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/graphene --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/graphene --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgraphene-1.0.so
