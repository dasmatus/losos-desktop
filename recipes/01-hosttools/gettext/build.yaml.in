# gettext 1.0
#
# msgfmt, for systemd -Dtranslations=true. Also reaches builds only via native.ini.
name: gettext
version:
- '1'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GETTEXT@: '@SHA256_GETTEXT@'
  run:
  - mkdir -p /build/src/gettext /build/b/gettext
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GETTEXT@ --no-same-owner -C /build/src/gettext --strip-components=1

# Built for the BUILD HOST, not for the target, and the response files below
# say so by name. A musl-dynamic binary cannot run in pm's jail -- its
# interpreter is /lib/ld-musl-<arch>.so.1 and the jail mirrors the host's /lib
# (C7) -- and this program exists to be run, by the kernel build and by
# systemd's. manifest/toolchain.yaml carries the full argument under `gperf`.
#
# The sysroot's pkg-config path is deliberately absent for the same reason:
# those .pc files describe musl libraries, and a host build that found one
# would link it.
#
# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml, from the per-package file this package's exception
# gets rather than the layer's shared one -- so no --target, no --sysroot, no
# CFI and no LTO.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/gettext /build/src/gettext/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP_GETTEXT@ LDFLAGS=@LDFLAGS_RSP_GETTEXT@ --disable-static --disable-java --disable-csharp

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/gettext -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/gettext install DESTDIR=/dest
  - make -C /build/b/gettext install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/bin/msgfmt
