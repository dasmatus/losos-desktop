# gjs 1.82.1
#
# The JavaScript engine gnome-shell is written in. It carries SpiderMonkey and is the longest single compile in the tree.
name: gjs
version:
- '1'
- '82'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GJS@: '@SHA256_GJS@'
  run:
  - mkdir -p /build/src/gjs /build/b/gjs
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GJS@ --no-same-owner -C /build/src/gjs --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gjs /build/src/gjs --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dinstalled_tests=false -Dskip_gtk_tests=true

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gjs -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gjs --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gjs --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgjs.so
