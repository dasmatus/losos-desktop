# gdm 51.0
#
# The display manager, and this OS's entire login path. It creates logind sessions and resolves users through NSS, which userdbd and homed answer.
name: gdm
version:
- '51'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GDM@: '@SHA256_GDM@'
  run:
  - mkdir -p /build/src/gdm /build/b/gdm
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GDM@ --no-same-owner -C /build/src/gdm --strip-components=1

# -Ddefault-pam-config=none is the one option here that is not about what this
# OS wants, but about refusing to let the BUILD HOST decide it.
#
# The option's default is `autodetect`, and gdm implements that by running
# `test -f` against five release files at configure time -- meson.build:148-162
# in 51.0, `/etc/arch-release` among them -- so the answer is a property of
# whatever distribution the container happens to be, not of the image being
# built. data/meson.build:95 then installs `pam-<distro>/*.pam` into the image.
#
# That was harmless only by luck: on the Debian base none of the five matched,
# the lookup fell through to the empty list, and gdm installed no PAM files at
# all. Moving the container to Arch makes `/etc/arch-release` match, and gdm
# would start installing Arch's PAM stack -- referencing module paths and
# services this OS does not have -- into every image. Nothing in the gates can
# see it and nothing in CI would go red: it surfaces at a login prompt that
# will not accept a password.
#
# `none` is therefore not a new decision, it is the current behaviour written
# down so that it survives a change of base. This OS ships no gdm PAM files of
# its own (nothing under overlay/ provides any), and when it does, that is the
# change that should choose a value here.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gdm /build/src/gdm --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dsystemd-journal=true -Dsystemdsystemunitdir=/usr/lib/systemd/system -Dsystemduserunitdir=/usr/lib/systemd/user -Dwayland-support=true -Dplymouth=disabled -Dselinux=disabled -Ddefault-pam-config=none

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gdm -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gdm --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gdm --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/sbin/gdm
