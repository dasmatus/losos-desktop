# gdm 51.0
#
# The display manager, and this OS's entire login path. It creates logind sessions and resolves users through NSS, which userdbd and homed answer.
name: gdm
version:
- '51'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GDM@: '@SHA256_GDM@'
  run:
  - mkdir -p /build/src/gdm /build/b/gdm
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GDM@ --no-same-owner -C /build/src/gdm --strip-components=1

# -Dwayland-support is gone from gdm 51: Wayland is unconditional now and the
# option went with the choice. -Dx11-support replaces the half of it that is
# still a decision, and it defaults TRUE -- so leaving it unsaid is not
# neutral. Nothing in this tree builds an X server or its client libraries, so
# a default-on X11 session would either fail to find them or find the build
# host's through pm's read-only /usr mirror (C7). Said out loud, like every
# other probe in this tree.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gdm /build/src/gdm --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dsystemd-journal=true -Dsystemdsystemunitdir=/usr/lib/systemd/system -Dsystemduserunitdir=/usr/lib/systemd/user -Dplymouth=disabled -Dx11-support=false -Dselinux=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gdm -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gdm --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gdm --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/sbin/gdm
