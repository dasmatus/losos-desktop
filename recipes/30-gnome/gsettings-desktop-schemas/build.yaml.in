# gsettings-desktop-schemas 47.1
#
# The schemas the session reads. A missing schema is a hard abort in GNOME, not a default.
name: gsettings-desktop-schemas
version:
- '47'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GSETTINGS_DESKTOP_SCHEMAS@: '@SHA256_GSETTINGS_DESKTOP_SCHEMAS@'
  run:
  - mkdir -p /build/src/gsettings-desktop-schemas /build/b/gsettings-desktop-schemas
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GSETTINGS_DESKTOP_SCHEMAS@ --no-same-owner -C /build/src/gsettings-desktop-schemas --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gsettings-desktop-schemas /build/src/gsettings-desktop-schemas --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gsettings-desktop-schemas -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gsettings-desktop-schemas --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gsettings-desktop-schemas --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/share/glib-2.0/schemas
