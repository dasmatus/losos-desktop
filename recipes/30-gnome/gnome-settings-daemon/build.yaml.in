# gnome-settings-daemon 47.1
#
# The per-session daemons: power, colour, keyboard, media keys. Each is a systemd user unit.
name: gnome-settings-daemon
version:
- '47'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GNOME_SETTINGS_DAEMON@: '@SHA256_GNOME_SETTINGS_DAEMON@'
  run:
  - mkdir -p /build/src/gnome-settings-daemon /build/b/gnome-settings-daemon
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GNOME_SETTINGS_DAEMON@ --no-same-owner -C /build/src/gnome-settings-daemon --strip-components=1

# -Dtests is not an option in gnome-settings-daemon 47.1. Its fourteen are
# listed in meson_options.txt and the test suite is not among them.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gnome-settings-daemon /build/src/gnome-settings-daemon --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dudev_dir=/usr/lib/udev

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gnome-settings-daemon -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gnome-settings-daemon --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gnome-settings-daemon --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/libexec/gsd-power
