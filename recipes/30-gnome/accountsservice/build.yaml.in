# accountsservice 23.13.9
#
# The user list gdm shows. It is a D-Bus service activated by systemd.
name: accountsservice
version:
- '23'
- '13'
- '9'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_ACCOUNTSSERVICE@: '@SHA256_ACCOUNTSSERVICE@'
  run:
  - mkdir -p /build/src/accountsservice /build/b/accountsservice
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_ACCOUNTSSERVICE@ --no-same-owner -C /build/src/accountsservice --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/accountsservice /build/src/accountsservice --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=false -Dvapi=false -Ddocbook=false -Dsystemdsystemunitdir=/usr/lib/systemd/system

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/accountsservice -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/accountsservice --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/accountsservice --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/libexec/accounts-daemon
