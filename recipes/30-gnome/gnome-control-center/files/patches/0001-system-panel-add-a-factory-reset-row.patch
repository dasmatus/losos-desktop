Add a Factory Reset row to the System panel.

GNOME Settings has no way to ask for a factory reset, because on a
package-managed distribution there is nothing coherent to ask. On an
image-based system there is: systemd's factory-reset.target sets the
FactoryResetRequest EFI variable, and on the next boot systemd-repart removes
every partition marked FactoryReset=yes and creates it anew from the same
repart.d files that created it originally.

So the reset is not a script that walks the filesystem deleting things -- it is
the absence of a partition, performed by the same code path that made it. That
is worth a button, and this adds one.

The row starts factory-reset.target over the system bus. polkit mediates it
through org.freedesktop.systemd1.manage-units, which this OS narrows to this
one unit and to an active local session in 50-losos-factory-reset.rules, so the
user is asked to authenticate. Nothing is deleted during the session: the
dialog says "the next time this device starts" because that is when it happens.

Upstreamable in shape but not as-is: it hardcodes a unit name that only exists
on an OS built around systemd-repart, so upstream would want it behind a
capability check -- systemd-factory-reset's `status` verb reports "unsupported"
exactly for this.

--- a/panels/system/cc-system-panel.c
+++ b/panels/system/cc-system-panel.c
@@ -21,6 +21,7 @@
 
 #include <config.h>
 
+#include <gio/gio.h>
 #include <glib/gi18n-lib.h>
 
 #include "cc-list-row.h"
@@ -131,6 +132,102 @@
   adw_dialog_present (ADW_DIALOG (self->secure_shell_dialog), GTK_WIDGET (self));
 }
 
+/* Ask systemd to perform a factory reset on the next boot.
+ *
+ * factory-reset.target is the documented entry point: starting it runs
+ * systemd-factory-reset-request.service, which sets the FactoryResetRequest EFI
+ * variable. The reset itself happens on the NEXT boot, when systemd-repart
+ * removes every partition marked FactoryReset=yes and creates it anew. Nothing
+ * is deleted while this session is running, which is why the dialog says "the
+ * next time this device starts" rather than "now".
+ *
+ * polkit mediates the call through org.freedesktop.systemd1.manage-units; this
+ * OS narrows that action to this one unit and to an active local session in
+ * 50-losos-factory-reset.rules, so the user is prompted to authenticate.
+ */
+static void
+on_factory_reset_started (GObject      *source,
+                          GAsyncResult *result,
+                          gpointer      user_data)
+{
+  g_autoptr(GVariant) reply = NULL;
+  g_autoptr(GError) error = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (reply == NULL)
+    {
+      /* A polkit denial arrives here too, as an access-denied error. Warn
+       * rather than assert: the user declining the authentication dialog is an
+       * ordinary outcome, not a bug. */
+      g_warning ("Factory reset was not scheduled: %s", error->message);
+      return;
+    }
+
+  g_debug ("Factory reset requested; it will run on the next boot");
+}
+
+static void
+on_factory_reset_response (AdwAlertDialog *dialog,
+                           const char     *response,
+                           CcSystemPanel  *self)
+{
+  g_autoptr(GDBusConnection) bus = NULL;
+  g_autoptr(GError) error = NULL;
+
+  if (!g_str_equal (response, "reset"))
+    return;
+
+  bus = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, &error);
+  if (bus == NULL)
+    {
+      g_warning ("Factory reset: cannot reach the system bus: %s", error->message);
+      return;
+    }
+
+  g_dbus_connection_call (bus,
+                          "org.freedesktop.systemd1",
+                          "/org/freedesktop/systemd1",
+                          "org.freedesktop.systemd1.Manager",
+                          "StartUnit",
+                          g_variant_new ("(ss)", "factory-reset.target", "replace"),
+                          NULL,
+                          G_DBUS_CALL_FLAGS_NONE,
+                          -1,
+                          NULL,
+                          on_factory_reset_started,
+                          NULL);
+}
+
+static void
+on_factory_reset_row_activated (CcSystemPanel *self)
+{
+  AdwDialog *dialog;
+
+  dialog = adw_alert_dialog_new (_("Factory Reset?"), NULL);
+
+  adw_alert_dialog_format_body (ADW_ALERT_DIALOG (dialog),
+                                _("All user accounts and personal files will be "
+                                  "permanently deleted the next time this device "
+                                  "starts. Installed system software is kept.\n\n"
+                                  "This cannot be undone."));
+
+  adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog),
+                                  "cancel", _("_Cancel"),
+                                  "reset", _("_Factory Reset"),
+                                  NULL);
+  adw_alert_dialog_set_response_appearance (ADW_ALERT_DIALOG (dialog),
+                                            "reset", ADW_RESPONSE_DESTRUCTIVE);
+  /* Cancel is both the default and the close response: a destructive action
+   * should never be what Enter or Escape picks. */
+  adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "cancel");
+  adw_alert_dialog_set_close_response (ADW_ALERT_DIALOG (dialog), "cancel");
+
+  g_signal_connect (dialog, "response",
+                    G_CALLBACK (on_factory_reset_response), self);
+
+  adw_dialog_present (dialog, GTK_WIDGET (self));
+}
+
 static void
 cc_system_panel_class_init (CcSystemPanelClass *klass)
 {
@@ -147,6 +244,7 @@
 
   gtk_widget_class_bind_template_callback (widget_class, cc_system_page_open_software_update);
   gtk_widget_class_bind_template_callback (widget_class, on_secure_shell_row_clicked);
+  gtk_widget_class_bind_template_callback (widget_class, on_factory_reset_row_activated);
 
   g_type_ensure (CC_TYPE_ABOUT_PAGE);
   g_type_ensure (CC_TYPE_DATE_TIME_PAGE);
--- a/panels/system/cc-system-panel.ui
