# at-spi2-core 2.62.0.1
#
# Accessibility bus. gtk4 hard-depends on it.
name: at-spi2-core
version:
- '2'
- '62'
- '0'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_ATSPI2_CORE@: '@SHA256_ATSPI2_CORE@'
  run:
  - mkdir -p /build/src/at-spi2-core /build/b/at-spi2-core
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_ATSPI2_CORE@ --no-same-owner -C /build/src/at-spi2-core --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/at-spi2-core /build/src/at-spi2-core --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=disabled -Ddocs=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/at-spi2-core -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/at-spi2-core --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/at-spi2-core --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libatspi.so
