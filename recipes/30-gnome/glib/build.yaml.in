# glib 2.90.0
#
# The foundation of everything above it. Its GDBus is how GNOME talks to systemd's services.
name: glib
version:
- '2'
- '90'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GLIB@: '@SHA256_GLIB@'
  run:
  - mkdir -p /build/src/glib /build/b/glib
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GLIB@ --no-same-owner -C /build/src/glib --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/glib /build/src/glib --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false -Dintrospection=disabled -Dman-pages=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/glib -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/glib --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/glib --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libglib-2.0.so
