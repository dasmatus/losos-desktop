# libadwaita 1.6.1
#
# GNOME's widget set on top of gtk4.
name: libadwaita
version:
- '1'
- '6'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBADWAITA@: '@SHA256_LIBADWAITA@'
  run:
  - mkdir -p /build/src/libadwaita /build/b/libadwaita
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBADWAITA@ --no-same-owner -C /build/src/libadwaita --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libadwaita /build/src/libadwaita --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false -Dexamples=false -Dintrospection=disabled -Dvapi=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libadwaita -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libadwaita --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libadwaita --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libadwaita-1.so
