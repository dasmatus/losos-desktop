# gtk4 4.16.3
#
# The toolkit. x11-backend is off because this OS has no Xorg at all.
name: gtk4
version:
- '4'
- '16'
- '3'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GTK4@: '@SHA256_GTK4@'
  run:
  - mkdir -p /build/src/gtk4 /build/b/gtk4
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GTK4@ --no-same-owner -C /build/src/gtk4 --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gtk4 /build/src/gtk4 --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dbuild-tests=false -Dbuild-demos=false -Dbuild-examples=false -Dintrospection=disabled -Dwayland-backend=true -Dx11-backend=false -Dmedia-gstreamer=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gtk4 -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gtk4 --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gtk4 --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgtk-4.so
