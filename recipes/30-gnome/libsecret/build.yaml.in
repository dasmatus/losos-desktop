# libsecret 0.21.4
#
# The Secret Service client side, implemented by gnome-keyring.
name: libsecret
version:
- '0'
- '21'
- '4'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBSECRET@: '@SHA256_LIBSECRET@'
  run:
  - mkdir -p /build/src/libsecret /build/b/libsecret
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBSECRET@ --no-same-owner -C /build/src/libsecret --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libsecret /build/src/libsecret --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=false -Dgtk_doc=false -Dmanpage=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libsecret -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libsecret --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libsecret --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libsecret-1.so
