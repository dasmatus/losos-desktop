# upower 1.90.6
#
# Battery state for the shell; systemd-logind consults it for lid and low-battery handling.
name: upower
version:
- '1'
- '90'
- '6'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_UPOWER@: '@SHA256_UPOWER@'
  run:
  - mkdir -p /build/src/upower /build/b/upower
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_UPOWER@ --no-same-owner -C /build/src/upower --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/upower /build/src/upower --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=disabled -Dgtk-doc=false -Dman=false -Dsystemdsystemunitdir=/usr/lib/systemd/system

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/upower -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/upower --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/upower --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/libexec/upowerd
