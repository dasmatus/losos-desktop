# gobject-introspection 1.82.0
#
# Typelib generation. g-ir-scanner RUNS the libraries it scans, which is why this layer cannot be cross-built and why it sits above glib rather than beside it.
name: gobject-introspection
version:
- '1'
- '82'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GOBJECT_INTROSPECTION@: '@SHA256_GOBJECT_INTROSPECTION@'
  run:
  - mkdir -p /build/src/gobject-introspection /build/b/gobject-introspection
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GOBJECT_INTROSPECTION@ --no-same-owner -C /build/src/gobject-introspection --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gobject-introspection /build/src/gobject-introspection --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dbuild_introspection_data=true

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gobject-introspection -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gobject-introspection --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gobject-introspection --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/bin/g-ir-scanner
