# libsoup 3.6.0
#
# HTTP for GNOME.
name: libsoup
version:
- '3'
- '6'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBSOUP@: '@SHA256_LIBSOUP@'
  run:
  - mkdir -p /build/src/libsoup /build/b/libsoup
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBSOUP@ --no-same-owner -C /build/src/libsoup --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libsoup /build/src/libsoup --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false -Dintrospection=disabled -Dvapi=disabled -Ddocs=disabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libsoup -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libsoup --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libsoup --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libsoup-3.0.so
