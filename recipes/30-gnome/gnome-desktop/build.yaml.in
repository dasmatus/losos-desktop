# gnome-desktop 51.0
#
# Shared desktop helpers for the shell and control centre.
name: gnome-desktop
version:
- '51'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GNOME_DESKTOP@: '@SHA256_GNOME_DESKTOP@'
  run:
  - mkdir -p /build/src/gnome-desktop /build/b/gnome-desktop
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GNOME_DESKTOP@ --no-same-owner -C /build/src/gnome-desktop --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gnome-desktop /build/src/gnome-desktop --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=false -Ddesktop_docs=false -Dudev=enabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gnome-desktop -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gnome-desktop --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gnome-desktop --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgnome-desktop-4.so
