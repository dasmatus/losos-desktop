# gnome-shell 47.1
#
# The session shell, running as a systemd user unit under graphical-session.target.
name: gnome-shell
version:
- '47'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GNOME_SHELL@: '@SHA256_GNOME_SHELL@'
  run:
  - mkdir -p /build/src/gnome-shell /build/b/gnome-shell
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GNOME_SHELL@ --no-same-owner -C /build/src/gnome-shell --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/gnome-shell /build/src/gnome-shell --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false -Dextensions_app=false -Dman=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/gnome-shell -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gnome-shell --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/gnome-shell --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/bin/gnome-shell
