# libxmlb 0.3.19
#
# Binary XML store. fwupd parses the LVFS metadata catalogue with it.
name: libxmlb
version:
- '0'
- '3'
- '19'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBXMLB@: '@SHA256_LIBXMLB@'
  run:
  - mkdir -p /build/src/libxmlb /build/b/libxmlb
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBXMLB@ --no-same-owner -C /build/src/libxmlb --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libxmlb /build/src/libxmlb --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dtests=false -Dgtkdoc=false -Dintrospection=false -Dstemmer=false -Dcli=false -Dlzma=enabled -Dzstd=enabled

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libxmlb -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libxmlb --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libxmlb --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libxmlb.so
