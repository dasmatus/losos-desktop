# xdg-desktop-portal 1.18.4
#
# The sandboxed-app API surface, socket-activated as a systemd user unit.
name: xdg-desktop-portal
version:
- '1'
- '18'
- '4'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_XDG_DESKTOP_PORTAL@: '@SHA256_XDG_DESKTOP_PORTAL@'
  run:
  - mkdir -p /build/src/xdg-desktop-portal /build/b/xdg-desktop-portal
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_XDG_DESKTOP_PORTAL@ --no-same-owner -C /build/src/xdg-desktop-portal --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the sysroot is reached without `env`.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/xdg-desktop-portal /build/src/xdg-desktop-portal/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig CPPFLAGS=-I/build/sysroot/usr/include LDFLAGS=-L/build/sysroot/usr/lib --disable-static --disable-docbook-docs --with-systemduserunitdir=/usr/lib/systemd/user

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/xdg-desktop-portal -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/xdg-desktop-portal install DESTDIR=/dest
  - make -C /build/b/xdg-desktop-portal install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/libexec/xdg-desktop-portal
