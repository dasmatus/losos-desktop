# libnotify 0.8.3
#
# Desktop notifications.
name: libnotify
version:
- '0'
- '8'
- '3'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBNOTIFY@: '@SHA256_LIBNOTIFY@'
  run:
  - mkdir -p /build/src/libnotify /build/b/libnotify
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBNOTIFY@ --no-same-owner -C /build/src/libnotify --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libnotify /build/src/libnotify --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dintrospection=disabled -Dgtk_doc=false -Dman=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libnotify -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libnotify --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libnotify --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libnotify.so
