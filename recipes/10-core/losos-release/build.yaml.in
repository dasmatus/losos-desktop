# losos-release -- the OS identity, and the tree's proof that a compile works.
#
# Configured by the meson the layer below built. Note the shape of that call:
# `python3` is the first word, because pm canonicalises a step's first word on
# the HOST and /build/sysroot exists only inside the jail (C3). meson.py is an
# argument, so it is reached from where it actually is.
#
# The sources are this repository's own, not a download, so there is no
# dl_urls here and nothing to pin. tools/configure copies files/ into the
# generated recipe directory, which is the only host tree the jail mounts (C7).
name: losos-release
version:
- '0'
- '1'
- '0'
dependencies: []
steps:

# This line named no machine file at all until now, which is not the same as
# naming a native one: with neither, meson took clang off the jail's PATH with
# none of manifest/toolchain.yaml's flags and linked the result against the
# build host's glibc. So the one binary this repository compiles from its own
# source -- the one that answers what distribution this is -- was the one
# binary in the image that could not have run in it, and nothing said so: it
# configured, compiled and installed without a warning, because a native build
# of a native binary is exactly what meson was asked for.
#
# --cross-file is what makes it musl, and what stops meson running the test
# program it compiles (C7). --native-file is the build-machine half of the
# pair. tools/gates/cross-configure.py now requires both of every meson step.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/losos-release @RECIPE@/files/losos-release --cross-file @RECIPE@/cross.ini --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/losos-release -j @JOBS@

# Installed twice: /dest is the shipped tree and keeps prefix=/usr verbatim,
# /build/sysroot is what later members of this layer link against. See
# share/stage-sysroot.sh for why the second copy needs its metadata re-pointed.
- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/losos-release --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/losos-release --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -x /dest/usr/bin/losos-release
  - test -f /dest/usr/lib/os-release
  - grep -q ID=losos-desktop /dest/usr/lib/os-release
