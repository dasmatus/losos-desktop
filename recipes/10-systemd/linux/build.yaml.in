# The kernel, plus the bpftool systemd's -Dbpf-framework needs.
#
# Two outputs from one tree, which is why bpftool is here rather than in
# 01-hosttools: it lives in the kernel source at tools/bpf/bpftool and must
# match the kernel it will generate skeletons against. systemd's meson looks it
# up by name, so it reaches that build through native.ini [binaries] (C3).
#
# The config is a defconfig plus files/linux/losos.config merged with the
# kernel's own merge_config.sh -- never a hand-maintained .config, which goes
# stale silently on every version bump.
#
# LLVM=1 on every make against this tree, config and install included. The
# build host carries clang, lld and the llvm-* binutils and no GNU toolchain
# at all (docs/host-requirements.md), so the kernel's GNU defaults resolve to
# nothing; LLVM=1 is its own documented switch for naming the whole LLVM
# toolchain at once. It is on the config steps too because the config records
# which compiler it was made for, and a later step that disagreed would
# reconfigure the tree underneath itself.
#
# `all` rather than `bzImage`: only x86 produces a bzImage. arm64's bootable
# output is an uncompressed Image with the EFI stub built in, at a different
# path entirely, so both the target and the path come from
# manifest/architectures.yaml.
name: linux
version:
- '7'
- '2'
- '6'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LINUX@: '@SHA256_LINUX@'
  run:
  - mkdir -p /build/src/linux /build/b/linux
  - tar -xf @DL_LINUX@ --no-same-owner -C /build/src/linux --strip-components=1

- stage: Build
  name: config
  dl_urls: null
  run:
  - make -C /build/src/linux O=/build/b/linux ARCH=@ARCH_KERNEL_ARCH@ LLVM=1 @ARCH_KERNEL_DEFCONFIG@
  # merge_config.sh is a shell script in the kernel tree, and the wrapper puts
  # it in the build directory because it writes .config relative to $PWD.
  #
  # It is invoked through an explicit `/bin/sh` rather than by its own name.
  # That is not decoration: `merge_config.sh` matches no pm fingerprint -- the
  # table matches the program NAME, and the name here ends in `.sh` rather than
  # being `sh` -- so naming it directly would let the wrapper smuggle an
  # unclassified program past `pm explain`. tools/gates/fingerprint-lint.py
  # catches exactly that, and caught exactly this.
  - /bin/sh @RECIPE@/in-dir.sh /build/b/linux /bin/sh /build/src/linux/scripts/kconfig/merge_config.sh -m -O /build/b/linux /build/b/linux/.config @RECIPE@/files/linux/losos.config
  - make -C /build/src/linux O=/build/b/linux ARCH=@ARCH_KERNEL_ARCH@ LLVM=1 olddefconfig
  # A fragment is only a request: fail before compiling if Kconfig discarded
  # the compressor or its boot default instead of silently shipping no zswap.
  - grep -qx CONFIG_SWAP=y /build/b/linux/.config
  - grep -qx CONFIG_ZSWAP=y /build/b/linux/.config
  - grep -qx CONFIG_ZSWAP_DEFAULT_ON=y /build/b/linux/.config
  - grep -qx CONFIG_ZSWAP_COMPRESSOR_DEFAULT_842=y /build/b/linux/.config
  - grep -qx CONFIG_CRYPTO_842=y /build/b/linux/.config
  - grep -qx CONFIG_ZSMALLOC=y /build/b/linux/.config

- stage: Build
  name: compile
  dl_urls: null
  run:
  # LEX/YACC are named explicitly: flex comes from the sysroot and cannot be
  # found on the jail's fixed PATH.
  - make -C /build/src/linux O=/build/b/linux ARCH=@ARCH_KERNEL_ARCH@ LLVM=1 LEX=/build/sysroot/usr/bin/flex YACC=/usr/bin/bison -j @JOBS@ all modules

- stage: Build
  name: bpftool
  dl_urls: null
  run:
  - make -C /build/src/linux/tools/bpf/bpftool O=/build/b/bpftool LLVM=1 -j @JOBS@
  - install -Dm755 /build/b/bpftool/bpftool /build/sysroot/usr/bin/bpftool
  - install -Dm755 /build/b/bpftool/bpftool /dest/usr/bin/bpftool

- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/src/linux O=/build/b/linux ARCH=@ARCH_KERNEL_ARCH@ LLVM=1 INSTALL_MOD_PATH=/dest/usr modules_install
  - make -C /build/src/linux O=/build/b/linux ARCH=@ARCH_KERNEL_ARCH@ LLVM=1 INSTALL_MOD_PATH=/build/sysroot/usr modules_install
  # The UKI needs the kernel image at a stable path; @VERSION_LINUX@ is the
  # only place the version is written, and it comes from sources.lock.
  - install -Dm644 /build/b/linux/@ARCH_KERNEL_IMAGE@ /dest/usr/lib/modules/@VERSION_LINUX@/vmlinuz
  - install -Dm644 /build/b/linux/@ARCH_KERNEL_IMAGE@ /build/sysroot/usr/lib/modules/@VERSION_LINUX@/vmlinuz

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -f /dest/usr/lib/modules/@VERSION_LINUX@/vmlinuz
  - test -x /dest/usr/bin/bpftool
