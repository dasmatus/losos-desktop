# Kernel options this OS needs on top of defconfig.
#
# Merged with scripts/kconfig/merge_config.sh, so this is a fragment: it states
# only what differs, and olddefconfig fills the rest. A full .config committed
# here would go stale on the first version bump without anyone noticing.

# systemd requires a unified cgroup hierarchy and refuses to boot without these.
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# systemd-oomd reads pressure stall information; without PSI it silently never
# acts, which is worse than not shipping it.
CONFIG_PSI=y

# udev, logind seats and systemd-nspawn.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_AUTOFS_FS=y

# -Dbpf-framework: RestrictFileSystems=, SocketBind*= and IP accounting in the
# shipped units are BPF programs. BTF is what lets them be portable.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y

# seccomp: every shipped unit's SystemCallFilter= depends on it.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Boot: systemd-stub is an EFI application, and the UKI carries a compressed
# initrd that the kernel must be able to decompress.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_KERNEL_XZ=y

# systemd-pstore.
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y

# Immutable /usr via systemd-veritysetup, LUKS via systemd-cryptsetup,
# partitioning via systemd-repart.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_INTEGRITY=y
CONFIG_EFI_PARTITION=y

# Measured boot: systemd-pcrlock, -pcrextend, -measure and TPM2-bound LUKS.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y

# FIDO2 security tokens: the OTHER factor a LUKS volume can be bound to, and
# the only one a user can carry. libfido2 reaches a token through /dev/hidraw
# and through nothing else -- systemd-homed unlocking a user's home image,
# systemd-cryptenroll enrolling a key against a LUKS volume, and a browser
# doing WebAuthn all open the same node.
#
# Named here rather than left to the defconfig because the two defconfigs this
# tree merges onto disagree. x86_64_defconfig carries CONFIG_HIDRAW=y and
# CONFIG_USB_HID is reached through CONFIG_USB_HIDDEV; arm64's defconfig sets
# neither, and CONFIG_HIDRAW's own default is n. So a token worked on one of
# the two architectures this repository builds and was invisible on the other,
# with the same symptom either way: every tool reports no device found, which
# reads as a broken key rather than as a missing kernel option.
#
# Built in rather than modular so the initrd needs no new manifest entry: an
# unlock that happens before switch-root cannot wait for a module that is not
# in the cpio.
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# systemd-vmspawn, and running this OS in a VM at all.
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=y

# The desktop: mutter needs KMS and evdev, nothing here needs Xorg.
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_NOUVEAU=y
CONFIG_INPUT_EVDEV=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y

# Filesystems the image and /home actually use.
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
