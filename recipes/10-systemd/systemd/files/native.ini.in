# meson native file for the systemd build.
#
# This file is the answer to the single most shaping constraint in this
# repository (C3 in docs/pm-constraints.md): pm canonicalises a step's first
# word ON THE HOST, so a program that exists only inside the jail -- everything
# under /build/sysroot -- can never be a step's first word. It can still be
# EXECUTED inside the jail; it just cannot be the thing pm resolves.
#
# meson execs the [binaries] entries below itself, from inside the jail, where
# those paths exist. That is how a pm-built gperf, msgfmt or bpftool reaches a
# build at all. Without it, systemd's meson looks up `gperf` on the container
# PATH, finds nothing, and the configure step fails on a host where gperf is
# simply not installed -- which is most of them.
[binaries]
c          = '@CC@'
cpp        = '@CXX@'
ar         = '@AR@'
nm         = '@NM@'
strip      = '@STRIP@'
pkg-config = '@PKGCONFIG@'
python3    = '@PYTHON@'
# Built by losos-01-hosttools, into this layer's sysroot.
gperf      = '/build/sysroot/usr/bin/gperf'
msgfmt     = '/build/sysroot/usr/bin/msgfmt'
msgmerge   = '/build/sysroot/usr/bin/msgmerge'
xgettext   = '/build/sysroot/usr/bin/xgettext'
flex       = '/build/sysroot/usr/bin/flex'
# Comes out of the kernel tree (tools/bpf/bpftool), built by the linux recipe
# in this same layer. -Dbpf-framework needs it and clang both.
bpftool    = '/build/sysroot/usr/bin/bpftool'

[built-in options]
prefix          = '/usr'
libdir          = 'lib'
sysconfdir      = '/etc'
localstatedir   = '/var'
pkg_config_path = '/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig'
c_args          = ['-I/build/sysroot/usr/include', '-O2']
c_link_args     = ['-L/build/sysroot/usr/lib', '-Wl,-rpath-link,/build/sysroot/usr/lib']
