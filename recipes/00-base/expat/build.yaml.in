# expat 2.6.3
#
# XML parser, required by dbus and fontconfig.
name: expat
version:
- '2'
- '6'
- '3'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_EXPAT@: '@SHA256_EXPAT@'
  run:
  - mkdir -p /build/src/expat /build/b/expat
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_EXPAT@ --no-same-owner -C /build/src/expat --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the sysroot is reached without `env`.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/expat /build/src/expat/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig CPPFLAGS=-I/build/sysroot/usr/include LDFLAGS=-L/build/sysroot/usr/lib --disable-static

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/expat -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/expat install DESTDIR=/dest
  - make -C /build/b/expat install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libexpat.so
