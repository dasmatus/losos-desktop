# zlib 1.3.1
#
# Compression, needed by systemd's journal and by half the tree.
name: zlib
version:
- '1'
- '3'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_ZLIB@: '@SHA256_ZLIB@'
  run:
  - mkdir -p /build/src/zlib /build/b/zlib
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_ZLIB@ --no-same-owner -C /build/src/zlib --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/zlib -B /build/b/zlib -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP@

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/zlib -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/zlib
  - cmake --install /build/b/zlib --prefix /build/sysroot/usr
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libz.so
