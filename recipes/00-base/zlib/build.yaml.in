# zlib 1.3.1
#
# Compression, needed by systemd's journal and by half the tree.
name: zlib
version:
- '1'
- '3'
- '1'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_ZLIB@: '@SHA256_ZLIB@'
  run:
  - mkdir -p /build/src/zlib /build/b/zlib
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_ZLIB@ --no-same-owner -C /build/src/zlib --strip-components=1

# One patch, and without it this recipe produces a library with no ABI rather
# than a build failure. zlib spells its public API with macros that expand to
# nothing on ELF, so -fvisibility=hidden -- which the manifest sets as CFI's
# precondition -- hides all 88 exported symbols. See the patch for the
# measurement. Applied with no fuzz, so the day upstream annotates the macros
# themselves this fails here rather than applying somewhere it was not meant
# to.
- stage: Build
  name: patch
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/apply-patches.sh @RECIPE@/files/zlib/patches /build/src/zlib

- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/zlib -B /build/b/zlib -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP@

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/zlib -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/zlib
  - make -C /build/b/zlib install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

# `test -e` was this whole step once, and it passed against a libz.so with an
# empty dynamic symbol table. A file existing is not a library; see
# files/check-exports.sh.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libz.so
  # The symbols this names used to be baked into a copy of the check that
  # lived in this recipe's files/. It moved to share/ when the same fault
  # turned up in libcap, libxcrypt, libfido2 and libqrencode within a day
  # of each other; naming them on the line is what made it shareable.
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libz.so deflate inflate gzopen zlibVersion
