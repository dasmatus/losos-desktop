# libpwquality 1.4.5
#
# systemd-homed refuses a weak password using it.
name: libpwquality
version:
- '1'
- '4'
- '5'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBPWQUALITY@: '@SHA256_LIBPWQUALITY@'
  run:
  - mkdir -p /build/src/libpwquality /build/b/libpwquality
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBPWQUALITY@ --no-same-owner -C /build/src/libpwquality --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
#
# --host is what tells autoconf this is a cross build. The target is musl and
# the build host is glibc, so a test program configure links runs against a
# loader at /lib/ld-musl-<arch>.so.1 that exists only inside the sysroot --
# AC_PROG_CC compiles one, tries to execute it, and reports "cannot run C
# compiled programs" as though the compiler were broken. With --host set,
# autoconf sets cross_compiling=yes and stops running what it builds. The
# triple is @TRIPLE@ rather than a literal because it is the architecture's,
# and this tree builds two.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/libpwquality /build/src/libpwquality/configure --host=@TRIPLE@ --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP@ LDFLAGS=@LDFLAGS_RSP@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig --disable-static --disable-python-bindings

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/libpwquality -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/libpwquality install DESTDIR=/dest
  - make -C /build/b/libpwquality install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libpwquality.so
