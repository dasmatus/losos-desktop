# libgcrypt 1.11.0
#
# Forward-secure sealing of the journal (journalctl --setup-keys) needs it.
name: libgcrypt
version:
- '1'
- '11'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBGCRYPT@: '@SHA256_LIBGCRYPT@'
  run:
  - mkdir -p /build/src/libgcrypt /build/b/libgcrypt
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBGCRYPT@ --no-same-owner -C /build/src/libgcrypt --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.

# CC_FOR_BUILD: the compiler for programs that run on the BUILD machine.
#
# Every configure in this tree is a cross build (--host, because everything
# above losos-00-toolchain is musl and the host is glibc), and `cross_compiling
# = yes` is what makes autoconf reach for a second compiler. Every upstream
# spelling of that reach defaults to `gcc`, and the build container installs
# clang, lld, llvm and compiler-rt and no gcc at all -- see the Containerfile.
# So the default is a program that is not there.
#
# @CC@ is the right answer and the flags are deliberately absent. The musl
# cross-ness of this tree lives entirely in CFLAGS, which is a clang response
# file; @CC@ on its own is /usr/bin/clang, and clang with no flags produces a
# glibc binary that runs on the build host, which is exactly what a build-time
# helper is for. share/native.ini.in carries the same compiler and the same
# deliberate absence of flags for the meson packages.
#
# libgcrypt is here defensively rather than because it is broken today. It
# calls the same AX_CC_FOR_BUILD as libgpg-error (configure.ac:195) and so
# carries the same untested `gcc`, but the only rule that spends it is
# tests/Makefile.am:101's testdrv-build, a check_PROGRAMS target `make all`
# never reaches. That is one `make check` away from being a real failure, and
# leaving one of the three unfixed is how a class comes back.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/libgcrypt /build/src/libgcrypt/configure --host=@ARCH_TRIPLE@ --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP@ LDFLAGS=@LDFLAGS_RSP@ CC_FOR_BUILD=@CC@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig --disable-static

# o_flag_munging is overridden rather than left to upstream. libgcrypt builds
# its jitter-entropy object by echoing its own compile line through that make
# variable and sed-rewriting -O2 to -O0 in the text, which finds nothing here:
# CFLAGS is a clang @response-file, so the optimisation level is in the file
# and not on the line. jitterentropy-base.c:58 then refuses to compile. A
# command-line assignment beats the Makefile's own (upstream uses `=`, not
# `override`), and files/o-flag-munging.sh carries the reasoning and the
# measurement -- including why --disable-jent-support is not the answer.
#
# Only the compile step needs it: the rule has run by the time install does,
# and a rule that somehow fired again would fail loudly rather than quietly
# build the collector with the optimiser on.
- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/libgcrypt -j @JOBS@ o_flag_munging=@RECIPE@/files/libgcrypt/o-flag-munging.sh

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/libgcrypt install DESTDIR=/dest
  - make -C /build/b/libgcrypt install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgcrypt.so
