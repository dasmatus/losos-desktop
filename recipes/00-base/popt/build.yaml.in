# popt 1.19
#
# Under cryptsetup.
name: popt
version:
- '1'
- '19'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_POPT@: '@SHA256_POPT@'
  run:
  - mkdir -p /build/src/popt /build/b/popt
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_POPT@ --no-same-owner -C /build/src/popt --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/popt /build/src/popt/configure --host=@ARCH_TRIPLE@ --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP@ LDFLAGS=@LDFLAGS_RSP@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig --disable-static

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/popt -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/popt install DESTDIR=/dest
  - make -C /build/b/popt install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

# An assertion and deliberately not an exception in manifest/toolchain.yaml,
# because the evidence stops one release short. popt 1.18 -- the closest
# version reachable from here, since ftp.osuosl.org is blocked and the Ubuntu
# archive carries 1.16 and 1.18 but not the pinned 1.19 -- is squarely in the
# hidden-visibility class: nothing in its configure.ac or src/Makefile.am
# mentions visibility in either direction, popt.h declares bare
# (`int poptGetNextOpt(poptContext con);`), and src/libpopt.vers reaches the
# linker as -Wl,--version-script, which is the shape that cannot rescue a
# symbol already made STV_HIDDEN.
#
# That is one version short of the pin and one-sided -- a predecessor, not a
# bracket -- so it is not enough to claim the exception. cryptsetup's entry
# rests on the pinned release's own contents in a repacked tarball, which is
# a different and stronger thing. Here the check costs nothing if 1.19
# annotates after all, and if it does not the build says so at popt with the
# diagnosis in check-exports.sh rather than at whatever links it next.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libpopt.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libpopt.so poptGetContext poptGetNextOpt poptFreeContext poptBadOption
