# libxml2 2.13.4
#
# Under shared-mime-info and the GNOME stack.
name: libxml2
version:
- '2'
- '13'
- '4'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBXML2@: '@SHA256_LIBXML2@'
  run:
  - mkdir -p /build/src/libxml2 /build/b/libxml2
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBXML2@ --no-same-owner -C /build/src/libxml2 --strip-components=1

# -Dpython=false, not `disabled`. libxml2 2.13.4 declares `python` a boolean,
# and meson rejects a boolean given a feature triplet before it reads anything
# else -- so this one option would have stopped the last member of the base
# layer after thirty-eight packages had built.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libxml2 /build/src/libxml2 --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig -Dpython=false

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libxml2 -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libxml2 --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libxml2 --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libxml2.so
