# openssl 3.3.2
#
# systemd's preferred crypto backend: DNS-over-TLS, systemd-creds, homed's password hashing and the TPM2 glue.
name: openssl
version:
- '3'
- '3'
- '2'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_OPENSSL@: '@SHA256_OPENSSL@'
  run:
  - mkdir -p /build/src/openssl /build/b/openssl
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_OPENSSL@ --no-same-owner -C /build/src/openssl --strip-components=1
  # openssl ships `Configure` and `config`, and no `configure` at all -- this
  # recipe named one for as long as it has existed, which is a path that does
  # not exist and a failure no gate here can see, because no gate runs a build.
  #
  # A COPY and not a symlink, and the difference is C3. pm canonicalises a
  # step's first word on the host and canonicalising resolves symlinks, so a
  # `configure` pointing at `Configure` arrives as `Configure` -- the same trap
  # that makes rustup's cargo symlink unusable here, documented in CLAUDE.md.
  # A copy has its own name and keeps it.
  #
  # Nothing inside Configure cares what it is called: it locates the source
  # tree with `dirname($0)` and `FindBin::Bin`, both of which give the
  # directory. Verified by running the copy out-of-tree against the pinned
  # 3.3.2 source -- it configured, wrote configdata.pm and a Makefile, and the
  # Makefile named the right source directory.
  - cp /build/src/openssl/Configure /build/src/openssl/configure

# openssl's Configure is not autotools and shares almost nothing with it. It
# has no -C, so the one permitted wrapper puts it in the build directory the
# way it does for a real configure (C1), and it takes VAR=value positionally,
# which is how the toolchain is reached without `env` -- but everything else
# on this line is openssl's own vocabulary:
#
#   @ARCH_OPENSSL_TARGET@  Configure's first argument is a target NAME, not a
#     triple, matched against Configurations/10-main.conf. It is not optional
#     and not guessable from --host, which Configure does not accept; the
#     script that guesses is `config`, whose name pm's fingerprint table does
#     not know. manifest/architectures.yaml carries the literal.
#   --libdir=lib           Relative, resolved under --prefix. Verified in the
#     generated Makefile: INSTALLTOP=/usr, LIBDIR=lib.
#   --openssldir=/etc/ssl  What --sysconfdir would have meant. There is no
#     --sysconfdir or --localstatedir here and passing either is an error.
#   no-tests               The test suite links and RUNS musl-dynamic binaries,
#     which pm's jail cannot execute at all (C7).
#   no-docs                Skips the pod2man pass, which is the only part of
#     the build that needs perl modules outside perl-base.
#   shared                 The default, said out loud, because this tree is
#     shared-only and the install step below removes the archives openssl
#     builds anyway.
#   no-module              The one option here that is not about what this
#     distribution wants, but about what the toolchain forces. openssl links
#     its loadable modules -- engines/afalg.so, engines/capi.so,
#     providers/legacy.so -- with -Wl,-z,defs, and cross-DSO CFI in diagnose
#     mode leaves __cfi_slowpath_diag and __ubsan_handle_cfi_check_fail
#     undefined in every shared object. Those two are irreconcilable, and the
#     build stopped there:
#
#         mold: error: undefined symbol: __ubsan_handle_cfi_check_fail
#         >>> referenced by e_capi.c
#
#     openssl already knows about this case and has an escape hatch for it.
#     Configurations/shared-info.pl:33-40 sets dso_ldflags to '' rather than
#     '-Wl,-z,defs' when it greps -fsanitize out of CFLAGS. It cannot see
#     ours: CFLAGS here is the single token @<path>/cflags-openssl.rsp,
#     because pm splits a command on whitespace and a flag list cannot
#     survive as one argument (C1). Every sanitizer flag this tree sets is
#     inside the response file, where openssl's grep cannot reach.
#
#     The hatch cannot be opened from the outside either. Passing a bare
#     -fsanitize=cfi-icall alongside CFLAGS= is refused -- "Mixing make
#     variables and additional compiler/linker flags as configure command
#     line option is not permitted", Configure:1158-1175 -- and the %20
#     escape that would smuggle a space into one argument is applied only to
#     bare flags, not to make variables, which Configure:816 stores raw.
#
#     So the DSO links go instead of the flag. no-module cascades to
#     no-dynamic-engine (Configure:639, and INSTALL.md says so), which makes
#     engines/build.info compile the engines into libcrypto, and
#     providers/build.info:135 does the same for the legacy provider. Nothing
#     is dropped: padlock, afalg, capi, devcrypto and legacy are all still
#     built, as part of libcrypto rather than as files something would have
#     to dlopen. This image is sealed and verity-protected and loads no
#     third-party engine, so what is given up is a capability it does not
#     have. It also disables FIPS, which is off by default and not enabled
#     here.
#
#     libcrypto.so.3 and libssl.so.3 are unaffected: they link through
#     shared_ldflag, which carries no -z,defs, and both linked cleanly in the
#     run that failed on the modules.
#
# There is no PKG_CONFIG_PATH: openssl asks pkg-config for nothing.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments. The response file is one word, and clang expands it.
# Verified that it survives: the generated Makefile spells
# `CFLAGS=@<path>/cflags-openssl.rsp` verbatim, and `LIB_CFLAGS=-fPIC
# $(CNF_CFLAGS) $(CFLAGS)` puts it last, so this tree's -O2, hardening, LTO
# and CFI win over openssl's own.
#
# The flags are this package's own response files, not the layer's shared
# pair, and naming them is the entire mechanism: manifest/toolchain.yaml
# gives openssl `drops: [visibility]`, tools/configure writes
# cflags-openssl.rsp for it either way, and a recipe left spelling
# @CFLAGS_RSP@ gets the shared flags with the exemption written to disk and
# read by nothing. Without it libcrypto and libssl install with empty dynamic
# symbol tables and curl is the first thing to say so.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/openssl /build/src/openssl/configure @ARCH_OPENSSL_TARGET@ --prefix=/usr --libdir=lib --openssldir=/etc/ssl no-tests no-docs no-module shared CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP_OPENSSL@ LDFLAGS=@LDFLAGS_RSP_OPENSSL@

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/openssl -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/openssl install DESTDIR=/dest
  - make -C /build/b/openssl install DESTDIR=/build/sysroot
  # openssl has no `no-static`: the generated Makefile spells
  # `INSTALL_LIBS=libcrypto.a libssl.a` whatever it was configured with, so the
  # archives are removed rather than not built. Every other library in this
  # layer is shared-only, and a .a left in the sysroot is something a later
  # link can quietly prefer -- the same reason libcap and libbpf end this way.
  - rm -f /dest/usr/lib/libcrypto.a /dest/usr/lib/libssl.a /build/sysroot/usr/lib/libcrypto.a /build/sysroot/usr/lib/libssl.a
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libssl.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libssl.so SSL_new SSL_CTX_new SSL_connect OPENSSL_init_ssl
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libcrypto.so OPENSSL_init_crypto EVP_EncryptInit_ex EVP_DigestInit_ex
