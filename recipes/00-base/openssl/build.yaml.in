# openssl 3.3.2
#
# systemd's preferred crypto backend: DNS-over-TLS, systemd-creds, homed's password hashing and the TPM2 glue.
name: openssl
version:
- '3'
- '3'
- '2'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_OPENSSL@: '@SHA256_OPENSSL@'
  run:
  - mkdir -p /build/src/openssl /build/b/openssl
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_OPENSSL@ --no-same-owner -C /build/src/openssl --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
- stage: Build
  name: configure
  dl_urls: null
  run:
# The flags are this package's own response files, not the layer's shared
# pair, and naming them is the entire mechanism: manifest/toolchain.yaml
# gives openssl `drops: [visibility]`, tools/configure writes
# cflags-openssl.rsp for it either way, and a recipe left spelling
# @CFLAGS_RSP@ gets the shared flags with the exemption written to disk and
# read by nothing. Without it libcrypto and libssl install with empty dynamic
# symbol tables and curl is the first thing to say so.
  - /bin/sh @RECIPE@/in-dir.sh /build/b/openssl /build/src/openssl/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP_OPENSSL@ LDFLAGS=@LDFLAGS_RSP_OPENSSL@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/openssl -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/openssl install DESTDIR=/dest
  - make -C /build/b/openssl install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libssl.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libssl.so SSL_new SSL_CTX_new SSL_connect OPENSSL_init_ssl
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libcrypto.so OPENSSL_init_crypto EVP_EncryptInit_ex EVP_DigestInit_ex
