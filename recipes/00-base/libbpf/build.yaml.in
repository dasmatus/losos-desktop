# libbpf 1.4.6
#
# systemd's -Dbpf-framework: RestrictFileSystems=, SocketBind*= and the IP accounting in shipped units are BPF programs.
name: libbpf
version:
- '1'
- '4'
- '6'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBBPF@: '@SHA256_LIBBPF@'
  run:
  - mkdir -p /build/src/libbpf /build/b/libbpf
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBBPF@ --no-same-owner -C /build/src/libbpf --strip-components=1

# libbpf ships no meson.build, and no configure either: the whole build is
# src/Makefile, which is why there is no configure step here. It reads
# ../include and ../include/uapi relative to itself and greps libbpf.map in
# its own directory, so it has to run with src/ as the working directory --
# `make -C` is what gives it that. OBJDIR keeps the objects, the .so and the
# generated .pc out of the source tree the way every other recipe here does.
#
# EXTRA_CFLAGS and EXTRA_LDFLAGS rather than CFLAGS and LDFLAGS: the Makefile
# spells `CFLAGS ?= -g -O2 -Werror -Wall -std=gnu89` and libbpf's sources are
# written against that dialect, so assigning CFLAGS would silently take
# -std=gnu89 away. The EXTRA_ pair appends, and appends *last*, so the layer's
# own -O2 and hardening still win where the two disagree.
#
# NO_PKG_CONFIG=1 puts -lelf -lz on the link directly instead of asking
# pkg-config for them. Not a shortcut: the pkg-config a step finds is the
# build host's, and the recipe has no way to point it at the sysroot -- meson
# takes --pkg-config-path and configure takes PKG_CONFIG_PATH=, but a make
# variable is not the environment, and `env` is banned. -lelf and -lz resolve
# against --sysroot=/build/sysroot in the response file, which is where
# elfutils and zlib have just installed them.
- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/src/libbpf/src -j @JOBS@ OBJDIR=/build/b/libbpf PREFIX=/usr LIBDIR=/usr/lib CC=@CC@ AR=@AR@ EXTRA_CFLAGS=@CFLAGS_RSP@ EXTRA_LDFLAGS=@LDFLAGS_RSP@ NO_PKG_CONFIG=1

# LIBDIR is not optional and not cosmetic. Left unset the Makefile derives it
# from `$(CC) -dumpmachine` and picks lib64 for any triple ending in 64 --
# which both x86_64 and aarch64 do -- and the library would install to
# /usr/lib64, where nothing in this tree looks.
#
# The rm is the price of this build system: `all` builds libbpf.a
# unconditionally and `install` copies it beside the shared library, with no
# option to ask for neither. Everything else in this layer is configured
# shared-only, and a static libbpf left in the sysroot is something a later
# link can silently prefer.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/src/libbpf/src install DESTDIR=/dest OBJDIR=/build/b/libbpf PREFIX=/usr LIBDIR=/usr/lib CC=@CC@ AR=@AR@ EXTRA_CFLAGS=@CFLAGS_RSP@ EXTRA_LDFLAGS=@LDFLAGS_RSP@ NO_PKG_CONFIG=1
  - make -C /build/src/libbpf/src install DESTDIR=/build/sysroot OBJDIR=/build/b/libbpf PREFIX=/usr LIBDIR=/usr/lib CC=@CC@ AR=@AR@ EXTRA_CFLAGS=@CFLAGS_RSP@ EXTRA_LDFLAGS=@LDFLAGS_RSP@ NO_PKG_CONFIG=1
  - rm -f /dest/usr/lib/libbpf.a /build/sysroot/usr/lib/libbpf.a
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libbpf.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libbpf.so bpf_object__open bpf_object__load bpf_object__close libbpf_strerror
  - test -e /dest/usr/include/bpf/libbpf.h
  - test -e /dest/usr/lib/pkgconfig/libbpf.pc
