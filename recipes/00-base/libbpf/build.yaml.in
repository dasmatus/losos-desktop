# libbpf 1.4.6
#
# systemd's -Dbpf-framework: RestrictFileSystems=, SocketBind*= and the IP accounting in shipped units are BPF programs.
name: libbpf
version:
- '1'
- '4'
- '6'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBBPF@: '@SHA256_LIBBPF@'
  run:
  - mkdir -p /build/src/libbpf /build/b/libbpf
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBBPF@ --no-same-owner -C /build/src/libbpf --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py setup /build/b/libbpf /build/src/libbpf --native-file @RECIPE@/native.ini --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nodownload --pkg-config-path=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig

- stage: Build
  name: compile
  dl_urls: null
  run:
  - ninja -C /build/b/libbpf -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libbpf --destdir /dest --no-rebuild
  - python3 /build/sysroot/usr/lib/meson/meson.py install -C /build/b/libbpf --destdir /build/sysroot --no-rebuild
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libbpf.so
