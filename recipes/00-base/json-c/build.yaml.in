# json-c 0.18
#
# Under cryptsetup's LUKS2 header handling.
name: json-c
version:
- '0'
- '18'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_JSON_C@: '@SHA256_JSON_C@'
  run:
  - mkdir -p /build/src/json-c /build/b/json-c
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_JSON_C@ --no-same-owner -C /build/src/json-c --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
# The flags are this package's own response files, not the layer's shared
# pair, and naming them is the entire mechanism: manifest/toolchain.yaml
# gives json-c `drops: [visibility]`, tools/configure writes
# cflags-json-c.rsp for it either way, and a recipe left spelling
# @CFLAGS_RSP@ gets the shared flags with the exemption written to disk and
# read by nothing. Without it libjson-c installs empty and cryptsetup's
# token handling is the first thing to say so.
  - cmake -S /build/src/json-c -B /build/b/json-c -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP_JSON_C@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP_JSON_C@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP_JSON_C@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP_JSON_C@ -DBUILD_STATIC_LIBS=OFF

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/json-c -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/json-c
  - make -C /build/b/json-c install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libjson-c.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libjson-c.so json_object_new_object json_object_put json_tokener_parse json_object_to_json_string
