# libfido2 1.15.0
#
# FIDO2 tokens as a LUKS unlock factor, via systemd-cryptenroll.
#
# THIS RECIPE CANNOT BUILD WHERE manifest/layers.yaml PUTS IT, and no build has
# reached it yet to say so: it is member twenty-nine of losos-10-base's
# thirty-nine. Found by configuring the pinned source rather than by waiting.
#
# libfido2 hard-requires libudev on Linux. CMakeLists.txt calls
# `pkg_search_module(UDEV libudev REQUIRED)` in the non-MSVC branch whenever
# CMAKE_SYSTEM_NAME is Linux, and it is NOT gated on NFC_LINUX, so turning NFC
# off does not avoid it. Nor is it a configure-time artifact: src/hid_linux.c
# is compiled on Linux unconditionally and makes fourteen udev_* calls --
# udev_new, the udev_enumerate_* family, udev_device_* -- to find hidraw nodes
# at all.
#
# losos-10-base has no udev. systemd is the only provider in this tree, it is
# the layer above in losos-20-systemd, and it is built -Dlibfido2=enabled. So
# the two need each other, which is a genuine cycle and not a missing
# dependency line.
#
# Four ways out, and choosing is a change to the layer graph rather than to
# this file, so it belongs in its own pull request:
#
#   1. A reduced udev-only systemd in the base layer, then libcbor, libfido2
#      and libqrencode, then the full systemd above. Keeps one udev
#      implementation and loses nothing; costs a second systemd compile,
#      because pm has no build cache (C5, C6), and pass one leaves files
#      behind that pass two may not overwrite.
#   2. eudev in the base layer. Cheap, and puts a systemd fork in a
#      systemd-native distribution, with two libudev.so.1 meeting in the image.
#   3. Patch hid_linux.c to walk /dev/hidraw* directly. Carried forever and
#      re-derived at every bump.
#   4. Drop -Dlibfido2=enabled from systemd. No hardware unlock; the WebAuthn
#      half of docs/yubikey.md is unaffected, since that is udev rules and a
#      kernel config rather than this library.
#
# Written here rather than left in a thread because the build will reach this
# recipe before the decision is made, and the next reader should get the
# diagnosis instead of repeating it.
name: libfido2
version:
- '1'
- '15'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBFIDO2@: '@SHA256_LIBFIDO2@'
  run:
  - mkdir -p /build/src/libfido2 /build/b/libfido2
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBFIDO2@ --no-same-owner -C /build/src/libfido2 --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/libfido2 -B /build/b/libfido2 -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP_LIBFIDO2@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP_LIBFIDO2@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP_LIBFIDO2@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP_LIBFIDO2@ -DBUILD_STATIC_LIBS=OFF -DBUILD_MANPAGES=OFF

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/libfido2 -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/libfido2
  - make -C /build/b/libfido2 install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

  # libfido2 is on a drops: [visibility] exception, and this is what makes
  # that exception honest rather than hopeful. fido_dev_open present means the
  # API really did survive -- it does not, at hidden visibility, despite the
  # version script naming it. __cfi_check present means the narrow drop kept
  # CFI rather than silently losing it, which is the whole reason for
  # preferring it over drops: [cfi] on a library that parses CBOR off a USB
  # device. Neither symbol proves the other: __cfi_check is there at hidden
  # visibility too.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libfido2.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libfido2.so fido_init fido_dev_open fido_dev_info_manifest __cfi_check
