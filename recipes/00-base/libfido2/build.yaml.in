# libfido2 1.15.0
#
# FIDO2 tokens as a LUKS unlock factor, via systemd-cryptenroll.
name: libfido2
version:
- '1'
- '15'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBFIDO2@: '@SHA256_LIBFIDO2@'
  run:
  - mkdir -p /build/src/libfido2 /build/b/libfido2
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBFIDO2@ --no-same-owner -C /build/src/libfido2 --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/libfido2 -B /build/b/libfido2 -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC_LIBS=OFF -DBUILD_MANPAGES=OFF

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/libfido2 -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/libfido2
  - cmake --install /build/b/libfido2 --prefix /build/sysroot/usr
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libfido2.so
