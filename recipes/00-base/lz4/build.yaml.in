# lz4 1.10.0
#
# Fast compression for coredumps systemd must not spend long on.
name: lz4
version:
- '1'
- '10'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LZ4@: '@SHA256_LZ4@'
  run:
  - mkdir -p /build/src/lz4 /build/b/lz4
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LZ4@ --no-same-owner -C /build/src/lz4 --strip-components=1

- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/lz4 -B /build/b/lz4 -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC_LIBS=OFF

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/lz4 -j @JOBS@

- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/lz4
  - cmake --install /build/b/lz4 --prefix /build/sysroot/usr
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/liblz4.so
