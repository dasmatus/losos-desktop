# lz4 1.10.0
#
# Fast compression for coredumps systemd must not spend long on.
name: lz4
version:
- '1'
- '10'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LZ4@: '@SHA256_LZ4@'
  run:
  - mkdir -p /build/src/lz4 /build/b/lz4
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LZ4@ --no-same-owner -C /build/src/lz4 --strip-components=1

# Like zstd, lz4 ships no CMakeLists.txt at the top of its tarball -- the cmake
# project is build/cmake -- so -S has to name the subdirectory. Pointed at the
# tarball root, cmake stops before reading any option at all: `The source
# directory does not appear to contain CMakeLists.txt`. Unlike zstd, nothing
# further is needed here: lz4's CLI links against the shared library when
# BUILD_STATIC_LIBS is off rather than refusing to configure.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/lz4/build/cmake -B /build/b/lz4 -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP@ -DBUILD_STATIC_LIBS=OFF

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/lz4 -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/lz4
  - make -C /build/b/lz4 install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/liblz4.so
