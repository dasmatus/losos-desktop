# curl 8.22.0
#
# systemd-importd and systemd-sysupdate fetch over HTTP with it.
name: curl
version:
- '8'
- '22'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_CURL@: '@SHA256_CURL@'
  run:
  - mkdir -p /build/src/curl /build/b/curl
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_CURL@ --no-same-owner -C /build/src/curl --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
#
# --enable-versioned-symbols is not about versioned symbols. It is how curl is
# kept away from libtool's global symbol pipe, which does not work anywhere in
# this tree and takes a while to explain, so: the base layer stopped here with
#
#     ../libtool: eval: line 1877: syntax error near unexpected token `|'
#     ../libtool: eval: line 1877: `/usr/bin/llvm-nm  .libs/libcurl_la-...
#
# which is a shell error rather than a link error, and it is what an empty
# $global_symbol_pipe looks like: ltmain evals `$NM <objects> | $pipe`, and
# with the pipe empty the line ends in a bare `|`.
#
# The pipe is empty because libtool's configure-time probe for it FAILED, and
# it failed because clang crashes. The probe compiles a tiny file, runs $NM
# over the object, and then generates a second C file declaring every symbol
# it found and taking each one's address. Under -flto=thin the object is LLVM
# bitcode, and llvm-nm lists what cross-DSO CFI put there:
#
#     ---------------- W __cfi_check
#     ---------------- W __cfi_check_fail
#
# so the generated file contains `extern char __cfi_check;` and
# `&__cfi_check`. Compiling that with the same -fsanitize-cfi-cross-dso makes
# clang 18.1.3 die in CodeGenFunction::EmitCfiCheckStub() -- a signal and a
# "PLEASE submit a bug report", not a diagnostic. libtool concludes the pipe
# does not work, sets it empty, prints `failed`, and carries on. Reproduced
# here step by step on clang 18.1.3 rather than deduced from the log.
#
# So EVERY autotools package in this tree has an empty symbol pipe, and it has
# been that way since the first CFI build. It only matters to a package that
# asks libtool to compute an export list, and curl is the first one the build
# has reached: lib/Makefile.am:122 adds -export-symbols-regex '^curl_.*'.
#
# That line is the `else` branch. :118 is the other one, and the switch is
# CURL_LT_SHLIB_USE_VERSIONED_SYMBOLS:
#
#     if CURL_LT_SHLIB_USE_VERSIONED_SYMBOLS
#     libcurl_la_LDFLAGS_EXTRA += -Wl,--version-script=libcurl.vers
#     else
#     if DOING_CURL_SYMBOL_HIDING
#     libcurl_la_LDFLAGS_EXTRA += -export-symbols-regex '^curl_.*'
#
# A version script is a flag libtool hands to the linker and never reads, so
# taking that branch is the whole fix. configure.ac:2807-2853 turns the
# conditional on, and with --with-openssl the symbols are versioned
# CURL_OPENSSL_4, which is what every distribution shipping curl against
# OpenSSL already does.
#
# The other way out of that `else` would be --disable-symbol-hiding, and it is
# a trap. DOING_CURL_SYMBOL_HIDING off means CURL_HIDDEN_SYMBOLS is undefined,
# which makes CURL_EXTERN expand to nothing (include/curl/curl.h:137) -- and
# this layer passes -fvisibility=hidden regardless, so libcurl would install
# with an empty dynamic symbol table and need an exception it does not
# currently need. With symbol hiding left on, CURL_EXTERN is
# __attribute__((__visibility__("default"))) (m4/curl-compilers.m4:1506) and
# curl is annotated, which is why it has no entry in manifest/toolchain.yaml.
#
# If curl's own probe for the option ever answers no -- it greps
# `$LD --help` for version-script at configure.ac:2818 -- the build comes back
# to the same libtool syntax error rather than quietly producing something
# wrong, so this is not a silent dependency.
#
# gnutls and libtasn1 reach the same else branch and need nothing: theirs is
# chosen by gnulib's gl_LD_VERSION_SCRIPT, which was run against mold rather
# than assumed. manifest/toolchain.yaml, beside cfi.cross_dso, has that.
#
# Read at the curl-8_22_0 tag in curl's own repository: curl.se is not
# reachable from here, and the lock pins a release tarball, so the generated
# configure differs while configure.ac, lib/Makefile.am and the headers are
# the authored tree.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/curl /build/src/curl/configure --host=@ARCH_TRIPLE@ --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP@ LDFLAGS=@LDFLAGS_RSP@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig --disable-static --with-openssl --without-libpsl --enable-versioned-symbols

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/curl -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/curl install DESTDIR=/dest
  - make -C /build/b/curl install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

# systemd links libcurl (-Dlibcurl=enabled), so an empty one would fail a link
# rather than ship -- but the version script is new here and these say it was
# applied and kept the right side of it. __cfi_check says the schemes survived.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libcurl.so
  - test -e /dest/usr/lib/libcurl.so.4
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libcurl.so curl_easy_init curl_easy_setopt curl_easy_perform curl_multi_init curl_global_init curl_url_set __cfi_check
