# zstd 1.5.6
#
# systemd's default journal and coredump compressor since v246.
name: zstd
version:
- '1'
- '5'
- '6'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_ZSTD@: '@SHA256_ZSTD@'
  run:
  - mkdir -p /build/src/zstd /build/b/zstd
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_ZSTD@ --no-same-owner -C /build/src/zstd --strip-components=1

# zstd ships no CMakeLists.txt at the top of its tarball: the whole cmake
# project lives in build/cmake, and -S has to name it. Pointed at the tarball
# root, cmake stops before it reads a single option with `The source directory
# does not appear to contain CMakeLists.txt`.
#
# ZSTD_PROGRAMS_LINK_SHARED goes with ZSTD_BUILD_STATIC=OFF and is not optional.
# ZSTD_BUILD_PROGRAMS defaults ON, and build/cmake/CMakeLists.txt:151 raises
# SEND_ERROR -- "You need to build static library to build zstd CLI" -- when the
# CLI is being built and neither a static library nor a shared link is on offer.
# SEND_ERROR lets configure run to the end and then refuses to generate, so the
# failure arrives after a screen of successful checks. Linking the CLI against
# the shared library is what the recipe already asks for; turning the programs
# off instead would drop /usr/bin/zstd from the image, which is a separate
# decision and not this one's to make.
#
# The flags are the per-package response files, not the layer's shared ones,
# and the spelling is the whole mechanism: an exception in
# manifest/toolchain.yaml applies only to a recipe that names it, so
# @CFLAGS_RSP@ here would leave the entry inert with nothing to say so. zstd's
# drops `stdlibxx`, which puts -nostdlib++ on the link. project() at
# build/cmake/CMakeLists.txt:33 names CXX for contrib code this recipe does not
# build, cmake tests every language project() names, and clang++ links libstdc++
# by default -- which no musl sysroot here has. Without it the step dies at
# `mold: fatal: library not found: stdc++` before zstd compiles anything.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/zstd/build/cmake -B /build/b/zstd -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP_ZSTD@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP_ZSTD@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP_ZSTD@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP_ZSTD@ -DZSTD_BUILD_STATIC=OFF -DZSTD_PROGRAMS_LINK_SHARED=ON

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/zstd -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/zstd
  - make -C /build/b/zstd install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libzstd.so
