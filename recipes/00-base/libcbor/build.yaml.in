# libcbor 0.11.0
#
# Under libfido2.
name: libcbor
version:
- '0'
- '11'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBCBOR@: '@SHA256_LIBCBOR@'
  run:
  - mkdir -p /build/src/libcbor /build/b/libcbor
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBCBOR@ --no-same-owner -C /build/src/libcbor --strip-components=1

# CMAKE_CXX_COMPILER_WORKS stops cmake compiling and *linking* a C++ test
# program before it reads a line of this project. libcbor's root CMakeLists.txt
# says `project(libcbor)` with no language list, and a bare project() means
# `C CXX` -- so the C++ toolchain is exercised by a library that is pure C. The
# test links, clang++ puts libstdc++ on the line by default, and no musl sysroot
# in this tree has one: `mold: fatal: library not found: stdc++`.
#
# libcbor really does compile no C++. src/CMakeLists.txt lists twenty .c files
# and nothing else; WITH_TESTS is OFF by default and is not turned on here; the
# two examples WITH_EXAMPLES builds are readfile.c and create_items.c. So the
# skip asserts nothing untrue -- it is the same finding and the same fix as
# zstd's, and the same tombstone applies: a `drops: [stdlibxx]` exception is not
# the answer, because -nostdlib++ leaves the CFI layer's
# libclang_rt.ubsan_standalone_cxx with no C++ ABI to resolve against.
#
# Hidden visibility is not a problem here the way it was for zstd's CLI:
# src/CMakeLists.txt runs generate_export_header(cbor), so every public symbol
# carries an explicit visibility("default") and the examples link against the
# same shared library the sysroot gets.
- stage: Build
  name: configure
  dl_urls: null
  run:
# CMAKE_POLICY_DEFAULT_CMP0056=NEW, for the reason written out at length in
# recipes/00-base/libqrencode: CMP0056 is "try_compile() honours
# CMAKE_EXE_LINKER_FLAGS", added in CMake 3.2, and a project whose own
# cmake_minimum_required is older gets the OLD behaviour, so every try_compile
# -- CMakeTestCCompiler included, which runs before anything else -- silently
# drops the linker flags passed just above. libcbor's CMakeLists.txt:1 asks for
# 3.0 and its only cmake_policy call is CMP0069 at :157, read across the whole
# 185-line file at the v0.11.0 tag. Without this the failure is
# `clang - broken` and a missing crtbeginS.o, which reads as a broken toolchain
# and is a probe that was never given --rtlib=compiler-rt.
#
# libqrencode (member 21) and libcbor (28) are the only two cmake packages in
# this tree that need it, and that is checked rather than assumed: zstd and lz4
# ask 3.5 and libfido2 3.7, while zlib, json-c and libjpeg-turbo use the
# `<min>...<max>` form, which sets every policy up to <max> to NEW. Left
# per-recipe rather than defaulted tree-wide so that the two packages carrying
# an old declaration are the two that say so.
  - cmake -S /build/src/libcbor -B /build/b/libcbor -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_POLICY_DEFAULT_CMP0056=NEW -DBUILD_SHARED_LIBS=ON -DCMAKE_CXX_COMPILER_WORKS=1

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/libcbor -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/libcbor
  - make -C /build/b/libcbor install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

  # libcbor keeps hidden visibility -- src/CMakeLists.txt runs
  # generate_export_header(cbor), so every public symbol carries an explicit
  # visibility("default") and nothing has to be given up for it. Named here
  # anyway, because that is a property of upstream that a version bump could
  # quietly change, and the failure it would cause is silent: see
  # share/check-exports.sh. __cfi_check is asserted alongside so a future
  # exception cannot take the checks away without this step noticing.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libcbor.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libcbor.so cbor_load cbor_serialize __cfi_check
