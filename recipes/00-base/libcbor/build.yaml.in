# libcbor 0.11.0
#
# Under libfido2.
name: libcbor
version:
- '0'
- '11'
- '0'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_LIBCBOR@: '@SHA256_LIBCBOR@'
  run:
  - mkdir -p /build/src/libcbor /build/b/libcbor
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_LIBCBOR@ --no-same-owner -C /build/src/libcbor --strip-components=1

# CMAKE_CXX_COMPILER_WORKS stops cmake compiling and *linking* a C++ test
# program before it reads a line of this project. libcbor's root CMakeLists.txt
# says `project(libcbor)` with no language list, and a bare project() means
# `C CXX` -- so the C++ toolchain is exercised by a library that is pure C. The
# test links, clang++ puts libstdc++ on the line by default, and no musl sysroot
# in this tree has one: `mold: fatal: library not found: stdc++`.
#
# libcbor really does compile no C++. src/CMakeLists.txt lists twenty .c files
# and nothing else; WITH_TESTS is OFF by default and is not turned on here; the
# two examples WITH_EXAMPLES builds are readfile.c and create_items.c. So the
# skip asserts nothing untrue -- it is the same finding and the same fix as
# zstd's, and the same tombstone applies: a `drops: [stdlibxx]` exception is not
# the answer, because -nostdlib++ leaves the CFI layer's
# libclang_rt.ubsan_standalone_cxx with no C++ ABI to resolve against.
#
# Hidden visibility is not a problem here the way it was for zstd's CLI:
# src/CMakeLists.txt runs generate_export_header(cbor), so every public symbol
# carries an explicit visibility("default") and the examples link against the
# same shared library the sysroot gets.
#
# CMAKE_POLICY_DEFAULT_CMP0056=NEW is a second, unrelated problem with the same
# `project()` call, and it is the C compiler test rather than the C++ one.
# CMP0056 is "try_compile() honours CMAKE_EXE_LINKER_FLAGS", added in CMake
# 3.2, and a project gets the OLD behaviour when its own
# cmake_minimum_required is older -- libcbor's CMakeLists.txt:1 asks for 3.0.
# So the sanity check drops the LDFLAGS response file, which is the only place
# --rtlib=compiler-rt, --unwindlib=libunwind and -fuse-ld=mold are written, and
# links with clang's defaults against a sysroot that has neither the GCC
# runtime nor its crt objects. libqrencode failed exactly that way at member 21
# and the error named the wrong thing entirely:
#
#     -- Check for working C compiler: /usr/bin/clang - broken
#     /usr/bin/ld: cannot find crtbeginS.o: No such file or directory
#     /usr/bin/ld: cannot find -lgcc: No such file or directory
#
# libcbor is member 28 and is the only other package in this tree that declares
# a minimum below 3.2 -- swept at the pinned versions rather than waiting for
# the build to arrive: zstd and lz4 ask for 3.5, libfido2 for 3.7, and zlib
# (2.4.4...3.15.0), json-c (3.9...3.12) and libjpeg-turbo (2.8.12...3.28) use
# the <min>...<max> form, which sets every policy up to <max> to NEW. So this
# is the last of them, not the second of many.
#
# CMAKE_POLICY_VERSION_MINIMUM=3.5 rides along for the same line 1, and only
# since the build host became Arch: CMake 4 made a pre-3.5 policy version an
# error rather than a deprecation warning, where Debian trixie's CMake 3.31
# still accepted it. The sweep above covers it unchanged -- 3.5 is above 3.2,
# so the two packages under the CMP0056 floor are exactly the two under this
# one. libqrencode carries the error text and the reasoning -- including why
# the two policy flags on this line are not redundant, and why dropping
# either one breaks one of the two bases.
#
# The CXX skip above is NOT what fixes this and would not have: it suppresses a
# test rather than correcting the flags one is run with, and the C test has no
# equivalent here because the C compiler genuinely has to work.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - cmake -S /build/src/libcbor -B /build/b/libcbor -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_PREFIX_PATH=/build/sysroot/usr -DCMAKE_FIND_ROOT_PATH=/build/sysroot -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=@CC@ -DCMAKE_CXX_COMPILER=@CXX@ -DCMAKE_AR=@AR@ -DCMAKE_RANLIB=@RANLIB@ -DCMAKE_C_FLAGS=@CFLAGS_RSP@ -DCMAKE_CXX_FLAGS=@CFLAGS_RSP@ -DCMAKE_EXE_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_SHARED_LINKER_FLAGS=@LDFLAGS_RSP@ -DCMAKE_POLICY_DEFAULT_CMP0056=NEW -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=ON -DCMAKE_CXX_COMPILER_WORKS=1

- stage: Build
  name: compile
  dl_urls: null
  run:
  - cmake --build /build/b/libcbor -j @JOBS@

# The sysroot install goes through make rather than `cmake --install --prefix`.
# DESTDIR=/dest is in the environment of every step, and cmake prepends it to
# whatever --prefix says: that spelling wrote the whole tree into
# /dest/build/sysroot/usr and left the sysroot empty, so a sibling in the same
# bundle linked against nothing. A variable set on make's command line is
# exported, which is the DESTDIR cmake_install.cmake actually reads.
- stage: Build
  name: install
  dl_urls: null
  run:
  - cmake --install /build/b/libcbor
  - make -C /build/b/libcbor install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libcbor.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libcbor.so cbor_load cbor_serialize __cfi_check
