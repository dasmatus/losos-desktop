# gnutls 3.8.7
#
# The alternative TLS backend for journal-remote and journal-upload.
name: gnutls
version:
- '3'
- '8'
- '7'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_GNUTLS@: '@SHA256_GNUTLS@'
  run:
  - mkdir -p /build/src/gnutls /build/b/gnutls
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_GNUTLS@ --no-same-owner -C /build/src/gnutls --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
#
# The flags are this package's own response files, not the layer's shared
# pair, and naming them is the entire mechanism: manifest/toolchain.yaml
# gives gnutls `drops: [visibility]`, tools/configure writes cflags-gnutls.rsp
# for it either way, and a recipe left spelling @CFLAGS_RSP@ gets the shared
# flags with the exemption written to disk and read by nothing.
#
# gnutls needs the exemption for a reason that reads like the opposite. Its
# whole public API is declared through _SYM_EXPORT, which is the shape of an
# export hook and is `__declspec(dllimport)` on Windows and empty everywhere
# else (lib/includes/gnutls/gnutls.h.in:68-70). What exports libgnutls is
# lib/Makefile.am:281's -Wl,--version-script and :283's
# -export-symbols-regex, both of which run long after the compiler has made
# every symbol hidden. See manifest/toolchain.yaml for the rest.
#
# --without-brotli is the same host-versus-sysroot problem linux-pam's
# --disable-logind describes: PKG_CONFIG_PATH names the sysroot's .pc
# directories but cannot subtract the host's, so pkg-config still reads its
# compiled-in default path (/usr/lib/pkgconfig among it) and the host carries
# libbrotlienc.pc (Arch's curl depends on brotli) where the sysroot -- and this
# whole tree -- has no brotli at all. configure then reports
#
#     checking for libbrotlienc >= 1.0.0... yes
#
# while the header it implies is absent, and the build dies in compress.c:
#
#     lib/dlwrap/brotlienc.h:11:10: fatal error: 'brotli/encode.h' file not found
#
# --without-brotli on its own is not enough, and the reason is a bug in
# gnutls's own conditional. configure.ac:1161 is
#
#     AM_CONDITIONAL(HAVE_LIBBROTLI, test "$with_libbrotlienc" != "no" &&
#                                    test "$with_libbrotlidec" != "no")
#
# but with_libbrotlienc and with_libbrotlidec are assigned only INSIDE
# configure.ac:1129's `if test x$ac_brotli != xno` -- every branch of the
# pkg-config probe sets one of them, and none of it runs when --without-brotli
# has set ac_brotli=no. The two variables are therefore still unset when the
# conditional is evaluated, `"" != "no"` is true, and HAVE_LIBBROTLI_TRUE comes
# out set: lib/Makefile.am:115's `if HAVE_LIBBROTLI` appends
# dlwrap/brotlienc.c and dlwrap/brotlidec.c to COBJECTS regardless, and the
# build dies on the header the flag was supposed to avoid.
#
# Setting the two variables as configure arguments is the same shape of answer
# as linux-pam's pam_cv_ld_no_undefined and WITH_NIS: an interface configure
# documents (its `*=*` option case exports VAR=value), so no patch is needed.
# They survive precisely because the block that would overwrite them is the one
# --without-brotli skips, so the conditional reads no/no and stays false.
#
# --disable-cxx: gnutls ships a C++ binding, lib/Makefile.am:317's
# `if ENABLE_CXX` builds libgnutlsxx.la, and configure.ac:45's unconditional
# AC_PROG_CXX finds the host's g++ because no CXX is passed. Nothing here wants
# that library -- no recipe in this tree links it -- and it cannot be built
# anyway. Its link carries -no-undefined (lib/Makefile.am:328), which becomes
# -Wl,--no-undefined, and the tree keeps CFI with cfi.trap false, so
# gnutlsxx.o calls into libclang_rt.cfi_diag.a's __cfi_slowpath_diag; that
# archive is meant to arrive on the EXECUTABLE, not the library (the same
# design cryptsetup's patch header states), so every symbol the binding is
# required to define is undefined by construction and mold refuses the link.
# The g++ in the same command is the visible half of the same mistake: it is
# handed clang response files it cannot parse (`unrecognized command-line
# option '--target=x86_64-linux-musl'`, `'-resource-dir=...'`), because the
# build host is clang-only.
#
# --disable-cxx is the supported switch for this (configure.ac:141,
# `--disable-cxx` sets use_cxx=no unconditionally), so it is taken as a native
# configure argument rather than a CXX=@CXX@ (C2: no `env`, and clang++ would
# find no C++ runtime in this musl sysroot either). use_cxx=no short-circuits
# configure.ac:145's probe AND leaves ENABLE_CXX false, so libgnutlsxx.la is
# never named in lib_LTLIBRARIES and the broken link never runs. This is the
# same call the zstd recipe documents against dropping stdlibxx: compiling C++
# is not viable in this tree, and the answer is not to weaken CFI to make it
# compile.
#
# With brotli off, HAVE_LIBBROTLI stays undefined and compress.c falls back to
# zlib and zstd, which the sysroot really does carry (both are recipes in this
# layer). Brotli is only certificate compression (RFC 8879); when it is wanted
# the fix is a real brotli in this layer, not these flags.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/gnutls /build/src/gnutls/configure --host=@ARCH_TRIPLE@ --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP_GNUTLS@ LDFLAGS=@LDFLAGS_RSP_GNUTLS@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig --disable-static --without-p11-kit --disable-doc --disable-tests --without-brotli --disable-cxx with_libbrotlienc=no with_libbrotlidec=no

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/gnutls -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/gnutls install DESTDIR=/dest
  - make -C /build/b/gnutls install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

# A bare `test -e` is what let this package sit in the hidden-visibility class
# unnoticed: an empty libgnutls.so is still a file. The symbols below are the
# handshake, the certificate path and the version call -- the three things
# every consumer of this library reaches for first -- plus __cfi_check, which
# is present only if the CFI schemes survived the exemption.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libgnutls.so
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libgnutls.so gnutls_init gnutls_handshake gnutls_certificate_allocate_credentials gnutls_x509_crt_import gnutls_check_version gnutls_deinit __cfi_check
