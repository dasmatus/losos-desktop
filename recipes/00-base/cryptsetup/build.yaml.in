# cryptsetup 2.7.5
#
# LUKS2, dm-verity and dm-integrity. systemd-cryptsetup, -cryptenroll, -veritysetup, -integritysetup and -repart are all built against it.
name: cryptsetup
version:
- '2'
- '7'
- '5'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_CRYPTSETUP@: '@SHA256_CRYPTSETUP@'
  run:
  - mkdir -p /build/src/cryptsetup /build/b/cryptsetup
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_CRYPTSETUP@ --no-same-owner -C /build/src/cryptsetup --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
#
# @CFLAGS_RSP_CRYPTSETUP@ and not @CFLAGS_RSP@: an exception in
# manifest/toolchain.yaml only reaches a package that names it, and left
# spelling the shared file the entry would be inert with nothing to say so.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/cryptsetup /build/src/cryptsetup/configure --host=@ARCH_TRIPLE@ --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP_CRYPTSETUP@ LDFLAGS=@LDFLAGS_RSP_CRYPTSETUP@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig --disable-static --disable-ssh-token --disable-asciidoc

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/cryptsetup -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/cryptsetup install DESTDIR=/dest
  - make -C /build/b/cryptsetup install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

# The symbols are taken from lib/libcryptsetup.sym, which is the version
# script that cannot rescue this package rather than evidence that it does not
# need rescuing. They are chosen rather than sampled, because systemd reaches
# this library only by dlopen -- 51 symbols resolved by name at
# src/shared/cryptsetup-util.c:286 -- so nothing in this tree would fail to
# link if they were missing, and the first report would be a machine that does
# not boot.
#
# Two unlock paths, and a regression can take one without the other:
# crypt_load and crypt_activate_by_passphrase are the passphrase path,
# crypt_token_json_get and crypt_activate_by_token_pin the FIDO2 one, where
# systemd-cryptenroll writes the credential into the LUKS2 header as a token
# and systemd-cryptsetup reads it back. Naming only the first pair would pass
# on a library that had lost hardware unlock entirely, so do not trim this
# line back to four "representative" symbols.
#
# The versioned name is checked as well as the linker name. systemd opens
# libcryptsetup.so.12 and nothing else here asserts the soname the consumer
# actually asks for, so a soname bump upstream would be invisible until boot
# for the same reason everything else on this package is.
- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libcryptsetup.so
  - test -e /dest/usr/lib/libcryptsetup.so.12
  - /bin/sh @RECIPE@/check-exports.sh @NM@ /dest/usr/lib/libcryptsetup.so crypt_load crypt_activate_by_passphrase crypt_token_json_get crypt_activate_by_token_pin crypt_init crypt_free __cfi_check
