# elfutils 0.191
#
# libdw: systemd-coredump uses it to write a backtrace into the journal.
name: elfutils
version:
- '0'
- '191'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_ELFUTILS@: '@SHA256_ELFUTILS@'
  run:
  - mkdir -p /build/src/elfutils /build/b/elfutils
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_ELFUTILS@ --no-same-owner -C /build/src/elfutils --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the sysroot is reached without `env`.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/elfutils /build/src/elfutils/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig CPPFLAGS=-I/build/sysroot/usr/include LDFLAGS=-L/build/sysroot/usr/lib --disable-static --disable-debuginfod --disable-libdebuginfod --enable-libdebuginfod=dummy

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/elfutils -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/elfutils install DESTDIR=/dest
  - make -C /build/b/elfutils install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libdw.so
