# util-linux 2.40.2
#
# libmount, libblkid, libuuid and libfdisk. systemd's mount handling, gpt-auto-generator and repart all rest on these; the programs are off because systemd supplies its own.
name: util-linux
version:
- '2'
- '40'
- '2'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_UTIL_LINUX@: '@SHA256_UTIL_LINUX@'
  run:
  - mkdir -p /build/src/util-linux /build/b/util-linux
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_UTIL_LINUX@ --no-same-owner -C /build/src/util-linux --strip-components=1

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the sysroot is reached without `env`.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/util-linux /build/src/util-linux/configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig CPPFLAGS=-I/build/sysroot/usr/include LDFLAGS=-L/build/sysroot/usr/lib --disable-static --disable-all-programs --enable-libmount --enable-libblkid --enable-libuuid --enable-libfdisk

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/util-linux -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/util-linux install DESTDIR=/dest
  - make -C /build/b/util-linux install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libmount.so
