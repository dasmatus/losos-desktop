# util-linux 2.40.2
#
# libmount, libblkid, libuuid and libfdisk underpin systemd's disk handling.
# Only the swap tools are enabled: repart invokes mkswap and generated .swap
# units invoke swapon/swapoff. libsmartcols is required by swapon.
name: util-linux
version:
- '2'
- '40'
- '2'
dependencies: []
steps:

- stage: Prepare
  name: fetch
  dl_urls:
    @URL_UTIL_LINUX@: '@SHA256_UTIL_LINUX@'
  run:
  - mkdir -p /build/src/util-linux /build/b/util-linux
  # --no-same-owner: pm's jail is a user namespace mapping only uid 0, so a
  # tarball recording any other uid fails tar at the very end.
  - tar -xf @DL_UTIL_LINUX@ --no-same-owner -C /build/src/util-linux --strip-components=1

# Unlike swapon, this version has no --enable-mkswap switch: disabling all
# programs unconditionally disables mkswap too. Patch the shipped configure
# rather than adding an autotools bootstrap to the host requirements.
- stage: Build
  name: patch
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/apply-patches.sh @RECIPE@/files/util-linux/patches /build/src/util-linux

# ./configure has no -C and there is no `cd` in a build step (C1), so the one
# permitted wrapper puts it in the build directory. configure takes VAR=value
# as positional arguments, which is how the toolchain and the sysroot are
# reached without `env`.
#
# CFLAGS and LDFLAGS are clang @response-files, not flag lists: pm splits a
# command on whitespace, so a multi-word CFLAGS would arrive as a dozen
# separate arguments and configure would reject the first it did not know.
# The response file is one word, and clang expands it. Its contents come from
# manifest/toolchain.yaml -- LTO and CFI included.
- stage: Build
  name: configure
  dl_urls: null
  run:
  - /bin/sh @RECIPE@/in-dir.sh /build/b/util-linux /build/src/util-linux/configure --host=@ARCH_TRIPLE@ --prefix=/usr --sbindir=/usr/sbin --libdir=/usr/lib --sysconfdir=/etc --localstatedir=/var CC=@CC@ AR=@AR@ NM=@NM@ RANLIB=@RANLIB@ CFLAGS=@CFLAGS_RSP@ LDFLAGS=@LDFLAGS_RSP@ PKG_CONFIG_PATH=/build/sysroot/usr/lib/pkgconfig:/build/sysroot/usr/share/pkgconfig --disable-static --disable-all-programs --enable-libmount --enable-libblkid --enable-libuuid --enable-libfdisk --enable-libsmartcols --enable-swapon

- stage: Build
  name: compile
  dl_urls: null
  run:
  - make -C /build/b/util-linux -j @JOBS@

# DESTDIR as a make argument, not the environment variable: pm already sets
# DESTDIR=/dest, and the second install has to override it.
- stage: Build
  name: install
  dl_urls: null
  run:
  - make -C /build/b/util-linux install DESTDIR=/dest
  - make -C /build/b/util-linux install DESTDIR=/build/sysroot
  - /bin/sh @RECIPE@/stage-sysroot.sh /build/sysroot

- stage: Test
  name: staged
  dl_urls: null
  run:
  - test -e /dest/usr/lib/libmount.so
  - test -x /dest/usr/sbin/mkswap
  - test -x /dest/usr/sbin/swapon
  - test -x /dest/usr/sbin/swapoff
