# meson native file. Generated per layer by tools/configure, and passed
# alongside cross.ini by every meson recipe in this tree.
#
# It describes the BUILD machine: the compiler meson uses for anything that has
# to run during the build rather than in the image. A cross build needs one --
# meson detects a build-machine compiler for every language in project(), and
# with nothing named here it looks for `cc` on the jail's fixed PATH and stops
# the configure on a container that ships clang and no gcc.
#
# The one thing this file must NOT carry is manifest/toolchain.yaml's flags.
# Those target musl (see cross.ini) and a build-machine program compiled with
# them is exactly the binary the jail cannot execute, so putting them here
# would move the failure rather than fix it. [built-in options] is absent for
# that reason, not by oversight.
#
# The helper programs are repeated from cross.ini because meson resolves
# find_program(..., native: true) out of this file and nowhere else, and a
# build-time generator asking for itself that way is the common case.
[binaries]
c          = '@CC@'
cpp        = '@CXX@'
ar         = '@AR@'
nm         = '@NM@'
ranlib     = '@RANLIB@'
strip      = '@STRIP@'
objcopy    = '@OBJCOPY@'
pkg-config = '@PKGCONFIG@'
python3    = '@PYTHON@'
gperf      = '@SYSROOT@/usr/bin/gperf'
msgfmt     = '@SYSROOT@/usr/bin/msgfmt'
msgmerge   = '@SYSROOT@/usr/bin/msgmerge'
xgettext   = '@SYSROOT@/usr/bin/xgettext'
flex       = '@SYSROOT@/usr/bin/flex'
bpftool    = '@SYSROOT@/usr/bin/bpftool'
wayland-scanner = '@SYSROOT@/usr/bin/wayland-scanner'
glib-compile-resources = '@SYSROOT@/usr/bin/glib-compile-resources'
g-ir-scanner = '@SYSROOT@/usr/bin/g-ir-scanner'
