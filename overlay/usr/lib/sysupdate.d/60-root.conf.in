# A/B updates of the root filesystem.
#
# The second root partition is created empty by systemd-repart and filled by
# sysupdate; the booted one is never written. Paired with dm-verity this is
# what makes /usr immutable in a way that survives an update rather than being
# reset by one.
#
# MatchPartitionType must agree with overlay/usr/lib/repart.d/20-root.conf --
# both come from manifest/architectures.yaml so they cannot drift.
#
# Verification is left at its default (on): sysupdate fetches SHA256SUMS.gpg
# beside SHA256SUMS and checks it with gpgv against
# /usr/lib/systemd/import-pubring.pgp, the release key CI signs with
# (tools/sign-release). The image needs gpgv for that; see docs/images.md,
# "Signed updates".
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=@UPDATE_URL@
MatchPattern=losos-desktop_@v_@ARCH_SYSUPDATE_ROOT@.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=losos-desktop_@v
MatchPartitionType=@ARCH_GPT_ROOT@
InstancesMax=2
