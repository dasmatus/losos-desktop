From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 13:53:20 +0000
Subject: [PATCH] QIconLoader: Keep the system icon theme whatever the
 application sets

The Qt 6 patch of the same name, for Qt 5.15: QIcon::setThemeName()
cannot replace a theme the system names and becomes the fallback instead,
and the system's directories lead the theme search path.

Pixmap icons found in several directories of the search path now keep
the search path's order, as scalable ones already did: findIconHelper()
prepended each PNG, so the last directory won, which put the system's
directories behind the application's and, upstream, the user's ~/.icons
behind the system's.
---
 src/gui/image/qiconloader.cpp | 33 +++++++++++++++++++++++++++++++--
 1 file changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/gui/image/qiconloader.cpp b/src/gui/image/qiconloader.cpp
index ac7a6864..26ef4fc2 100644
--- a/src/gui/image/qiconloader.cpp
+++ b/src/gui/image/qiconloader.cpp
@@ -161,6 +161,21 @@ void QIconLoader::updateSystemTheme()
 
 void QIconLoader::setThemeName(const QString &themeName)
 {
+    // The icon theme is the desktop's choice, not the application's: while
+    // the system names one, an application asking for another (KDE apps ask
+    // for Breeze off Plasma) keeps the system's. Its theme still fills in
+    // icons the system's lacks, as the fallback, unless it chose one itself.
+    // Clearing the name with an empty string works as before.
+    if (!themeName.isEmpty()) {
+        const QString system = systemThemeName();
+        if (!system.isEmpty()) {
+            if (m_userFallbackTheme.isEmpty() && themeName != system) {
+                m_userFallbackTheme = themeName;
+                invalidateKey();
+            }
+            return;
+        }
+    }
     m_userTheme = themeName;
     invalidateKey();
 }
@@ -189,7 +204,16 @@ QStringList QIconLoader::themeSearchPaths() const
         // Always add resource directory as search path
         m_iconDirs.append(QLatin1String(":/icons"));
     }
-    return m_iconDirs;
+    // The system's directories come first, in their own order, whatever the
+    // application set: otherwise it could shadow the system theme with a
+    // directory of the same name, or drop the system's directories and with
+    // them the theme. The application's own directories follow.
+    QStringList dirs = systemIconSearchPaths();
+    for (const QString &dir : qAsConst(m_iconDirs)) {
+        if (!dirs.contains(dir))
+            dirs.append(dir);
+    }
+    return dirs;
 }
 
 void QIconLoader::setFallbackSearchPaths(const QStringList &searchPaths)
@@ -451,6 +475,11 @@ QThemeIconInfo QIconLoader::findIconHelper(const QString &themeName,
         const QString pngIconName = iconNameFallback + QLatin1String(".png");
 
         // Add all relevant files
+        // Pixmaps go ahead of scalable icons, in the order of the content
+        // directories: the first directory on the search path wins, as the
+        // icon theme specification has it and the system-first search path
+        // relies on. Prepending each one would let the last directory win.
+        int pixmaps = 0;
         for (int i = 0; i < contentDirs.size(); ++i) {
             QVector<QIconDirInfo> subDirs = theme.keyList();
 
@@ -486,7 +515,7 @@ QThemeIconInfo QIconLoader::findIconHelper(const QString &themeName,
                     iconEntry->filename = pngPath;
                     // Notice we ensure that pixmap entries always come before
                     // scalable to preserve search order afterwards
-                    info.entries.prepend(iconEntry);
+                    info.entries.insert(pixmaps++, iconEntry);
                 } else if (m_supportsSvg) {
                     const QString svgPath = subDir + svgIconName;
                     if (QFile::exists(svgPath)) {
