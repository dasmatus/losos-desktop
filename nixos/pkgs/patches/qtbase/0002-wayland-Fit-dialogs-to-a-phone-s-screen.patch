From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 09:07:11 +0000
Subject: [PATCH] wayland: Fit dialogs to a phone's screen

On screens under 600 logical pixels on their short side, open resizable
dialogs and transient windows maximized, as GTK does with Purism's
adaptive patches, and cap the minimum size sent to the compositor at the
screen's, so no window asks to be larger than the phone it is on.
---
 .../xdg-shell/qwaylandxdgshell.cpp            | 51 +++++++++++++++++--
 1 file changed, 48 insertions(+), 3 deletions(-)

diff --git a/src/plugins/platforms/wayland/plugins/shellintegration/xdg-shell/qwaylandxdgshell.cpp b/src/plugins/platforms/wayland/plugins/shellintegration/xdg-shell/qwaylandxdgshell.cpp
index cba8b0b1..9da74e28 100644
--- a/src/plugins/platforms/wayland/plugins/shellintegration/xdg-shell/qwaylandxdgshell.cpp
+++ b/src/plugins/platforms/wayland/plugins/shellintegration/xdg-shell/qwaylandxdgshell.cpp
@@ -19,6 +19,9 @@
 #include <QtWaylandClient/private/qwaylandabstractdecoration_p.h>
 
 #include <QtGui/QGuiApplication>
+#include <QtGui/QScreen>
+
+#include <algorithm>
 #include <QtGui/private/qwindow_p.h>
 
 QT_BEGIN_NAMESPACE
@@ -35,6 +38,35 @@ struct WithDestructor : public T
     }
 };
 
+// The screens are a phone's when every one is narrower than 600 logical
+// pixels on its short side, the line the derisk shell draws between its phone
+// and tablet layouts. A phone docked to a larger monitor is then a desktop
+// again. A screen without geometry yet, such as the placeholder before any
+// output is announced, counts as large.
+static bool onPhoneSizedScreens()
+{
+    const auto screens = QGuiApplication::screens();
+    if (screens.isEmpty())
+        return false;
+    return std::all_of(screens.cbegin(), screens.cend(), [](const QScreen *screen) {
+        const QSize size = screen->geometry().size();
+        return !size.isEmpty() && qMin(size.width(), size.height()) < 600;
+    });
+}
+
+// On a phone a dialog that can be resized opens maximized, as GTK's does
+// with Purism's adaptive patches: a desktop-sized dialog floating over a
+// 360-pixel screen runs off its edges, and one filling the screen is what a
+// phone's own dialogs look like. A fixed-size dialog, such as a message box,
+// is left to the compositor to place.
+static bool opensMaximizedOnPhone(QWaylandWindow *waylandWindow)
+{
+    QWindow *window = waylandWindow->window();
+    const bool dialog = window->type() == Qt::Dialog || waylandWindow->transientParent();
+    const bool resizable = window->minimumSize() != window->maximumSize();
+    return dialog && resizable && onPhoneSizedScreens();
+}
+
 QWaylandXdgSurface::Toplevel::Toplevel(QWaylandXdgSurface *xdgSurface)
     : QtWayland::xdg_toplevel(xdgSurface->get_toplevel())
     , m_xdgSurface(xdgSurface)
@@ -44,7 +76,10 @@ QWaylandXdgSurface::Toplevel::Toplevel(QWaylandXdgSurface *xdgSurface)
         if (!(window->flags() & Qt::FramelessWindowHint))
             m_decoration = decorationManager->createToplevelDecoration(object());
     }
-    requestWindowStates(window->windowStates());
+    Qt::WindowStates states = window->windowStates();
+    if (opensMaximizedOnPhone(xdgSurface->window()))
+        states |= Qt::WindowMaximized;
+    requestWindowStates(states);
     requestWindowFlags(window->flags());
     if (auto transientParent = xdgSurface->window()->transientParent()) {
         auto parentSurface = qobject_cast<QWaylandXdgSurface *>(transientParent->shellSurface());
@@ -480,8 +515,18 @@ void QWaylandXdgSurface::setSizeHints()
         const QMargins margins = m_window->windowContentMargins() - m_window->clientSideMargins();
         const QSize minSize = m_window->windowMinimumSize().shrunkBy(margins);
         const QSize maxSize = m_window->windowMaximumSize().shrunkBy(margins);
-        const int minWidth = qMax(0, minSize.width());
-        const int minHeight = qMax(0, minSize.height());
+        int minWidth = qMax(0, minSize.width());
+        int minHeight = qMax(0, minSize.height());
+
+        // A minimum size larger than a phone's screen asks for a window the
+        // compositor cannot fit on it. Cap the minimum at the screen, so the
+        // window is at least placed whole and its contents can scroll or be
+        // clipped rather than running off the display.
+        const QScreen *screen = m_window->window()->screen();
+        if (screen && onPhoneSizedScreens()) {
+            minWidth = qMin(minWidth, screen->availableSize().width());
+            minHeight = qMin(minHeight, screen->availableSize().height());
+        }
         int maxWidth = qMax(0, maxSize.width());
         int maxHeight = qMax(0, maxSize.height());
 
