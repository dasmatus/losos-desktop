From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 09:06:51 +0000
Subject: [PATCH] QAbstractScrollArea: Scroll with a finger on touchscreens

A touch on a scroll area reaches a desktop Qt Widgets application as a
synthesized mouse drag, which selects text or rubber-bands items instead
of scrolling, so lists and pages cannot be scrolled with a finger on a
phone. QAbstractScrollArea already handles QScroller's events; grab a
touch-only QScroller on the viewport when a touchscreen is present.
QT_TOUCH_SCROLLER=0 opts an application out.
---
 src/widgets/widgets/qabstractscrollarea.cpp | 35 +++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/src/widgets/widgets/qabstractscrollarea.cpp b/src/widgets/widgets/qabstractscrollarea.cpp
index 5c13132f..be28deda 100644
--- a/src/widgets/widgets/qabstractscrollarea.cpp
+++ b/src/widgets/widgets/qabstractscrollarea.cpp
@@ -30,6 +30,13 @@
 
 #include <private/qapplication_p.h>
 
+#if QT_CONFIG(scroller)
+#include "qscroller.h"
+#include <QtGui/qinputdevice.h>
+
+#include <algorithm>
+#endif
+
 #ifdef Q_OS_WIN
 #  include <qt_windows.h>
 #endif
@@ -248,6 +255,28 @@ void QAbstractScrollAreaPrivate::replaceScrollBar(QScrollBar *scrollBar,
                      q, SLOT(_q_showOrHideScrollBars()), Qt::QueuedConnection);
 }
 
+
+#if QT_CONFIG(scroller)
+// A finger on a touchscreen scrolls a scroll area, kinetically, the way it
+// does on every phone, instead of arriving as a synthesized mouse drag that
+// selects text or rubber-bands items. QAbstractScrollArea already answers
+// QScroller's ScrollPrepare and Scroll events; only the grab was left to each
+// application, and few desktop applications make it. Only touch is grabbed,
+// so a mouse still selects. QT_TOUCH_SCROLLER=0 turns it off for an
+// application that draws with a finger, such as a canvas in a QGraphicsView.
+static void grabTouchScroller(QWidget *viewport)
+{
+    if (qEnvironmentVariable("QT_TOUCH_SCROLLER") == "0"_L1)
+        return;
+    const auto devices = QInputDevice::devices();
+    const bool touchscreen = std::any_of(devices.cbegin(), devices.cend(), [](const QInputDevice *device) {
+        return device->type() == QInputDevice::DeviceType::TouchScreen;
+    });
+    if (touchscreen)
+        QScroller::grabGesture(viewport, QScroller::TouchGesture);
+}
+#endif
+
 void QAbstractScrollAreaPrivate::init()
 {
     Q_Q(QAbstractScrollArea);
@@ -283,6 +312,9 @@ void QAbstractScrollAreaPrivate::init()
     viewport->grabGesture(Qt::PanGesture);
 #  endif
 #endif
+#if QT_CONFIG(scroller)
+    grabTouchScroller(viewport);
+#endif
 }
 
 void QAbstractScrollAreaPrivate::layoutChildren()
@@ -505,6 +537,9 @@ void QAbstractScrollArea::setViewport(QWidget *widget)
         d->viewport->installEventFilter(d->viewportFilter.data());
 #ifndef QT_NO_GESTURES
         d->viewport->grabGesture(Qt::PanGesture);
+#endif
+#if QT_CONFIG(scroller)
+        grabTouchScroller(d->viewport);
 #endif
         d->layoutChildren();
 #ifndef QT_NO_OPENGL
-- 
