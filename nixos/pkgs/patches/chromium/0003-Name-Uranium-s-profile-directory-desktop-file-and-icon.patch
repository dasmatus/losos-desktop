From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 12:30:00 +0000
Subject: [PATCH] Name Uranium's profile directory, desktop file and icon

~/.config/uranium instead of ~/.config/chromium, uranium.desktop as the
desktop file and so the Wayland app id, and the uranium icon.
---
 chrome/browser/shell_integration_linux.cc | 3 ++-
 chrome/common/channel_info_posix.cc       | 4 +++-
 chrome/common/chrome_paths_linux.cc       | 4 +++-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/shell_integration_linux.cc b/chrome/browser/shell_integration_linux.cc
index 2c071e6..b359a7c 100644
--- a/chrome/browser/shell_integration_linux.cc
+++ b/chrome/browser/shell_integration_linux.cc
@@ -471,7 +471,8 @@ std::string GetIconName() {
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING)
   return "google-chrome";
 #else  // BUILDFLAG(CHROMIUM_BRANDING)
-  return "chromium-browser";
+  // The icon Uranium's package installs under hicolor.
+  return "uranium";
 #endif
 }
 
diff --git a/chrome/common/channel_info_posix.cc b/chrome/common/channel_info_posix.cc
index f6bcb3c..4f8d0ac 100644
--- a/chrome/common/channel_info_posix.cc
+++ b/chrome/common/channel_info_posix.cc
@@ -148,7 +148,9 @@ std::string GetDesktopName(base::Environment* env) {
   if (name.has_value() && !name.value().empty()) {
     return name.value();
   }
-  return "chromium-browser.desktop";
+  // Uranium's desktop file. Its base name is the Wayland app id, which is
+  // how the desktop matches a window to the launcher entry and its icon.
+  return "uranium.desktop";
 #endif
 }
 #endif  // BUILDFLAG(IS_LINUX)
diff --git a/chrome/common/chrome_paths_linux.cc b/chrome/common/chrome_paths_linux.cc
index 5575c04..60486d8 100644
--- a/chrome/common/chrome_paths_linux.cc
+++ b/chrome/common/chrome_paths_linux.cc
@@ -95,7 +95,9 @@ bool GetDefaultUserDataDirectory(base::FilePath* result) {
 #elif BUILDFLAG(GOOGLE_CHROME_BRANDING)
   std::string data_dir_basename = "google-chrome";
 #else
-  std::string data_dir_basename = "chromium";
+  // Uranium keeps its profile in ~/.config/uranium, apart from any stock
+  // Chromium's.
+  std::string data_dir_basename = "uranium";
 #endif
   *result = config_dir.Append(data_dir_basename + GetChannelSuffixForDataDir());
   return true;
