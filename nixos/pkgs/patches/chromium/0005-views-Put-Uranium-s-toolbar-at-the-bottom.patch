From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 15:00:00 +0000
Subject: [PATCH] views: Put Uranium's toolbar at the bottom

On a phone (--uranium-phone-ui) the toolbar, with the address bar, sits
at the bottom of the window, where a thumb reaches it, as Chrome for
Android lets it. Settings, Appearance, "Show the address bar at the
bottom" puts it there on every screen; the window lays itself out again
as soon as that changes.

The tabbed layout lays the top container out as usual and then moves it:
it takes the bottom of the client area, and whatever was laid out below
it moves up by its height. The tab strip, where there is one, stays at
the top. The setting's label is English only.
---
 .../extensions/api/settings_private/prefs_util.cc  |    2 +
 .../appearance_page/appearance_page.html.ts        |    7 +++
 chrome/browser/ui/browser_ui_prefs.cc              |    5 ++
 chrome/browser/ui/views/frame/browser_view.cc      |    5 ++
 .../layout/browser_view_tabbed_layout_impl.cc      |   44 ++++++++++++++++++++
 5 files changed, 63 insertions(+)

diff --git a/chrome/browser/extensions/api/settings_private/prefs_util.cc b/chrome/browser/extensions/api/settings_private/prefs_util.cc
index 2363c9b..c924375 100644
--- a/chrome/browser/extensions/api/settings_private/prefs_util.cc
+++ b/chrome/browser/extensions/api/settings_private/prefs_util.cc
@@ -304,6 +304,8 @@ const PrefsUtil::TypedPrefMap& PrefsUtil::GetAllowlistedKeys() {
       settings_api::PrefType::kBoolean;
 #endif
   (*s_allowlist)[::prefs::kShowHomeButton] = settings_api::PrefType::kBoolean;
+  (*s_allowlist)["uranium.toolbar_at_bottom"] =
+      settings_api::PrefType::kBoolean;
   (*s_allowlist)[contextual_search::kDriveConsentState] =
       settings_api::PrefType::kNumber;
   (*s_allowlist)[::prefs::kShowForwardButton] =
diff --git a/chrome/browser/resources/settings/appearance_page/appearance_page.html.ts b/chrome/browser/resources/settings/appearance_page/appearance_page.html.ts
index eba0ba1..7f00b59 100644
--- a/chrome/browser/resources/settings/appearance_page/appearance_page.html.ts
+++ b/chrome/browser/resources/settings/appearance_page/appearance_page.html.ts
@@ -118,6 +118,13 @@ export function getHtml(this: SettingsAppearancePageElement) {
         </settings-radio-group>
       </div>
     ` : ''}
+    <!-- Uranium: on a phone the toolbar is at the bottom regardless; this
+         puts it there on every screen. -->
+    <settings-toggle-button id="uraniumToolbarAtBottom"
+        pref-key="uranium.toolbar_at_bottom"
+        label="Show the address bar at the bottom"
+        sub-label="Always, not only on a phone">
+    </settings-toggle-button>
     <div
         class="hr"
         ?hidden="${!this.showHr_(
diff --git a/chrome/browser/ui/browser_ui_prefs.cc b/chrome/browser/ui/browser_ui_prefs.cc
index 6997bb3..d4536c3 100644
--- a/chrome/browser/ui/browser_ui_prefs.cc
+++ b/chrome/browser/ui/browser_ui_prefs.cc
@@ -126,6 +126,11 @@ void RegisterBrowserUserPrefs(user_prefs::PrefRegistrySyncable* registry) {
                                 pref_registration_flags);
   registry->RegisterBooleanPref(prefs::kShowHomeButton, false,
                                 pref_registration_flags);
+  // Uranium: the toolbar at the bottom of the window on every screen, as it
+  // is anyway on a phone (BrowserViewTabbedLayoutImpl). Settings, Appearance,
+  // "Show the address bar at the bottom".
+  registry->RegisterBooleanPref("uranium.toolbar_at_bottom", false,
+                                pref_registration_flags);
   registry->RegisterBooleanPref(prefs::kSplitViewDragAndDropEnabled, true,
                                 pref_registration_flags);
 
diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index 116edb6..79f9b97 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -1048,6 +1048,11 @@ BrowserView::BrowserView(BrowserWindowInterface* browser)
       base::BindRepeating(&BrowserView::UpdateFullscreenAllowedFromPolicy,
                           base::Unretained(this), CanFullscreen()));
   UpdateFullscreenAllowedFromPolicy(CanFullscreen());
+  // Uranium: the toolbar moves as soon as its setting changes.
+  registrar_.Add("uranium.toolbar_at_bottom",
+                 base::BindRepeating(
+                     [](BrowserView* view) { view->InvalidateLayout(); },
+                     base::Unretained(this)));
 
   WebUIContentsPreloadManager::GetInstance()->WarmupForBrowser(browser_.get());
 
diff --git a/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc b/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
index 0e295be..18ab503 100644
--- a/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
+++ b/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
@@ -9,6 +9,7 @@
 #include <optional>
 #include <utility>
 
+#include "base/command_line.h"
 #include "base/functional/bind.h"
 #include "base/i18n/rtl.h"
 #include "base/numerics/safe_conversions.h"
@@ -17,6 +18,7 @@
 #include "build/build_config.h"
 #include "chrome/browser/ui/animation/browser_animation_controller.h"
 #include "chrome/browser/ui/animation/browser_animation_types.h"
+#include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/color/chrome_color_id.h"
 #include "chrome/browser/ui/immersive/immersive_mode_controller.h"
@@ -25,6 +27,7 @@
 #include "chrome/browser/ui/views/animations/side_panel_animations.h"
 #include "chrome/browser/ui/views/animations/tab_strip_animations.h"
 #include "chrome/browser/ui/views/bookmarks/bookmark_bar_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
 #include "chrome/browser/ui/views/frame/custom_corners.h"
 #include "chrome/browser/ui/views/frame/custom_corners_background.h"
 #include "chrome/browser/ui/views/frame/custom_floating_corner.h"
@@ -42,6 +45,7 @@
 #include "chrome/browser/ui/views/tabs/organizer/layout_constants.h"
 #include "chrome/browser/ui/views/tabs/organizer/organizer_panel_utils.h"
 #include "chrome/browser/ui/views/tabs/organizer/organizer_panel_view.h"
+#include "components/prefs/pref_service.h"
 #include "ui/base/ui_base_features.h"
 #include "ui/compositor/layer.h"
 #include "ui/gfx/geometry/insets.h"
@@ -205,6 +209,25 @@ struct BrowserViewTabbedLayoutImpl::TransientLayoutData {
   SidePanelContentAnimation side_panel_content_animation;
 };
 
+namespace {
+
+// Uranium keeps its toolbar at the bottom of the window, where a thumb
+// reaches it, on a phone (--uranium-phone-ui, which its launcher passes when
+// every screen is phone-sized), and on every screen when the user turns on
+// Settings, Appearance, "Show the address bar at the bottom".
+bool IsUraniumToolbarAtBottom(views::View* browser_view) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("uranium-phone-ui")) {
+    return true;
+  }
+  // The layout also runs in tests with a plain view standing in.
+  auto* const view = views::AsViewClass<BrowserView>(browser_view);
+  return view && view->GetProfile() &&
+         view->GetProfile()->GetPrefs()->GetBoolean(
+             "uranium.toolbar_at_bottom");
+}
+
+}  // namespace
+
 BrowserViewTabbedLayoutImpl::BrowserViewTabbedLayoutImpl(
     std::unique_ptr<BrowserViewLayoutDelegate> delegate,
     BrowserViewLayoutViews views)
@@ -1326,6 +1349,27 @@ BrowserViewTabbedLayoutImpl::CalculateProposedLayout(
                     is_scrim_visible);
   }
 
+  // Uranium: the top container (toolbar, and bookmarks bar if shown) moves
+  // to the bottom of the window. Everything laid out below it moves up by
+  // its height, so the page fills the space it left, and it takes the
+  // bottom of the client area. The tab strip, where there is one, stays at
+  // the top.
+  if (IsUraniumToolbarAtBottom(views().browser_view)) {
+    auto top = layout.children.find(views().top_container);
+    if (top != layout.children.end() && !top->second.bounds.IsEmpty()) {
+      const gfx::Rect top_bounds = top->second.bounds;
+      for (auto& [child, child_layout] : layout.children) {
+        if (child != views().top_container &&
+            !child_layout.bounds.IsEmpty() &&
+            child_layout.bounds.y() >= top_bounds.bottom()) {
+          child_layout.bounds.Offset(0, -top_bounds.height());
+        }
+      }
+      top->second.bounds.set_y(browser_params.visual_client_area.bottom() -
+                               top_bounds.height());
+    }
+  }
+
   return layout;
 }
 
