+/* Record that one of the two providers has answered, and decide what the page
+ * should show.
+ *
+ * Either provider answering is enough: a machine with fwupd and no OS check
+ * provider is the stock case, and a machine with the provider and no fwupd --
+ * a virtual machine, or any board fwupd has no plugin for -- still has a TPM,
+ * an encrypted volume and a lockdown mode worth reporting. Only when both have
+ * failed is there genuinely nothing to show.
+ */
+static void
+on_provider_replied (CcFirmwareSecurityPage *self,
+                     gboolean                ok)
+{
+  self->providers_done++;
+  if (ok)
+    self->providers_ok++;
+
+  /* Whichever verdict was pending is now out of date. */
+  if (self->timeout_id)
+    g_clear_handle_id (&self->timeout_id, g_source_remove);
+
+  if (self->providers_ok > 0)
+    self->timeout_id = g_timeout_add (1500, on_timeout_cb, self);
+  else if (self->providers_done == 2)
+    self->timeout_id = g_timeout_add (1500, on_timeout_unavaliable, self);
+}
