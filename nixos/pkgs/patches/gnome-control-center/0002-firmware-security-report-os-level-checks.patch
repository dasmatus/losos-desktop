+/* Add one expandable row per check, under a heading naming where the checks
+ * came from. Empty tables produce no group at all.
+ *
+ * Upstream's dialog is a one-line verdict plus a "Copy Technical Report"
+ * button, and the individual checks exist only inside the text that button
+ * copies. That is defensible while every check is about firmware the reader
+ * cannot change from here. It stops being defensible once the list includes an
+ * encryption setting, a lockdown mode and four sysctls -- things that can be
+ * fixed, by someone who is told which one failed.
+ */
+static void
+add_checks_group (CcFirmwareSecurityDialog *self,
+                  const gchar              *title,
+                  GHashTable               *dict)
+{
+  g_autoptr (GList) hash_keys = NULL;
+  GtkWidget *group;
+
+  if (dict == NULL || g_hash_table_size (dict) == 0)
+    return;
+
+  group = adw_preferences_group_new ();
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), title);
+
+  /* Sorted by appstream id: a hash table's order is arbitrary, and a report
+   * whose rows move between two viewings of the same machine is one nobody can
+   * compare against a previous reading. */
+  hash_keys = g_hash_table_get_keys (dict);
+  hash_keys = g_list_sort (hash_keys, (GCompareFunc) g_strcmp0);
+
+  for (GList *item = hash_keys; item != NULL; item = g_list_next (item))
+    {
+      FwupdSecurityAttr *attr = g_hash_table_lookup (dict, item->data);
+      const gchar *result_str;
+      GtkWidget *row;
+
+      /* An internal fwupd marker rather than a check with an outcome; every
+       * other view of this data filters it out too. */
+      if (g_strcmp0 (attr->appstream_id, FWUPD_SECURITY_ATTR_ID_SUPPORTED_CPU) == 0)
+        continue;
+      if (attr->title == NULL)
+        continue;
+
+      row = adw_expander_row_new ();
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), attr->title);
+
+      result_str = fwupd_security_attr_result_to_string (attr->result);
+      if (result_str != NULL)
+        adw_expander_row_set_subtitle (ADW_EXPANDER_ROW (row), result_str);
+
+      if (firmware_security_attr_has_flag (attr, FWUPD_SECURITY_ATTR_FLAG_SUCCESS))
+        {
+          adw_expander_row_set_icon_name (ADW_EXPANDER_ROW (row), "emblem-ok");
+          gtk_widget_add_css_class (row, "success-icon");
+        }
+      else
+        {
+          adw_expander_row_set_icon_name (ADW_EXPANDER_ROW (row), "process-stop");
+          gtk_widget_add_css_class (row, "error-icon");
+        }
+
+      if (attr->description != NULL)
+        {
+          GtkWidget *subrow = adw_action_row_new ();
+
+          adw_action_row_set_subtitle (ADW_ACTION_ROW (subrow), attr->description);
+          gtk_widget_add_css_class (subrow, "security-description-row");
+          adw_expander_row_add_row (ADW_EXPANDER_ROW (row), subrow);
+        }
+      else
+        {
+          /* Nothing to expand into, so do not offer the arrow. */
+          adw_expander_row_set_enable_expansion (ADW_EXPANDER_ROW (row), FALSE);
+          gtk_widget_add_css_class (row, "hide-arrow");
+        }
+
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), row);
+    }
+
+  gtk_box_append (GTK_BOX (self->checks_box), group);
+}
