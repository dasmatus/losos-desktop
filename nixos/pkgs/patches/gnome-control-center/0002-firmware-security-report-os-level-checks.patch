 static void
+on_losos_bus_done (GObject      *source,
+                   GAsyncResult *res,
+                   gpointer      user_data)
+{
+  CcFirmwareSecurityPage *self = CC_FIRMWARE_SECURITY_PAGE (user_data);
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) val = NULL;
+
+  val = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &error);
+  if (val == NULL)
+    {
+      on_provider_replied (self, FALSE);
+      return;
+    }
+
+  /* fwupd's parser, unchanged: the provider answers in the same a{sv} shape
+   * on purpose, so the only difference is where the attributes are filed. */
+  self->parse_into = self->losos_dict;
+  parse_array_from_variant (self, val, FALSE);
+  self->parse_into = NULL;
+
+  /* update_page_visibility() hides this page on a virtual machine, because a
+   * firmware security index means nothing there. Operating-system checks
+   * still do, so a provider that answered overrides that. */
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+
+  on_provider_replied (self, TRUE);
+}
+
+static void
+on_losos_bus_ready_cb (GObject      *source_object,
+                       GAsyncResult *res,
+                       gpointer      user_data)
+{
+  g_autoptr (GError) error = NULL;
+  CcFirmwareSecurityPage *self = CC_FIRMWARE_SECURITY_PAGE (user_data);
+
+  self->losos_proxy = g_dbus_proxy_new_for_bus_finish (res, &error);
+  if (self->losos_proxy == NULL)
+    {
+      /* Debug rather than warning: most systems do not ship this provider, and
+       * its absence is not a fault. */
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_debug ("no operating system security provider: %s", error->message);
+
+      on_provider_replied (self, FALSE);
+      return;
+    }
+
+  g_dbus_proxy_call (self->losos_proxy,
+                     "GetHostSecurityAttrs",
+                     NULL,
+                     G_DBUS_CALL_FLAGS_NONE,
+                     -1,
+                     self->cancellable,
+                     on_losos_bus_done,
+                     self);
+}
