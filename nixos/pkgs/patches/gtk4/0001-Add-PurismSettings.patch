diff --git a/gtk/org.gtk.gtk4.Settings.Purism.gschema.xml b/gtk/org.gtk.gtk4.Settings.Purism.gschema.xml
new file mode 100644
index 0000000..1e71b4f
--- /dev/null
+++ b/gtk/org.gtk.gtk4.Settings.Purism.gschema.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<schemalist>
+
+  <schema id='org.gtk.gtk4.Settings.Purism' path='/org/gtk/gtk4/settings/purism/'>
+    <key name='is-phone' type='b'>
+      <default>false</default>
+      <summary>Enable hacks for small screens</summary>
+      <description>
+        If this setting is true, GTK enables various tweaks to let it
+        work on small screens.
+
+        This is a temporary workaround until automatic adaptive UIs
+        are implemented based on the workarea size.
+      </description>
+    </key>
+  </schema>
+
+</schemalist>
diff --git a/gtk/purism-settings.c b/gtk/purism-settings.c
new file mode 100644
index 0000000..586bea1
--- /dev/null
+++ b/gtk/purism-settings.c
@@ -0,0 +1,311 @@
