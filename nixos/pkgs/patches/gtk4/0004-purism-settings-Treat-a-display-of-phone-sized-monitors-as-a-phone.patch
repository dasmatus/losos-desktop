From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 09:06:05 +0000
Subject: [PATCH] purism-settings: Treat a display of phone-sized monitors as a
 phone

Purism's adaptive patches switch on through the
org.gtk.gtk4.Settings.Purism is-phone key, which PureOS sets per device.
Turn the same switch on when every monitor is under 600 application
pixels on its short side, so a phone needs no per-device setting and a
docked phone gets desktop dialogs back. The key, or the portal setting
in a sandbox, still forces phone mode on.
---
 gtk/purism-settings.c | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/gtk/purism-settings.c b/gtk/purism-settings.c
index 586bea1..97605f1 100644
--- a/gtk/purism-settings.c
+++ b/gtk/purism-settings.c
@@ -302,10 +302,45 @@ purism_settings_get_default (void)
   return settings;
 }
 
+/* A display is a phone's when every monitor on it is narrower than 600
+ * application pixels on its short side, the line the derisk shell draws
+ * between its phone and tablet layouts. A phone docked to a larger monitor
+ * is then a desktop again. Monitors with no geometry yet count as large,
+ * so a display that has not announced its outputs is never a phone.
+ */
+static gboolean
+display_is_phone_sized (GdkDisplay *display)
+{
+  GListModel *monitors;
+  guint i, n;
+  gboolean small = TRUE;
+
+  if (!display)
+    return FALSE;
+
+  monitors = gdk_display_get_monitors (display);
+  n = g_list_model_get_n_items (monitors);
+  if (n == 0)
+    return FALSE;
+
+  for (i = 0; i < n && small; i++)
+    {
+      GdkMonitor *monitor = g_list_model_get_item (monitors, i);
+      GdkRectangle geometry;
+
+      gdk_monitor_get_geometry (monitor, &geometry);
+      small = geometry.width > 0 && geometry.height > 0 &&
+              MIN (geometry.width, geometry.height) < 600;
+      g_object_unref (monitor);
+    }
+
+  return small;
+}
+
 gboolean
 purism_settings_get_is_phone (PurismSettings *self)
 {
   g_return_val_if_fail (PURISM_IS_SETTINGS (self), FALSE);
 
-  return self->is_phone;
+  return self->is_phone || display_is_phone_sized (gdk_display_get_default ());
 }
