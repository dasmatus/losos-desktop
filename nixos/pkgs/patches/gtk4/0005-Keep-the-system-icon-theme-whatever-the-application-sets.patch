From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 13:53:19 +0000
Subject: [PATCH] Keep the system icon theme whatever the application sets

As in GTK 3: GtkSettings ignores gtk-icon-theme-name from the application
and from the GTK theme's settings.ini, and the display's GtkIconTheme keeps
the directories gtk_icon_theme_init() starts with at the front of its
search path, with whatever the application sets or adds after them. Icon
themes an application creates with gtk_icon_theme_new() stay untouched.
---
 gtk/gtkicontheme.c | 45 ++++++++++++++++++++++++++++++++++++++++++++-
 gtk/gtksettings.c  | 17 +++++++++++++++++
 2 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/gtk/gtkicontheme.c b/gtk/gtkicontheme.c
index ac13d6b..71e65b0 100644
--- a/gtk/gtkicontheme.c
+++ b/gtk/gtkicontheme.c
@@ -1355,6 +1355,49 @@ gtk_icon_theme_finalize (GObject *object)
   G_OBJECT_CLASS (gtk_icon_theme_parent_class)->finalize (object);
 }
 
+/* The screen's icon theme searches the system's directories first, in the
+ * order gtk_icon_theme_init() puts them, whatever an application did to its
+ * search path; the application's own directories follow. Otherwise an
+ * application could shadow the system theme with a directory of the same
+ * name, or drop the system's directories and with them the theme. Icon
+ * themes an application creates for itself are left alone. Returns a new
+ * NULL-terminated array.
+ */
+static char **
+system_search_path_first (GtkIconTheme       *self,
+                          const char * const *path)
+{
+  const char * const *xdg_data_dirs = g_get_system_data_dirs ();
+  GPtrArray *dirs;
+  int i, j;
+
+  if (!self->is_display_singleton)
+    return g_strdupv ((char **)path);
+
+  dirs = g_ptr_array_new ();
+  g_ptr_array_add (dirs, g_build_filename (g_get_user_data_dir (), "icons", NULL));
+  g_ptr_array_add (dirs, g_build_filename (g_get_home_dir (), ".icons", NULL));
+  for (j = 0; xdg_data_dirs[j]; j++)
+    g_ptr_array_add (dirs, g_build_filename (xdg_data_dirs[j], "icons", NULL));
+  for (j = 0; xdg_data_dirs[j]; j++)
+    g_ptr_array_add (dirs, g_build_filename (xdg_data_dirs[j], "pixmaps", NULL));
+
+  for (i = 0; path && path[i]; i++)
+    {
+      gboolean known = FALSE;
+      guint k;
+
+      for (k = 0; k < dirs->len && !known; k++)
+        known = strcmp (path[i], g_ptr_array_index (dirs, k)) == 0;
+
+      if (!known)
+        g_ptr_array_add (dirs, g_strdup (path[i]));
+    }
+
+  g_ptr_array_add (dirs, NULL);
+  return (char **) g_ptr_array_free (dirs, FALSE);
+}
+
 /**
  * gtk_icon_theme_set_search_path:
  * @self: a `GtkIconTheme`
@@ -1387,7 +1430,7 @@ gtk_icon_theme_set_search_path (GtkIconTheme       *self,
 
   gtk_icon_theme_lock (self);
 
-  search_path = g_strdupv ((char **)path);
+  search_path = system_search_path_first (self, path);
   g_strfreev (self->search_path);
   self->search_path = search_path;
 
diff --git a/gtk/gtksettings.c b/gtk/gtksettings.c
index 419e5f2..baf3247 100644
--- a/gtk/gtksettings.c
+++ b/gtk/gtksettings.c
@@ -1279,6 +1279,16 @@ gtk_settings_set_property (GObject      *object,
 {
   GtkSettings *settings = GTK_SETTINGS (object);
 
+  /* The icon theme is the desktop's choice, not the application's: an
+   * application that sets one keeps the system's icons regardless.
+   */
+  if (property_id == PROP_ICON_THEME_NAME)
+    {
+      g_debug ("Ignoring application icon theme %s; the system's stays",
+               g_value_get_string (value));
+      return;
+    }
+
   g_value_copy (value, &settings->property_values[property_id - 1].value);
   settings->property_values[property_id - 1].source = GTK_SETTINGS_SOURCE_APPLICATION;
 }
@@ -1477,6 +1487,13 @@ gtk_settings_set_property_value_internal (GtkSettings            *settings,
   name_quark = g_quark_from_string (name);
   g_free (name);
 
+  /* Neither an application nor a GTK theme's own settings.ini picks the
+   * icon theme; see gtk_settings_set_property().
+   */
+  if ((source == GTK_SETTINGS_SOURCE_APPLICATION || source == GTK_SETTINGS_SOURCE_THEME) &&
+      strcmp (g_quark_to_string (name_quark), "gtk-icon-theme-name") == 0)
+    return;
+
   qvalue = g_datalist_id_dup_data (&settings->queued_settings, name_quark, NULL, NULL);
   if (!qvalue)
     {
-- 
2.43.0

