From: Sebastian Krzyszkowiak <sebastian.krzyszkowiak@puri.sm>
Date: Wed, 25 Mar 2026 01:25:18 +0100
Subject: gdkevents: Differentiate between event sequences in motion
 compression

Otherwise multitouch events can get dropped.
---
 gdk/gdkevents.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/gdk/gdkevents.c b/gdk/gdkevents.c
index 40ef45d..507c546 100644
--- a/gdk/gdkevents.c
+++ b/gdk/gdkevents.c
@@ -258,6 +258,7 @@ _gdk_event_queue_handle_motion_compression (GdkDisplay *display)
   GList *pending_motions = NULL;
   GdkWindow *pending_motion_window = NULL;
   GdkDevice *pending_motion_device = NULL;
+  GdkEventSequence *pending_event_sequence = NULL;
   gboolean uncompressed_motion = FALSE;
 
   /* If the last N events in the event queue are motion notify
@@ -270,6 +271,7 @@ _gdk_event_queue_handle_motion_compression (GdkDisplay *display)
       GdkEventPrivate *event = tmp_list->data;
       GdkWindow *window;
       GdkDevice *device;
+      GdkEventSequence *sequence;
 
       if (event->flags & GDK_EVENT_PENDING)
         break;
@@ -280,6 +282,7 @@ _gdk_event_queue_handle_motion_compression (GdkDisplay *display)
 
       window = gdk_event_get_window (&event->event);
       device = gdk_event_get_device (&event->event);
+      sequence = gdk_event_get_event_sequence (&event->event);
 
       if (pending_motion_window != NULL &&
           pending_motion_window != window)
@@ -289,6 +292,10 @@ _gdk_event_queue_handle_motion_compression (GdkDisplay *display)
           pending_motion_device != device)
         break;
 
+      if (pending_event_sequence != NULL &&
+          pending_event_sequence != sequence)
+        break;
+
       pending_motion_window = window;
 
       if (!window->event_compression)
@@ -298,6 +305,7 @@ _gdk_event_queue_handle_motion_compression (GdkDisplay *display)
         }
 
       pending_motion_device = device;
+      pending_event_sequence = sequence;
       pending_motions = tmp_list;
 
       tmp_list = tmp_list->prev;
