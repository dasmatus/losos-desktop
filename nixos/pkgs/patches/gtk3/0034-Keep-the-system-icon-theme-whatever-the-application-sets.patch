From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 13:53:19 +0000
Subject: [PATCH] Keep the system icon theme whatever the application sets

An application could replace the desktop's icons in three ways: set
gtk-icon-theme-name on GtkSettings, ship a GTK theme whose settings.ini
names an icon theme, or put its own directories ahead of the system's on
the screen's GtkIconTheme, shadowing the system theme with a directory of
the same name or dropping the system's directories altogether.

GtkSettings now ignores gtk-icon-theme-name from the application and from
the GTK theme, so only settings.ini on the XDG config path and the
desktop's own settings (GSettings, the portal, XSETTINGS) choose it. The
screen's GtkIconTheme keeps the directories gtk_icon_theme_init() starts
with at the front of its search path; whatever the application adds goes
after them. Icon themes an application creates with gtk_icon_theme_new()
are its own and stay untouched.
---
 gtk/gtkicontheme.c | 62 ++++++++++++++++++++++++++++++++++++++++++++++
 gtk/gtksettings.c  | 17 +++++++++++++
 2 files changed, 79 insertions(+)

diff --git a/gtk/gtkicontheme.c b/gtk/gtkicontheme.c
index 3516125..8cc277d 100644
--- a/gtk/gtkicontheme.c
+++ b/gtk/gtkicontheme.c
@@ -863,6 +863,64 @@ gtk_icon_theme_finalize (GObject *object)
   G_OBJECT_CLASS (gtk_icon_theme_parent_class)->finalize (object);  
 }
 
+/* The directories a new GtkIconTheme searches, as gtk_icon_theme_init()
+ * builds them.
+ */
+static GPtrArray *
+system_search_path (void)
+{
+  const gchar * const *xdg_data_dirs = g_get_system_data_dirs ();
+  GPtrArray *dirs = g_ptr_array_new_with_free_func (g_free);
+  gint j;
+
+  g_ptr_array_add (dirs, g_build_filename (g_get_user_data_dir (), "icons", NULL));
+  g_ptr_array_add (dirs, g_build_filename (g_get_home_dir (), ".icons", NULL));
+  for (j = 0; xdg_data_dirs[j]; j++)
+    g_ptr_array_add (dirs, g_build_filename (xdg_data_dirs[j], "icons", NULL));
+  for (j = 0; xdg_data_dirs[j]; j++)
+    g_ptr_array_add (dirs, g_build_filename (xdg_data_dirs[j], "pixmaps", NULL));
+
+  return dirs;
+}
+
+/* The screen's icon theme searches the system's directories first, in
+ * their own order, whatever an application did to its search path; the
+ * application's own directories follow. Otherwise an application could
+ * shadow the system theme with a directory of the same name, or drop the
+ * system's directories and with them the theme. Other GtkIconTheme
+ * objects, which an application creates for itself, are left alone.
+ */
+static void
+keep_system_search_path_first (GtkIconThemePrivate *priv)
+{
+  GPtrArray *dirs;
+  gint i;
+  guint k;
+
+  if (!priv->is_screen_singleton)
+    return;
+
+  dirs = system_search_path ();
+  for (i = 0; i < priv->search_path_len; i++)
+    {
+      gboolean known = FALSE;
+
+      for (k = 0; k < dirs->len && !known; k++)
+        known = strcmp (priv->search_path[i], g_ptr_array_index (dirs, k)) == 0;
+
+      if (!known)
+        g_ptr_array_add (dirs, g_strdup (priv->search_path[i]));
+    }
+
+  for (i = 0; i < priv->search_path_len; i++)
+    g_free (priv->search_path[i]);
+  g_free (priv->search_path);
+
+  /* Freeing the array without its elements hands them over. */
+  priv->search_path_len = dirs->len;
+  priv->search_path = (gchar **) g_ptr_array_free (dirs, FALSE);
+}
+
 /**
  * gtk_icon_theme_set_search_path:
  * @icon_theme: a #GtkIconTheme
@@ -909,6 +967,8 @@ gtk_icon_theme_set_search_path (GtkIconTheme *icon_theme,
   for (i = 0; i < priv->search_path_len; i++)
     priv->search_path[i] = g_strdup (path[i]);
 
+  keep_system_search_path_first (priv);
+
   do_theme_change (icon_theme);
 }
 
@@ -1007,6 +1067,8 @@ gtk_icon_theme_prepend_search_path (GtkIconTheme *icon_theme,
   
   priv->search_path[0] = g_strdup (path);
 
+  keep_system_search_path_first (priv);
+
   do_theme_change (icon_theme);
 }
 
diff --git a/gtk/gtksettings.c b/gtk/gtksettings.c
index 22b1420..b8f2daf 100644
--- a/gtk/gtksettings.c
+++ b/gtk/gtksettings.c
@@ -2075,6 +2075,16 @@ gtk_settings_set_property (GObject      *object,
   GtkSettings *settings = GTK_SETTINGS (object);
   GtkSettingsPrivate *priv = settings->priv;
 
+  /* The icon theme is the desktop's choice, not the application's: an
+   * application that sets one keeps the system's icons regardless.
+   */
+  if (property_id == PROP_ICON_THEME_NAME)
+    {
+      g_debug ("Ignoring application icon theme %s; the system's stays",
+               g_value_get_string (value));
+      return;
+    }
+
   g_value_copy (value, &priv->property_values[property_id - 1].value);
   priv->property_values[property_id - 1].source = GTK_SETTINGS_SOURCE_APPLICATION;
 }
@@ -2462,6 +2472,13 @@ gtk_settings_set_property_value_internal (GtkSettings            *settings,
   name_quark = g_quark_from_string (name);
   g_free (name);
 
+  /* Neither an application nor a GTK theme's own settings.ini picks the
+   * icon theme; see gtk_settings_set_property().
+   */
+  if ((source == GTK_SETTINGS_SOURCE_APPLICATION || source == GTK_SETTINGS_SOURCE_THEME) &&
+      strcmp (g_quark_to_string (name_quark), "gtk-icon-theme-name") == 0)
+    return;
+
   qvalue = g_datalist_id_dup_data (&priv->queued_settings, name_quark, NULL, NULL);
   if (!qvalue)
     {
-- 
2.43.0

