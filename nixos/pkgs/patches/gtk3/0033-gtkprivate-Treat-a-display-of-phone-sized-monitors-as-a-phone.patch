From: losos <losos@localhost>
Date: Mon, 5 Oct 2026 09:05:46 +0000
Subject: [PATCH] gtkprivate: Treat a display of phone-sized monitors as a
 phone

Purism's adaptive patches switch on through the org.gtk.Settings.Purism
is-phone key, which PureOS sets per device. Turn the same switch on when
every monitor is under 600 application pixels on its short side, so a
phone needs no per-device setting and a docked phone gets desktop
dialogs back. The key still forces phone mode on.
---
 gtk/gtkprivate.h | 46 +++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 39 insertions(+), 7 deletions(-)

diff --git a/gtk/gtkprivate.h b/gtk/gtkprivate.h
index 9977698..8c97efe 100644
--- a/gtk/gtkprivate.h
+++ b/gtk/gtkprivate.h
@@ -146,19 +146,51 @@ _gtk_get_purism_settings (void)
   return gsettings;
 }
 
+/* A display is a phone's when every monitor on it is narrower than 600
+ * application pixels on its short side, the line the derisk shell draws
+ * between its phone and tablet layouts. A phone docked to a larger monitor
+ * is then a desktop again. Monitors with no geometry yet count as large,
+ * so a display that has not announced its outputs is never a phone.
+ */
 static inline gboolean
-_gtk_get_is_phone (void)
+_gtk_display_is_phone_sized (GdkDisplay *display)
 {
-  GSettings *gsettings = _gtk_get_purism_settings ();
-  gboolean is_phone;
+  int i, n;
 
-  if (!gsettings)
+  if (!display)
     return FALSE;
 
-  is_phone = g_settings_get_boolean (gsettings, "is-phone");
-  g_object_unref (gsettings);
+  n = gdk_display_get_n_monitors (display);
+  if (n == 0)
+    return FALSE;
+
+  for (i = 0; i < n; i++)
+    {
+      GdkMonitor *monitor = gdk_display_get_monitor (display, i);
+      GdkRectangle geometry;
+
+      gdk_monitor_get_geometry (monitor, &geometry);
+      if (geometry.width <= 0 || geometry.height <= 0 ||
+          MIN (geometry.width, geometry.height) >= 600)
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+static inline gboolean
+_gtk_get_is_phone (void)
+{
+  GSettings *gsettings = _gtk_get_purism_settings ();
+  gboolean is_phone = FALSE;
+
+  if (gsettings)
+    {
+      is_phone = g_settings_get_boolean (gsettings, "is-phone");
+      g_object_unref (gsettings);
+    }
 
-  return is_phone;
+  return is_phone || _gtk_display_is_phone_sized (gdk_display_get_default ());
 }
 
 G_END_DECLS
-- 
